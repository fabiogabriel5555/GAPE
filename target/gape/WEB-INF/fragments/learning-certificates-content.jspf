                <section id="certificates-list-${certificateManagementScope eq 'published' ? 'published_' : 'active_'}">
                    <c:set var="certificateManagementIdPrefix" value="${certificateManagementScope eq 'published' ? 'published_' : 'active_'}"/>
                    <div class="gape-desktop-table">
                        <table class="table mb-0 aac-certificate-table">
                            <thead>
                            <tr>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Student</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Email</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">&#8470; Certificates</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody data-gape-sort-list>
                            <c:forEach var="group" items="${certificateGroups}" varStatus="certificateLoop">
                                <tr class="aac-certificate-summary-row hover-bg-neutral-20 border-bottom transition-03"
                                    data-gape-sort-row
                                    data-gape-detail-id="certificateGroup${certificateManagementIdPrefix}${group.studentUserId}"
                                    data-gape-mobile-id="certificateMobileRow${certificateManagementIdPrefix}${group.studentUserId}"
                                    data-sort-index="${certificateLoop.index}"
                                    data-sort-name="${fn:escapeXml(group.studentLabel)}"
                                    data-sort-email="${fn:escapeXml(group.studentEmail)}"
                                    data-sort-date="${fn:escapeXml(group.primaryCertificate.issuedAtSort)}"
                                    data-sort-count="${group.certificateCount}"
                                    data-sort-status="${fn:escapeXml(group.primaryCertificate.statusLabel)}">
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <span class="fw-medium text-neutral-700"><c:out value="${group.studentLabel}"/></span>
                                    </td>
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <c:out value="${group.studentEmail}"/>
                                    </td>
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <span class="fw-medium text-neutral-700">${group.certificateCount}</span>
                                    </td>
                                    <td class="py-20 px-20">
                                        <div class="aac-state-summary">
                                            <c:forEach var="summary" items="${group.stateSummaries}">
                                                <span class="${summary.badgeClass} aac-state-summary__badge px-12 py-6 border-neutral-30 border rounded-pill text-12">${summary.count} <c:out value="${summary.label}"/></span>
                                            </c:forEach>
                                            <c:if test="${empty group.stateSummaries}">
                                                <span class="aac-state-empty">No state</span>
                                            </c:if>
                                        </div>
                                    </td>
                                    <td class="py-20 px-20 text-end">
                                    <button type="button" class="aac-icon-button bg-main-50 text-main-600 collapsed" title="Show all" aria-label="Show all certificates" data-bs-toggle="collapse" data-bs-target="#certificateGroup${certificateManagementIdPrefix}${group.studentUserId}" aria-expanded="false" aria-controls="certificateGroup${certificateManagementIdPrefix}${group.studentUserId}">
                                            <i class="ph ph-caret-down"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse" id="certificateGroup${certificateManagementIdPrefix}${group.studentUserId}">
                                    <td colspan="5" class="aac-expanded-cell">
                                        <div class="aac-expanded-panel">
                                            <div class="aac-expanded-panel__header">
                                                <div>
                                                    <h3 class="text-16 fw-semibold text-neutral-800 mb-4">Certificates</h3>
                                                    <span class="text-13 text-neutral-600"><c:out value="${group.studentLabel}"/> | <c:out value="${group.studentEmail}"/> | ${group.certificateCount} certificates</span>
                                                </div>
                                            </div>
                                            <div class="aac-tree">
                                                <c:forEach var="item" items="${group.certificates}">
                                                    <article class="aac-tree-node aac-tree-node--course">
                                                        <div class="aac-tree-row">
                                                            <div class="aac-tree-main">
                                                                <span class="aac-tree-icon bg-info-50 text-info-600"><i class="ph ph-certificate"></i></span>
                                                                <div class="min-w-0">
                                                                    <span class="aac-tree-title"><c:out value="${item.title}"/></span>
                                                                    <span class="aac-tree-meta" data-gape-datetime-display><c:out value="${item.courseLabel}"/> | <c:out value="${item.issuedAt}"/> | Grade: <c:out value="${item.finalGrade}"/></span>
                                                                </div>
                                                            </div>
                                                            <div class="aac-tree-status">
                                                                <span class="${item.statusBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                                    <c:out value="${item.statusLabel}"/>
                                                                </span>
                                                            </div>
                                                            <div class="aac-tree-actions">
                                                                 <button type="button" class="aac-icon-button bg-neutral-20 text-neutral-600" title="Detail" aria-label="View certificate" data-bs-toggle="modal" data-bs-target="#certificateDetail${certificateManagementIdPrefix}${item.id}">
                                                                     <i class="ph ph-eye"></i>
                                                                 </button>
                                                                 <c:if test="${item.completed or (certificateDraftDownloadsAllowed and item.stateValue eq 'draft')}">
                                                                     <div class="dropdown">
                                                                         <button type="button" class="aac-icon-button bg-main-50 text-main-600" title="Download" aria-label="Download certificate" data-bs-toggle="dropdown" aria-expanded="false">
                                                                             <i class="ph ph-download-simple"></i>
                                                                         </button>
                                                                        <ul class="dropdown-menu dropdown-menu-end aac-download-menu">
                                                                            <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=pdf"><i class="ph ph-file-pdf"></i>PDF</a></li>
                                                                             <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=excel"><i class="ph ph-file-xls"></i>Excel</a></li>
                                                                         </ul>
                                                                     </div>
                                                                 </c:if>
                                                            </div>
                                                        </div>
                                                    </article>
                                                </c:forEach>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </c:forEach>
                            <c:if test="${empty certificateGroups}">
                                <tr>
                                    <td colspan="5" class="py-32 px-20 text-center text-14 text-neutral-500">No certificates available yet.</td>
                                </tr>
                            </c:if>
                            </tbody>
                        </table>
                    </div>

                    <div class="gape-mobile-list" data-gape-mobile-list>
                        <c:forEach var="group" items="${certificateGroups}">
                            <article class="gape-mobile-row aac-certificate-summary-row"
                                     data-gape-mobile-row
                                     data-gape-mobile-row-id="certificateMobileRow${certificateManagementIdPrefix}${group.studentUserId}"
                                     data-gape-mobile-detail-id="certificateMobileGroup${certificateManagementIdPrefix}${group.studentUserId}">
                                <div class="gape-mobile-row__header">
                                    <div>
                                        <div class="gape-mobile-title"><c:out value="${group.studentLabel}"/></div>
                                        <div class="gape-mobile-subtitle"><c:out value="${group.studentEmail}"/></div>
                                    </div>
                                    <span class="gape-mobile-badge px-12 py-7 border-neutral-30 border rounded-pill text-12">${group.certificateCount} certificates</span>
                                </div>
                                <div class="gape-mobile-kv">
                                    <strong>State</strong>
                                    <span class="aac-state-summary">
                                        <c:forEach var="summary" items="${group.stateSummaries}">
                                            <span class="${summary.badgeClass} aac-state-summary__badge px-12 py-6 border-neutral-30 border rounded-pill text-12">${summary.count} <c:out value="${summary.label}"/></span>
                                        </c:forEach>
                                        <c:if test="${empty group.stateSummaries}">
                                            <span class="aac-state-empty">No state</span>
                                        </c:if>
                                    </span>
                                </div>
                                <div class="gape-mobile-actions">
                                    <button type="button" class="aac-icon-button bg-main-50 text-main-600 collapsed" title="Show all" aria-label="Show all certificates" data-bs-toggle="collapse" data-bs-target="#certificateMobileGroup${certificateManagementIdPrefix}${group.studentUserId}" aria-expanded="false" aria-controls="certificateMobileGroup${certificateManagementIdPrefix}${group.studentUserId}">
                                        <i class="ph ph-caret-down"></i>
                                    </button>
                                </div>
                            </article>
                            <div class="collapse" id="certificateMobileGroup${certificateManagementIdPrefix}${group.studentUserId}">
                                <div class="aac-expanded-panel mt-12 mb-12">
                                    <div class="aac-expanded-panel__header">
                                        <div>
                                            <h3 class="text-16 fw-semibold text-neutral-800 mb-4">Certificates</h3>
                                            <span class="text-13 text-neutral-600"><c:out value="${group.studentLabel}"/> | <c:out value="${group.studentEmail}"/> | ${group.certificateCount} certificates</span>
                                        </div>
                                    </div>
                                    <div class="aac-tree">
                                        <c:forEach var="item" items="${group.certificates}">
                                            <article class="aac-tree-node aac-tree-node--course">
                                                <div class="aac-tree-row">
                                                    <div class="aac-tree-main">
                                                        <span class="aac-tree-icon bg-info-50 text-info-600"><i class="ph ph-certificate"></i></span>
                                                        <div class="min-w-0">
                                                            <span class="aac-tree-title"><c:out value="${item.title}"/></span>
                                                            <span class="aac-tree-meta" data-gape-datetime-display><c:out value="${item.courseLabel}"/> | <c:out value="${item.issuedAt}"/> | Grade: <c:out value="${item.finalGrade}"/></span>
                                                        </div>
                                                    </div>
                                                    <div class="aac-tree-status">
                                                        <span class="${item.statusBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                            <c:out value="${item.statusLabel}"/>
                                                        </span>
                                                    </div>
                                                    <div class="aac-tree-actions">
                                                        <button type="button" class="aac-icon-button bg-neutral-20 text-neutral-600" title="Detail" aria-label="View certificate" data-bs-toggle="modal" data-bs-target="#certificateDetail${certificateManagementIdPrefix}${item.id}">
                                                            <i class="ph ph-eye"></i>
                                                        </button>
                                                        <c:if test="${item.completed or (certificateDraftDownloadsAllowed and item.stateValue eq 'draft')}">
                                                            <div class="dropdown">
                                                                <button type="button" class="aac-icon-button bg-main-50 text-main-600" title="Download" aria-label="Download certificate" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class="ph ph-download-simple"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end aac-download-menu">
                                                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=pdf"><i class="ph ph-file-pdf"></i>PDF</a></li>
                                                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=excel"><i class="ph ph-file-xls"></i>Excel</a></li>
                                                                </ul>
                                                            </div>
                                                        </c:if>
                                                    </div>
                                                </div>
                                            </article>
                                        </c:forEach>
                                    </div>
                                </div>
                            </div>
                        </c:forEach>
                        <c:if test="${empty certificateGroups}">
                            <div class="gape-mobile-empty">No certificates available yet.</div>
                        </c:if>
                    </div>

                    <c:forEach var="group" items="${certificateGroups}">
                        <c:forEach var="certificate" items="${group.certificates}">
                            <div class="modal fade" id="certificateDetail${certificateManagementIdPrefix}${certificate.id}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered">
                                    <div class="modal-content rounded-8 border-0">
                                        <div class="modal-header border-neutral-30">
                                            <div>
                                                <h5 class="modal-title text-18 fw-semibold mb-4"><c:out value="${certificate.title}"/></h5>
                                                <span class="text-13 text-neutral-500"><c:out value="${certificate.courseLabel}"/></span>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="aac-certificate-doc">
                                                <div class="aac-certificate-doc__rail" aria-hidden="true">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </div>
                                                <div class="aac-certificate-doc__body">
                                                    <h3>Course Completion Certificate for <c:out value="${certificate.courseName}"/></h3>
                                                    <div class="aac-certificate-doc__identity">
                                                        <div>
                                                            <span>This is to certify that</span>
                                                            <strong><c:out value="${certificate.studentName}"/></strong>
                                                            <small>Civil identification (CC/BI): <c:out value="${certificate.studentEmail}"/></small>
                                                        </div>
                                                    </div>
                                                    <table class="aac-certificate-doc__table">
                                                        <colgroup>
                                                            <col class="aac-certificate-doc__subject-col">
                                                            <col class="aac-certificate-doc__ects-col">
                                                            <col class="aac-certificate-doc__grade-col">
                                                        </colgroup>
                                                        <thead>
                                                        <tr>
                                                            <th>Subjects</th>
                                                            <th>ECTS</th>
                                                            <th>Grade<br>0 - <c:out value="${certificate.courseCertificateMaxGradeLabel}"/></th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        <c:forEach var="row" items="${certificate.subjectRows}">
                                                            <tr>
                                                                <td><c:out value="${row.subjectLabel}"/></td>
                                                                <td><c:out value="${row.ectsLabel}"/></td>
                                                                <td><c:out value="${row.gradeLabel}"/></td>
                                                            </tr>
                                                        </c:forEach>
                                                        <tr class="aac-certificate-doc__final">
                                                            <td colspan="2">Final grade</td>
                                                            <td><c:out value="${certificate.finalGrade}"/> points</td>
                                                        </tr>
                                                        </tbody>
                                                    </table>
                                                    <p class="aac-certificate-doc__statement">This certificate confirms successful completion of the course <strong><c:out value="${certificate.courseName}"/></strong>, with a total duration of <strong><c:out value="${certificate.courseDurationLabel}"/>, <c:out value="${certificate.courseEctsLabel}"/> ECTS and <c:out value="${certificate.subjectCountLabel}"/></strong>.</p>
                                                    <div class="aac-certificate-doc__signatures">
                                                        <div>
                                                            <span>Responsible person</span>
                                                            <div class="aac-certificate-doc__line">Signature and official seal or stamp</div>
                                                        </div>
                                                        <div>
                                                            <span>Training entity, Ltd.</span>
                                                            <div class="aac-certificate-doc__line">&nbsp;</div>
                                                        </div>
                                                    </div>
                                                    <c:if test="${certificate.completed}">
                                                        <div class="d-flex align-items-center justify-content-between gap-12 flex-wrap mt-24 pt-16 border-top border-neutral-30 text-13">
                                                            <span><strong>Validation code:</strong> <c:out value="${certificate.validationCode}"/></span>
                                                            <c:url var="certificateValidationUrl" value="/certificates/validate">
                                                                <c:param name="code" value="${certificate.validationCode}"/>
                                                            </c:url>
                                                            <a href="${certificateValidationUrl}" target="_blank" rel="noopener" class="text-main-600 fw-semibold">Verify certificate</a>
                                                        </div>
                                                    </c:if>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </c:forEach>
                    </c:forEach>
                </section>

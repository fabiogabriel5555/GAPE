<c:if test="${learningLessonActiveChild == 'new'}">
    <ul class="mt-8 ps-24">
        <li class="mb-6 activePage">
            <a href="${pageContext.request.contextPath}/learning/lessons/new" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap" data-lesson-modal-url="${pageContext.request.contextPath}/learning/lessons/new" data-lesson-modal-title="Create Lesson">
                <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-plus-circle"></i></span>
                Create Lesson
            </a>
        </li>
    </ul>
</c:if>
<c:if test="${not empty learningLessonContextId}">
    <c:set var="learningLessonBasePath" value="${empty learningLessonContextBasePath ? '/learning/lessons' : learningLessonContextBasePath}" />
    <ul class="mt-8 ps-24">
        <li class="mb-6 ${learningLessonActiveChild == 'detail' ? 'activePage' : ''}">
            <a href="${pageContext.request.contextPath}${learningLessonBasePath}/${learningLessonContextId}" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-eye"></i></span>
                Detail
            </a>
        </li>
        <c:if test="${canManageLesson and learningLessonBasePath == '/learning/lessons'}">
            <li class="mb-6 ${learningLessonActiveChild == 'edit' ? 'activePage' : ''}">
                <a href="${pageContext.request.contextPath}${learningLessonBasePath}/${learningLessonContextId}/edit" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                    <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-pencil-simple-line"></i></span>
                    Edit
                </a>
            </li>
        </c:if>
    </ul>
</c:if>

<div class="col-xxl-3 col-xl-4 col-md-6">
    <article class="gape-student-card gape-student-class-group-card gape-student-certificate-card px-14 py-14 h-100 position-relative" data-certificate-state="${certificate.stateValue}">
        <c:if test="${not empty studentEventUnreadByHref[certificateEventHref]}">
            <span class="gape-student-event-marker gape-student-event-marker--floating" data-student-event-marker data-student-event-href="${certificateEventHref}" title="Published certificate available">1</span>
        </c:if>
        <div class="gape-student-class-group-card__top mb-10">
            <span class="gape-student-class-group-card__icon gape-student-class-group-card__icon--compact"><i class="ph ph-certificate"></i></span>
            <div class="min-w-0">
                <h6 class="text-14 fw-semibold text-neutral-800 mb-4 text-line-1"><c:out value="${certificate.title}"/></h6>
                <span class="text-12 text-neutral-500 text-line-1"><c:out value="${certificate.courseLabel}"/></span>
            </div>
        </div>
        <div class="gape-student-class-group-card__badges mb-12">
            <span class="${certificate.statusBadgeClass} px-12 py-7 border-neutral-30 border rounded-pill text-12"><c:out value="${certificate.statusLabel}"/></span>
        </div>
        <div class="gape-student-class-group-card__meta mb-12">
            <span><c:out value="${certificate.typeLabel}"/></span>
            <span>Grade: <c:out value="${certificate.finalGrade}"/></span>
            <span class="gape-student-certificate-issued" data-gape-datetime-display>Issued: <c:out value="${certificate.issuedAt}"/></span>
        </div>
        <div class="gape-student-card-actions">
            <button type="button" class="gape-student-card-icon-button" data-bs-toggle="modal" data-bs-target="#studentCertificateDetail${certificate.id}" aria-label="View certificate" title="View certificate"><i class="ph ph-eye"></i></button>
            <a href="${pageContext.request.contextPath}/student/grades/certificates/${certificate.id}/download?format=pdf" class="gape-student-card-icon-button" aria-label="Download certificate" title="Download certificate"><i class="ph ph-download-simple"></i></a>
        </div>
    </article>
</div>
<div class="modal fade gape-student-certificate-modal" id="studentCertificateDetail${certificate.id}" tabindex="-1" aria-hidden="true" data-student-event-read-href="${certificateEventHref}">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-10 border-0">
            <div class="modal-header border-neutral-30">
                <div class="min-w-0">
                    <h5 class="modal-title text-18 fw-semibold mb-4 text-line-1"><c:out value="${certificate.title}"/></h5>
                    <span class="text-13 text-neutral-500 text-line-1"><c:out value="${certificate.courseLabel}"/></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="gape-student-certificate-doc">
                    <div class="gape-student-certificate-doc__rail" aria-hidden="true"><span></span><span></span><span></span></div>
                    <div class="gape-student-certificate-doc__body">
                        <h3>Course Completion Certificate for <c:out value="${certificate.courseName}"/></h3>
                        <div class="gape-student-certificate-doc__identity">
                            <div>
                                <span>This is to certify that</span>
                                <strong><c:out value="${certificate.studentName}"/></strong>
                                <small>Student contact: <c:out value="${certificate.studentEmail}"/></small>
                            </div>
                        </div>
                        <table class="gape-student-certificate-doc__table">
                            <colgroup><col class="gape-student-certificate-doc__subject-col"><col class="gape-student-certificate-doc__ects-col"><col class="gape-student-certificate-doc__grade-col"></colgroup>
                            <thead><tr><th>Subjects</th><th>ECTS</th><th>Grade<br>0 - <c:out value="${certificate.courseCertificateMaxGradeLabel}"/></th></tr></thead>
                            <tbody>
                                <c:forEach var="row" items="${certificate.subjectRows}"><tr><td><c:out value="${row.subjectLabel}"/></td><td><c:out value="${row.ectsLabel}"/></td><td><c:out value="${row.gradeLabel}"/></td></tr></c:forEach>
                                <c:if test="${empty certificate.subjectRows}"><tr><td colspan="3" class="text-center">No subject grades available.</td></tr></c:if>
                                <tr class="gape-student-certificate-doc__final"><td colspan="2">Final grade</td><td><c:out value="${certificate.finalGrade}"/> points</td></tr>
                            </tbody>
                        </table>
                        <p class="gape-student-certificate-doc__statement">This certificate confirms successful completion of the course <strong><c:out value="${certificate.courseName}"/></strong>, with a total duration of <strong><c:out value="${certificate.courseDurationLabel}"/>, <c:out value="${certificate.courseEctsLabel}"/> ECTS and <c:out value="${certificate.subjectCountLabel}"/></strong>.</p>
                        <div class="gape-student-certificate-doc__signatures"><div><span>Responsible person</span><div class="gape-student-certificate-doc__line">Signature and official seal or stamp</div></div><div><span>Training entity, Ltd.</span><div class="gape-student-certificate-doc__line">&nbsp;</div></div></div>
                        <div class="d-flex align-items-center justify-content-between gap-12 flex-wrap mt-24 pt-16 border-top border-neutral-30 text-13"><span><strong>Status:</strong> <c:out value="${certificate.statusLabel}"/> &middot; <strong>Validation code:</strong> <c:out value="${certificate.validationCode}"/></span><span data-gape-datetime-display><strong>Issued:</strong> <c:out value="${certificate.issuedAt}"/></span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-neutral-30"><a class="gape-student-card-icon-button" href="${pageContext.request.contextPath}/student/grades/certificates/${certificate.id}/download?format=pdf" aria-label="Download certificate" title="Download certificate"><i class="ph ph-download-simple"></i></a><button type="button" class="bg-main-600 px-20 py-10 rounded-8 fw-semibold text-white" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

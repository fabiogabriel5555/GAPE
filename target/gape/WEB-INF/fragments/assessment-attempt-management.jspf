<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pendingCorrectionAttemptCount" value="0"/>
<c:set var="nonSubmittedAttemptCount" value="0"/>
<c:forEach var="attempt" items="${attempts}">
    <c:if test="${attempt.submitted}"><c:set var="pendingCorrectionAttemptCount" value="${pendingCorrectionAttemptCount + 1}"/></c:if>
    <c:if test="${not attempt.submitted}"><c:set var="nonSubmittedAttemptCount" value="${nonSubmittedAttemptCount + 1}"/></c:if>
</c:forEach>

<section class="ad-surface px-22 py-22" id="assessment-attempts">
    <div class="ad-detail-panel">
        <div class="ad-detail-panel-content">
            <div class="ad-detail-panel-header">
                <div class="ad-detail-panel-heading">
                    <h3 class="text-18 fw-semibold text-neutral-800 mb-4">Attempts</h3>
                    <span class="text-13 text-neutral-500"><c:out value="${assessment.attemptCountLabel}"/> for this assessment.</span>
                </div>
            </div>

            <div class="ad-enrollment-tabs ad-attempt-tabs" role="tablist" aria-label="Assessment attempt views">
                <button type="button" class="ad-enrollment-tab ad-attempt-tab is-active" data-ad-attempt-tab="attempts" aria-selected="true"><i class="ph ph-checks"></i>Attempts <span class="ad-element-count">${nonSubmittedAttemptCount}</span></button>
                <button type="button" class="ad-enrollment-tab ad-attempt-tab" data-ad-attempt-tab="pending" aria-selected="false"><i class="ph ph-clock"></i>Pending correction <c:if test="${pendingCorrectionAttemptCount > 0}"><span class="badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2"><c:out value="${pendingCorrectionAttemptCount}"/></span></c:if></button>
            </div>

            <div class="ad-enrollment-tab-panel ad-attempt-tab-panel" data-ad-attempt-panel="attempts">
                <div class="ad-structure-list-header ad-attempt-list-header"><span>Student</span><span>Attempt</span><span>Submitted</span><span>Score</span><span>State</span><span class="text-end">Actions</span></div>
                <div class="d-flex flex-column gap-12">
                    <c:forEach var="attempt" items="${attempts}">
                        <c:if test="${not attempt.submitted}"><c:set var="attemptViewMode" value="attempts"/><%@ include file="/WEB-INF/fragments/assessment-attempt-row.jspf" %></c:if>
                    </c:forEach>
                    <c:if test="${nonSubmittedAttemptCount == 0}"><div class="border border-neutral-30 rounded-8 px-18 py-28 text-center text-14 text-neutral-500">No attempts are outside pending correction.</div></c:if>
                </div>
            </div>

            <div class="ad-enrollment-tab-panel ad-attempt-tab-panel" data-ad-attempt-panel="pending" hidden>
                <div class="ad-structure-list-header ad-attempt-list-header"><span>Student</span><span>Attempt</span><span>Submitted</span><span>Score</span><span>State</span><span class="text-end">Actions</span></div>
                <div class="d-flex flex-column gap-12">
                    <c:forEach var="attempt" items="${attempts}">
                        <c:if test="${attempt.submitted}">
                            <c:set var="attemptViewMode" value="pending"/><%@ include file="/WEB-INF/fragments/assessment-attempt-row.jspf" %>
                        </c:if>
                    </c:forEach>
                    <c:if test="${pendingCorrectionAttemptCount == 0}"><div class="border border-neutral-30 rounded-8 px-18 py-28 text-center text-14 text-neutral-500">No attempts are awaiting correction.</div></c:if>
                </div>
            </div>
        </div>
    </div>
</section>

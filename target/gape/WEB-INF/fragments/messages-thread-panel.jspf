<div class="messages-thread-panel ps-24 d-flex flex-column"
     data-messages-thread-panel
     data-total-unread-count="${communicationPage.unreadCount}"
     data-selected-peer-id="${communicationPage.hasSelectedConversation ? communicationPage.selectedConversation.peerUserId : ''}"
     data-selected-unread-count="${communicationPage.hasSelectedConversation ? communicationPage.selectedConversation.unreadCount : 0}">
    <c:choose>
        <c:when test="${communicationPage.hasSelectedConversation}">
            <header class="d-flex align-items-center gap-16 justify-content-between border-bottom-dashed pb-24 mb-24 flex-wrap">
                <div class="d-flex align-items-center gap-16 min-w-0">
                    <span class="messages-avatar messages-avatar--lg rounded-circle bg-main-50 text-main-600 d-inline-flex align-items-center justify-content-center text-16 fw-semibold">
                        <c:out value="${communicationPage.selectedConversation.initials}"/>
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-18 fw-semibold text-neutral-700 mb-4 text-line-1">
                            <c:out value="${communicationPage.selectedConversation.peerName}"/>
                        </h2>
                        <span class="d-flex align-items-center gap-8 text-13 text-neutral-500">
                            <span class="w-8 h-8 bg-success-600 rounded-circle"></span>
                            <span class="text-line-1"><c:out value="${communicationPage.selectedConversation.peerEmail}"/></span>
                        </span>
                    </div>
                </div>
            </header>

            <div class="messages-chat-scroll pe-4" data-messages-chat-scroll>
                <c:choose>
                    <c:when test="${empty communicationPage.messages}">
                        <div class="text-center px-20 py-56">
                            <span class="w-56 h-56 rounded-circle bg-neutral-20 text-neutral-500 d-inline-flex align-items-center justify-content-center text-28 mb-16">
                                <i class="ph ph-chat-centered-dots"></i>
                            </span>
                            <h3 class="text-18 fw-semibold text-neutral-700 mb-6">No messages in this conversation</h3>
                        </div>
                    </c:when>
                    <c:otherwise>
                        <c:if test="${communicationPage.hasOlderMessages}">
                            <div class="text-center mb-20" data-load-older-shell>
                                <button type="button"
                                        class="btn btn-outline-main rounded-pill px-20 h-40 d-inline-flex align-items-center justify-content-center gap-8"
                                        data-load-older-messages
                                        data-peer-user-id="${communicationPage.selectedConversation.peerUserId}"
                                        data-before-message-id="${communicationPage.oldestMessageId}">
                                    <i class="ph ph-arrow-up"></i>
                                    <span>Load older messages</span>
                                </button>
                            </div>
                        </c:if>
                        <div data-message-items>
                            <%@ include file="/WEB-INF/fragments/messages-chat-items.jspf" %>
                        </div>
                    </c:otherwise>
                </c:choose>
            </div>

            <form action="${pageContext.request.contextPath}/messages/send" method="post" enctype="multipart/form-data" class="messages-reply-form pt-24 mt-auto d-flex align-items-center gap-10 flex-wrap" data-message-send-form>
                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                <input type="hidden" name="recipientUserId" value="${communicationPage.selectedConversation.peerUserId}">
                <label for="conversation-attachment-file" class="messages-file-button rounded-circle bg-neutral-20 text-neutral-600 d-inline-flex align-items-center justify-content-center text-20 flex-shrink-0 cursor-pointer" title="Attach file" aria-label="Attach file">
                    <i class="ph ph-paperclip"></i>
                </label>
                <input id="conversation-attachment-file"
                       type="file"
                       name="attachmentFile"
                       aria-label="Attach files"
                       class="visually-hidden"
                       multiple
                       accept="application/pdf,.pdf,text/plain,.txt,image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp,video/mp4,video/webm,video/quicktime,video/x-m4v,video/x-matroska,video/x-msvideo,video/mpeg,video/3gpp,.mp4,.webm,.mov,.m4v,.mkv,.avi,.mpeg,.mpg,.3gp,.3gpp,audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/x-wav,audio/ogg,audio/flac,audio/aac,audio/webm,audio/opus,application/ogg,.mp3,.m4a,.wav,.ogg,.flac,.aac,.weba,.opus,application/zip,application/x-zip-compressed,application/vnd.rar,application/x-rar-compressed,application/x-7z-compressed,application/x-tar,application/gzip,application/x-gzip,application/x-bzip2,application/x-xz,.zip,.rar,.7z,.tar,.tar.gz,.tgz,.tar.bz2,.tbz2,.tar.xz,.txz,.gz,.bz2,.xz"
                       data-message-attachment-input>
                <label for="conversation-reply-body" class="visually-hidden">Message</label>
                <textarea id="conversation-reply-body" name="body" class="common-input messages-reply-input rounded-24" maxlength="3000" rows="1" placeholder="Say something..." data-message-body-input></textarea>
                <button type="submit" class="btn btn-main rounded-pill px-24 h-48 d-inline-flex align-items-center justify-content-center gap-8 flex-shrink-0">
                    <span>Send</span>
                    <i class="ph ph-paper-plane-right"></i>
                </button>
                <div class="messages-attachment-selection d-flex align-items-center gap-8 flex-wrap" data-message-attachment-name hidden></div>
                <div class="messages-form-feedback text-12 fw-semibold" data-message-form-feedback hidden></div>
            </form>
        </c:when>
        <c:otherwise>
            <div class="flex-grow-1 d-flex align-items-center justify-content-center px-24 py-56 text-center">
                <div>
                    <span class="w-64 h-64 rounded-circle bg-neutral-20 text-neutral-500 d-inline-flex align-items-center justify-content-center text-32 mb-16">
                        <i class="ph ph-chat-circle-text"></i>
                    </span>
                    <h2 class="text-20 fw-semibold text-neutral-700 mb-8">Select a conversation</h2>
                    <p class="text-14 text-neutral-500 mb-0">Choose a user or send a new message.</p>
                </div>
            </div>
        </c:otherwise>
    </c:choose>
</div>

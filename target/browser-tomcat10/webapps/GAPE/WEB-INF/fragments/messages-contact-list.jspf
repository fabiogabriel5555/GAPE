<c:choose>
    <c:when test="${empty communicationPage.conversations}">
        <div class="px-20 py-28 text-center">
            <span class="w-48 h-48 rounded-circle bg-neutral-20 text-neutral-500 d-inline-flex align-items-center justify-content-center text-24 mb-12">
                <i class="ph ph-chats-circle"></i>
            </span>
            <h3 class="text-16 fw-semibold text-neutral-700 mb-6">No conversations yet</h3>
            <p class="text-13 text-neutral-500 mb-0">Send a message to start one.</p>
        </div>
    </c:when>
    <c:otherwise>
        <c:forEach var="conversation" items="${communicationPage.conversations}">
            <a class="messages-contact-link ${communicationPage.hasSelectedConversation and communicationPage.selectedConversation.peerUserId == conversation.peerUserId ? 'bg-neutral-20' : ''} px-24 py-12 d-flex align-items-center gap-12 hover-bg-neutral-20 rounded-8 transition-03 text-decoration-none mb-8"
               href="${pageContext.request.contextPath}/messages?userId=${conversation.peerUserId}"
               data-peer-user-id="${conversation.peerUserId}"
               data-conversation-unread-count="${conversation.unreadCount}"
               data-conversation-link>
                <span class="messages-avatar rounded-circle bg-main-50 text-main-600 d-inline-flex align-items-center justify-content-center text-14 fw-semibold">
                    <c:out value="${conversation.initials}"/>
                </span>
                <span class="min-w-0 flex-grow-1">
                    <span class="d-flex align-items-center justify-content-between gap-8 mb-2">
                        <span class="text-15 fw-semibold ${conversation.unread ? 'text-main-600' : 'text-neutral-700'} text-line-1" data-conversation-name><c:out value="${conversation.peerName}"/></span>
                        <span class="text-11 text-neutral-500 flex-shrink-0" data-gape-datetime-display><c:out value="${conversation.lastActivityLabel}"/></span>
                    </span>
                    <span class="d-flex align-items-center justify-content-between gap-8">
                        <span class="messages-contact-preview text-13 text-neutral-500"><c:out value="${conversation.previewLabel}"/></span>
                        <c:if test="${conversation.unread}">
                            <span class="min-w-20 h-20 rounded-circle bg-main-600 text-white text-11 fw-semibold d-inline-flex align-items-center justify-content-center px-6 flex-shrink-0" data-conversation-unread-badge>
                                ${conversation.unreadCount}
                            </span>
                        </c:if>
                    </span>
                </span>
            </a>
        </c:forEach>
    </c:otherwise>
</c:choose>

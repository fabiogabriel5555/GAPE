<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="isAdminDashboard" value="${sessionScope['gape.auth.hasAdministratorProfile']}" />
<c:set var="currentServletPath" value="${pageContext.request.servletPath}" />
<c:set var="currentRequestUri" value="${pageContext.request.requestURI}" />
<c:set var="includedServletPath" value="${requestScope['jakarta.servlet.include.servlet_path']}" />
<c:set var="isCoordinatorDashboard" value="${sessionScope['gape.auth.hasCoordinatorProfile']
        or fn:contains(currentRequestUri, '/coordinator/')
        or fn:startsWith(currentServletPath, '/coordinator/')}" />
<c:set var="isTeacherDashboard" value="${sessionScope['gape.auth.hasTeacherProfile']
        or fn:contains(currentRequestUri, '/instructor/')
        or fn:startsWith(currentServletPath, '/instructor/')}" />
<c:set var="isStudentOnlyDashboard" value="${sessionScope['gape.auth.hasStudentProfile'] and not isAdminDashboard and not isCoordinatorDashboard and not isTeacherDashboard}" />
<c:set var="dashboardHref" value="/dashboard" />
<c:set var="siteHomeHref" value="/dashboard" />
<c:set var="profileHref" value="${isAdminDashboard ? '/admin/admin-my-profile.jsp' : (isStudentOnlyDashboard ? '/student/student/profile/student-profile.jsp' : '/profile')}" />
<c:set var="messageHref" value="/messages" />
<c:set var="calendarHref" value="/learning/events" />
<c:set var="calendarLabel" value="Events" />
<c:set var="calendarIcon" value="ph ph-calendar-dots" />
<c:set var="sidebarEventUnreadCount" value="${empty eventUnreadCount ? 0 : eventUnreadCount}" />
<c:set var="sidebarMessageUnreadCount" value="${empty messageUnreadCount ? 0 : messageUnreadCount}" />
<c:set var="sidebarClassGroupEventCount" value="${empty classGroupEventCount ? 0 : classGroupEventCount}" />
<c:set var="sidebarLearningPendingWorkCount" value="${empty learningPendingWorkCount ? 0 : learningPendingWorkCount}" />
<c:set var="attendanceHref" value="/learning/attendance" />
<c:set var="quizAttemptsHref" value="/learning/assessments" />
<c:if test="${isStudentOnlyDashboard}">
    <c:set var="messageHref" value="/messages" />
    <c:set var="calendarHref" value="/student/events" />
    <c:set var="calendarLabel" value="Events" />
    <c:set var="calendarIcon" value="ph ph-calendar-dots" />
    <c:set var="attendanceHref" value="/student/attendance" />
</c:if>
<c:if test="${not sessionScope['gape.auth.hasAdministratorProfile'] and isCoordinatorDashboard}">
    <c:set var="messageHref" value="/messages" />
    <c:set var="quizAttemptsHref" value="/learning/assessments" />
</c:if>
<c:if test="${not sessionScope['gape.auth.hasAdministratorProfile'] and not isCoordinatorDashboard and isTeacherDashboard}">
    <c:set var="messageHref" value="/messages" />
    <c:set var="quizAttemptsHref" value="/learning/assessments" />
</c:if>
<c:set var="coursesHref" value="/courses" />
<c:if test="${isStudentOnlyDashboard}">
    <c:set var="coursesHref" value="/student/courses" />
</c:if>
<c:if test="${sessionScope['gape.auth.hasAdministratorProfile'] and sessionScope['gape.auth.canManageCourses']}">
    <c:set var="coursesHref" value="/admin/courses" />
</c:if>
<c:set var="canOpenClassGroups" value="${sessionScope['gape.auth.canManageCourses'] or sessionScope['gape.auth.canManageSubjects'] or isCoordinatorDashboard or isTeacherDashboard}" />
<c:set var="canOpenLessons" value="${canOpenClassGroups or sessionScope['gape.auth.hasStudentProfile']}" />
<c:set var="canOpenAttendance" value="${canOpenClassGroups or sessionScope['gape.auth.hasStudentProfile']}" />
<c:set var="canOpenRooms" value="${sessionScope['gape.auth.canManageOrganizations'] or isCoordinatorDashboard or isTeacherDashboard}" />
<c:set var="isDashboardActive" value="${activeMenu == 'dashboard'
        or currentServletPath == '/dashboard'
        or fn:contains(currentRequestUri, '/dashboard')
        or fn:endsWith(currentServletPath, '-dashbord.jsp')
        or fn:endsWith(currentRequestUri, '-dashbord.jsp')
        or fn:contains(currentRequestUri, '/student/student/dashboard/')
        or fn:endsWith(includedServletPath, '-dashbord.jsp')}" />
<c:set var="isProfileActive" value="${activeMenu == 'profile' or activeMenu == 'my-profile'
        or currentServletPath == '/profile'
        or fn:contains(currentRequestUri, '/profile')
        or fn:endsWith(currentServletPath, '-my-profile.jsp')
        or fn:endsWith(currentRequestUri, '-my-profile.jsp')
        or fn:contains(currentRequestUri, '/student/student/profile/')
        or fn:endsWith(includedServletPath, '-my-profile.jsp')}" />
<c:set var="isSubjectsActive" value="${activeMenu == 'subjects'
        or fn:contains(currentRequestUri, '/admin/subjects')
        or fn:contains(currentRequestUri, '/coordinator/subjects')
        or fn:contains(currentRequestUri, '/instructor/subjects')
        or fn:contains(currentRequestUri, '/student/subjects')
        or fn:startsWith(currentServletPath, '/admin/subjects')
        or fn:startsWith(currentServletPath, '/coordinator/subjects')
        or fn:startsWith(currentServletPath, '/instructor/subjects')
        or fn:startsWith(currentServletPath, '/student/subjects')
        or fn:contains(includedServletPath, '/subject/')}" />
<c:set var="isClassGroupsActive" value="${activeMenu == 'class-groups'
        or fn:contains(currentRequestUri, '/learning/class-groups')
        or fn:contains(currentRequestUri, '/student/class-groups')
        or fn:startsWith(currentServletPath, '/learning/class-groups')
        or fn:startsWith(currentServletPath, '/student/class-groups')
        or fn:contains(includedServletPath, '/class-group/')}" />
<c:set var="isLessonsActive" value="${activeMenu == 'lessons'
        or activeMenu == 'assessments'
        or fn:contains(currentRequestUri, '/learning/lessons')
        or fn:contains(currentRequestUri, '/learning/assessments')
        or fn:contains(currentRequestUri, '/student/lessons')
        or fn:startsWith(currentServletPath, '/learning/lessons')
        or fn:startsWith(currentServletPath, '/learning/assessments')
        or fn:startsWith(currentServletPath, '/student/lessons')}" />
<c:set var="isRoomsActive" value="${activeMenu == 'rooms'
        or fn:contains(currentRequestUri, '/learning/rooms')
        or fn:startsWith(currentServletPath, '/learning/rooms')}" />
<c:set var="isCalendarActive" value="${activeMenu == 'calendar'
        or fn:contains(currentRequestUri, '/learning/calendar')
        or fn:contains(currentRequestUri, '/learning/events')
        or fn:contains(currentRequestUri, '/student/calendar')
        or fn:contains(currentRequestUri, '/student/events')
        or fn:startsWith(currentServletPath, '/learning/calendar')
        or fn:startsWith(currentServletPath, '/learning/events')
        or fn:startsWith(currentServletPath, '/student/calendar')
        or fn:startsWith(currentServletPath, '/student/events')}" />
<c:set var="isAttendanceActive" value="${activeMenu == 'attendance'
        or activeMenu == 'grades'
        or fn:contains(currentRequestUri, '/learning/attendance')
        or fn:contains(currentRequestUri, '/student/attendance')
        or fn:contains(currentRequestUri, '/learning/grades')
        or fn:contains(currentRequestUri, '/student/grades')
        or fn:startsWith(currentServletPath, '/learning/attendance')
        or fn:startsWith(currentServletPath, '/student/attendance')
        or fn:startsWith(currentServletPath, '/learning/grades')
        or fn:startsWith(currentServletPath, '/student/grades')}" />
<c:set var="isQuizAttemptsActive" value="${activeMenu == 'assessments'
        or activeMenu == 'quiz-attempts'
        or activeMenu == 'quiz'
        or fn:contains(currentRequestUri, '/learning/assessments')
        or fn:contains(currentRequestUri, '/student/assessments')
        or fn:startsWith(currentServletPath, '/learning/assessments')
        or fn:startsWith(currentServletPath, '/student/assessments')}" />
<c:set var="dashboardUserName" value="${sessionScope['gape.auth.userName']}" />
<c:set var="dashboardFirstName" value="" />
<c:if test="${not empty dashboardUserName}">
    <c:set var="dashboardFirstName" value="${fn:split(fn:trim(dashboardUserName), ' ')[0]}" />
</c:if>
<div class="dashboard-sidebar px-20 py-24 max-w-288-px bg-white w-100 border-end border-neutral-40 position-relative">
    <a href="${pageContext.request.contextPath}${siteHomeHref}" class="dashboard-sidebar__site-logo">
        <img src="${pageContext.request.contextPath}/assets/images/logo/logo.svg" alt="GAPE">
    </a>
    <span class="w-100 bg-neutral-40 mb-24 mt-24 h-1"></span>
    <div class="overflow-x-auto">
        <div class="scrollbar min-w-max">
            <span class="text-neutral-500 fw-normal text-14 mb-8">Welcome<c:if test="${not empty dashboardFirstName}"> <c:out value="${dashboardFirstName}"/></c:if>,</span>
            <c:if test="${isStudentOnlyDashboard}">
                <div class="border border-neutral-30 rounded-12 px-16 py-16 mb-16 bg-neutral-10">
                    <div class="d-flex align-items-center gap-12">
                        <div class="w-48 h-48 rounded-circle bg-main-50 text-main-600 d-flex align-items-center justify-content-center overflow-hidden text-24 flex-shrink-0">
                            <%@ include file="/WEB-INF/fragments/user-avatar-content.jspf" %>
                        </div>
                        <div class="min-w-0">
                            <strong class="d-block text-14 text-neutral-700 text-line-1"><c:out value="${sessionScope['gape.auth.userName']}"/></strong>
                            <span class="d-block text-12 text-neutral-500 text-line-1"><c:out value="${sessionScope['gape.auth.userEmail']}"/></span>
                        </div>
                    </div>
                </div>
            </c:if>
            <ul>
                <li class="mb-8 ${isDashboardActive ? 'activePage' : ''}">
                    <a href="${pageContext.request.contextPath}${dashboardHref}" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                        <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph-bold ph-house"></i></span>
                        Dashboard
                    </a>
                </li>
                <li class="mb-8 ${isProfileActive ? 'activePage' : ''}">
                    <a href="${pageContext.request.contextPath}${profileHref}" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                        <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-user-circle"></i></span>
                        My Profile
                    </a>
                </li>
                <li class="mb-8 ${activeMenu == 'message' ? 'activePage' : ''}">
                    <a href="${pageContext.request.contextPath}${messageHref}" class="gape-sidebar-badged-item position-relative fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                        <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-chat-dots"></i></span>
                        Messages
                        <span class="gape-sidebar-event-badge badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2${sidebarMessageUnreadCount > 0 ? '' : ' d-none'}" data-sidebar-message-badge>
                            ${sidebarMessageUnreadCount}
                        </span>
                    </a>
                </li>
                <c:if test="${isAdminDashboard or isCoordinatorDashboard or isTeacherDashboard or sessionScope['gape.auth.hasStudentProfile']}">
                    <li class="mb-8 ${isCalendarActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}${calendarHref}" class="gape-sidebar-badged-item position-relative fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="${calendarIcon}"></i></span>
                            ${calendarLabel}
                            <span class="gape-sidebar-event-badge badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2${sidebarEventUnreadCount > 0 ? '' : ' d-none'}" data-sidebar-event-badge>
                                ${sidebarEventUnreadCount}
                            </span>
                        </a>
                    </li>
                </c:if>
                <c:if test="${canOpenRooms}">
                    <li class="mb-8 ${isRoomsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/learning/rooms" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-door"></i></span>
                            Rooms
                        </a>
                        <%@ include file="/WEB-INF/fragments/dashboard-learning-room-context.jspf" %>
                    </li>
                </c:if>
                <c:if test="${isStudentOnlyDashboard}">
                    <li class="mb-8">
                        <span class="fw-normal text-14 text-neutral-500">Student</span>
                    </li>
                    <li class="mb-8 ${activeMenu == 'courses' ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}${coursesHref}" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-books"></i></span>
                            Class Courses
                        </a>
                    </li>
                    <li class="mb-8 ${isSubjectsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/student/subjects" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-book-open-text"></i></span>
                            Subjects
                        </a>
                    </li>
                    <li class="mb-8 ${isClassGroupsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/student/class-groups" class="gape-sidebar-badged-item position-relative fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-users-three"></i></span>
                            Class Groups
                            <span class="gape-sidebar-event-badge badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2${sidebarClassGroupEventCount > 0 ? '' : ' d-none'}" data-sidebar-class-group-pending-badge>
                                ${sidebarClassGroupEventCount}
                            </span>
                        </a>
                    </li>
                    <li class="mb-8 ${isLessonsActive or isQuizAttemptsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/student/lessons" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-files"></i></span>
                            Lessons &amp; Assessments
                        </a>
                        <%@ include file="/WEB-INF/fragments/dashboard-learning-lesson-context.jspf" %>
                    </li>
                    <li class="mb-8 ${isAttendanceActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}${attendanceHref}" class="gape-sidebar-long-link fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-user-check"></i></span>
                            <span class="gape-sidebar-link-label">Enrollments &amp; Certificates</span>
                        </a>
                    </li>
                </c:if>
                <c:if test="${not sessionScope['gape.auth.hasAdministratorProfile'] and isCoordinatorDashboard}">
                    <li class="mb-8">
                        <span class="fw-normal text-14 text-neutral-500">Coordinator</span>
                    </li>
                    <li class="mb-8 ${activeMenu == 'courses' ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/coordinator/courses" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-books"></i></span>
                            Courses
                        </a>
                        <c:if test="${adminCourseActiveChild == 'new'}">
                            <ul class="mt-8 ps-24">
                                <li class="mb-6 activePage">
                                    <a href="${pageContext.request.contextPath}/coordinator/courses/new" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                        <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-plus-circle"></i></span>
                                        Create
                                    </a>
                                </li>
                            </ul>
                        </c:if>
                    </li>
                    <li class="mb-8 ${isSubjectsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/coordinator/subjects" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-book-open-text"></i></span>
                            Subjects
                        </a>
                        <c:if test="${coordinatorSubjectActiveChild == 'new'}">
                            <ul class="mt-8 ps-24">
                                <li class="mb-6 activePage">
                                    <a href="${pageContext.request.contextPath}/coordinator/subjects/new" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                        <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-plus-circle"></i></span>
                                        Create
                                    </a>
                                </li>
                            </ul>
                        </c:if>
                        <c:if test="${not empty coordinatorSubjectContextId}">
                            <ul class="mt-8 ps-24">
                                <li class="mb-6 ${coordinatorSubjectActiveChild == 'detail' ? 'activePage' : ''}">
                                    <a href="${pageContext.request.contextPath}/coordinator/subjects/${coordinatorSubjectContextId}" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                        <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-eye"></i></span>
                                        Detail
                                    </a>
                                </li>
                                <c:if test="${canModifySubject}">
                                    <li class="mb-6 ${coordinatorSubjectActiveChild == 'edit' ? 'activePage' : ''}">
                                        <a href="${pageContext.request.contextPath}/coordinator/subjects/${coordinatorSubjectContextId}/edit" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                            <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-pencil-simple-line"></i></span>
                                            Edit
                                        </a>
                                    </li>
                                </c:if>
                                <c:if test="${canManageSubjectAssociations}">
                                    <li class="mb-6 ${coordinatorSubjectActiveChild == 'courses' ? 'activePage' : ''}">
                                        <a href="${pageContext.request.contextPath}/coordinator/subjects/${coordinatorSubjectContextId}/edit#course-associations" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                            <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-link-simple"></i></span>
                                            Course Associations
                                        </a>
                                    </li>
                                </c:if>
                            </ul>
                        </c:if>
                    </li>
                    <c:if test="${canOpenClassGroups}">
                        <li class="mb-8 ${isClassGroupsActive ? 'activePage' : ''}">
                            <a href="${pageContext.request.contextPath}/learning/class-groups" class="gape-sidebar-badged-item position-relative fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                                <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-chalkboard-teacher"></i></span>
                                Class Groups
                                <span class="gape-sidebar-event-badge badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2${sidebarClassGroupEventCount > 0 ? '' : ' d-none'}" data-sidebar-class-group-pending-badge>
                                    ${sidebarClassGroupEventCount}
                                </span>
                            </a>
                            <c:if test="${learningClassGroupActiveChild == 'new'}">
                                <ul class="mt-8 ps-24">
                                    <li class="mb-6 activePage">
                                        <a href="${pageContext.request.contextPath}/learning/class-groups/new" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                            <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-plus-circle"></i></span>
                                            Create
                                        </a>
                                    </li>
                                </ul>
                            </c:if>
                            <c:if test="${not empty learningClassGroupContextId}">
                                <ul class="mt-8 ps-24">
                                    <li class="mb-6 ${learningClassGroupActiveChild == 'detail' ? 'activePage' : ''}">
                                        <a href="${pageContext.request.contextPath}/learning/class-groups/${learningClassGroupContextId}" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                            <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-eye"></i></span>
                                            Detail
                                        </a>
                                    </li>
                                    <c:if test="${canManageClassGroup}">
                                        <li class="mb-6 ${learningClassGroupActiveChild == 'edit' ? 'activePage' : ''}">
                                            <a href="${pageContext.request.contextPath}/learning/class-groups/${learningClassGroupContextId}/edit" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                                                <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-pencil-simple-line"></i></span>
                                                Edit
                                            </a>
                                        </li>
                                    </c:if>
                                </ul>
                            </c:if>
                        </li>
                    </c:if>
                    <c:if test="${canOpenLessons}">
                        <li class="mb-8 ${isLessonsActive ? 'activePage' : ''}">
                            <a href="${pageContext.request.contextPath}/learning/lessons" class="gape-sidebar-badged-item position-relative fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                                <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-calendar-check"></i></span>
                                Lessons &amp; Assessments
                                <span class="gape-sidebar-event-badge badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2${sidebarLearningPendingWorkCount > 0 ? '' : ' d-none'}" data-sidebar-learning-pending-badge title="${sidebarLearningPendingWorkCount} pending assessment action(s)">
                                    ${sidebarLearningPendingWorkCount}
                                </span>
                            </a>
                            <%@ include file="/WEB-INF/fragments/dashboard-learning-lesson-context.jspf" %>
                            <%@ include file="/WEB-INF/fragments/dashboard-learning-assessment-context.jspf" %>
                        </li>
                    </c:if>
                </c:if>
                <c:if test="${not sessionScope['gape.auth.hasAdministratorProfile'] and not isCoordinatorDashboard and isTeacherDashboard}">
                    <li class="mb-8">
                        <span class="fw-normal text-14 text-neutral-500">Teacher</span>
                    </li>
                    <li class="mb-8 ${isSubjectsActive ? 'activePage' : ''}">
                        <a href="${pageContext.request.contextPath}/instructor/subjects" class="fw-medium d-flex align-items-center text-14 gap-8 text-neutral-500 hover-bg-main-600 px-24 py-10 hover-text-white rounded-12 item-hover flex-wrap">
                            <span class="text-16 text-main-600 item-hover__text transition-03"><i class="ph ph-book-open-text"></i></span>
                            Subjects
                        </a>
                        <c:if test="${not empty teacherSubjectContextId}">

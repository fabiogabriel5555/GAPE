<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="calendario">
    <xs:annotation>
      <xs:documentation>📦 Contentor principal que permite múltiplos anos. Exemplo: &lt;calendario&gt;...&lt;/calendario&gt;</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ano" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>📅 Define um ano específico no calendário. Pode haver infinitos anos.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="mes" maxOccurs="12">
                <xs:annotation>
                  <xs:documentation>🌙 Representa um mês do ano. Limite máximo de 12 ocorrências.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="dia" maxOccurs="31">
                      <xs:annotation>
                        <xs:documentation>☀️ Representa um dia individual. Máximo de 31 por mês.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:choice>
                            <xs:annotation>
                              <xs:documentation>⚖️ Regra: O dia deve ser obrigatoriamente Útil, Fim-de-semana ou Feriado.</xs:documentation>
                            </xs:annotation>
                            <xs:element name="util" type="xs:string" fixed="">
                              <xs:annotation>
                                <xs:documentation>💼 Dia de trabalho normal. Deve ser vazio: &lt;util/&gt;</xs:documentation>
                              </xs:annotation>
                            </xs:element>
                            <xs:element name="fim-de-semana" type="xs:string" fixed="">
                              <xs:annotation>
                                <xs:documentation>🏖️ Sábado ou Domingo. Deve ser vazio: &lt;fim-de-semana/&gt;</xs:documentation>
                              </xs:annotation>
                            </xs:element>
                            <xs:element name="feriado">
                              <xs:annotation>
                                <xs:documentation>🎉 Dia festivo ou feriado nacional oficial.</xs:documentation>
                              </xs:annotation>
                              <xs:simpleType>                             
                                <xs:restriction base="xs:string">
                                  <xs:enumeration value="Ano Novo"/>
                                  <xs:enumeration value="Terça-feira Carnaval"/>
                                  <xs:enumeration value="Sexta-feira Santa"/>
                                  <xs:enumeration value="Páscoa"/>
                                  <xs:enumeration value="Dia da Liberdade"/>
                                  <xs:enumeration value="Dia do Trabalhador"/>
                                  <xs:enumeration value="Corpo de Deus"/>
                                  <xs:enumeration value="Dia de Portugal"/>
                                  <xs:enumeration value="Assunção de Nossa Senhora"/>
                                  <xs:enumeration value="Implantação da República"/>
                                  <xs:enumeration value="Todos os Santos"/>
                                  <xs:enumeration value="Restauração da Independência"/>
                                  <xs:enumeration value="Imaculada Conceição"/>
                                  <xs:enumeration value="Natal"/>
                                </xs:restriction>
                              </xs:simpleType>
                            </xs:element>
                          </xs:choice>
                          
                          <xs:element name="contentor" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>🗂️ Bloco opcional para informações adicionais do dia.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:all>
                                <xs:element name="agenda" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>📝 Notas pessoais ou compromissos gerais.</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:any minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="academico" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>🎓 Eventos escolares (ex: Início de aulas).</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:any minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="avaliacao" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>✍️ Datas de testes e exames.</xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:any minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:all>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        
                        <xs:attribute name="numero" use="required">
                          <xs:annotation>
                            <xs:documentation>🔢 Regra: O número do dia deve estar entre 1 e 31.</xs:documentation>
                          </xs:annotation>
                          <xs:simpleType>
                            <xs:restriction base="xs:integer">
                              <xs:minInclusive value="1"/>
                              <xs:maxInclusive value="31"/>
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:attribute>

                        <xs:attribute name="dia_semana" use="required">
                          <xs:annotation>
                            <xs:documentation>🗓️ Nome do dia da semana.</xs:documentation>
                          </xs:annotation>
                          <xs:simpleType>
                            <xs:restriction base="xs:string">
                              <xs:enumeration value="Segunda"/>
                              <xs:enumeration value="Terca"/>
                              <xs:enumeration value="Quarta"/>
                              <xs:enumeration value="Quinta"/>
                              <xs:enumeration value="Sexta"/>
                              <xs:enumeration value="Sabado"/>
                              <xs:enumeration value="Domingo"/>
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:attribute>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>

                  <xs:attribute name="nome" use="required">
                    <xs:annotation>
                      <xs:documentation>🏷️ Nome por extenso do mês.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="Janeiro"/>
                        <xs:enumeration value="Fevereiro"/>
                        <xs:enumeration value="Marco"/>
                        <xs:enumeration value="Abril"/>
                        <xs:enumeration value="Maio"/>
                        <xs:enumeration value="Junho"/>
                        <xs:enumeration value="Julho"/>
                        <xs:enumeration value="Agosto"/>
                        <xs:enumeration value="Setembro"/>
                        <xs:enumeration value="Outubro"/>
                        <xs:enumeration value="Novembro"/>
                        <xs:enumeration value="Dezembro"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>

                  <xs:attribute name="id_mes" use="required">
                    <xs:annotation>
                      <xs:documentation>🆔 Identificador numérico do mês (1 a 12).</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:integer">
                        <xs:minInclusive value="1"/>
                        <xs:maxInclusive value="12"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="valor" type="xs:gYear" use="required">
              <xs:annotation>
                <xs:documentation>🕓 O ano em formato AAAA (ex: 2026).</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
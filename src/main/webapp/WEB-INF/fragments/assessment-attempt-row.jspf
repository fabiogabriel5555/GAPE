<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<article class="ad-structure-node border border-neutral-30 rounded-8 px-18 py-16 bg-white" data-ad-attempt-row>
    <div class="ad-structure-row ad-attempt-row">
        <div class="ad-attempt-cell ad-attempt-cell--student d-flex align-items-center gap-12 min-w-0"><span class="bg-info-50 text-info-600 ad-mode-icon text-20 line-height-1"><i class="ph ph-student" aria-hidden="true"></i></span><div class="min-w-0"><span class="fw-medium text-14 text-neutral-700 d-block"><c:out value="${attempt.studentName}"/></span><span class="ad-node-meta text-12"><c:out value="${attempt.studentEmail}"/></span></div></div>
        <div class="ad-attempt-cell ad-attempt-cell--number text-14 text-neutral-600"><span class="ad-structure-cell-label">Attempt</span>#<c:out value="${attempt.attemptNumber}"/></div>
        <div class="ad-attempt-cell ad-attempt-cell--submitted text-13 text-neutral-500"><span class="ad-structure-cell-label">Submitted</span><c:choose><c:when test="${not empty attempt.submittedAt}"><span data-gape-datetime-display><c:out value="${attempt.submittedAt}"/></span></c:when><c:otherwise><span>Not submitted</span></c:otherwise></c:choose></div>
        <div class="ad-attempt-cell ad-attempt-cell--score text-13 text-neutral-500" data-ad-attempt-score="${attempt.id}"><span class="ad-structure-cell-label">Score</span><c:out value="${attempt.scoreOverMaxLabel}"/></div>
        <div class="ad-attempt-cell ad-attempt-cell--state"><span class="ad-structure-cell-label">State</span><span class="${attempt.stateBadgeClass} px-14 py-6 border-neutral-30 border rounded-pill text-13" data-ad-attempt-state="${attempt.id}"><c:out value="${attempt.stateLabel}"/></span></div>
        <div class="ad-attempt-cell ad-attempt-cell--actions d-flex align-items-center gap-10 flex-wrap justify-content-end"><span class="ad-structure-cell-label">Actions</span><c:choose><c:when test="${attempt.correctionOpen}"><button type="button" class="ad-detail-action" title="${attemptViewMode eq 'pending' ? 'Correct attempt' : 'Review or correct answers'}" aria-label="${attemptViewMode eq 'pending' ? 'Correct attempt' : 'Review or correct answers'}" data-bs-toggle="modal" data-bs-target="#correctAttemptModal${attempt.id}"><i class="${attemptViewMode eq 'pending' ? 'ph ph-pencil-simple-line' : 'ph ph-eye'}"></i></button></c:when><c:when test="${attempt.submitted}"><span class="ad-attempt-waiting">Correction unavailable</span></c:when><c:otherwise><span class="ad-attempt-waiting">Waiting for submission</span></c:otherwise></c:choose></div>
    </div>
</article>

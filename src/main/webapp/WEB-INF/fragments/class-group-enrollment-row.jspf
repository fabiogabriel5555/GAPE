<tr class="hover-bg-neutral-20 border-bottom transition-03">
    <td class="py-20 px-20">
        <span class="fw-medium text-14 text-neutral-700"><c:out value="${enrollment.studentName}"/></span>
        <span class="d-block text-12 text-neutral-500"><c:out value="${enrollment.studentEmail}"/></span>
    </td>
    <td class="py-20 px-20 text-14 text-neutral-500"><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></td>
    <td class="py-20 px-20">
        <span class="${enrollment.stateBadgeClass} px-16 py-8 border-neutral-30 border rounded-pill text-14">
            <c:out value="${enrollment.stateLabel}"/>
        </span>
    </td>
    <td class="py-20 px-20 text-end">
        <c:if test="${not classGroup.archived and canManageClassGroupEnrollments}">
            <div class="d-inline-flex align-items-center gap-10 flex-wrap justify-content-end">
                <c:if test="${enrollment.pending}">
                    <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/approve" method="post" class="m-0">
                        <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                        <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-enrollments">
                        <button type="submit" class="bg-main-600 px-14 py-8 rounded-8 text-13 fw-semibold text-white border-0 hover-bg-main-700 transition-03">Approve</button>
                    </form>
                    <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/reject" method="post" class="m-0">
                        <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                        <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-enrollments">
                        <button type="submit" class="border border-neutral-30 bg-white px-14 py-8 rounded-8 text-13 fw-semibold text-neutral-600 hover-bg-neutral-20 transition-03">Reject</button>
                    </form>
                </c:if>
                <button type="button" class="text-22 text-neutral-500 hover-text-main-600 border-0 bg-transparent p-0" title="Edit" data-bs-toggle="modal" data-bs-target="#editClassGroupEnrollment${classGroup.id}_${enrollment.studentUserId}">
                    <i class="ph ph-pencil-simple-line"></i>
                </button>
                <button type="button" class="text-22 text-neutral-500 hover-text-danger-600 border-0 bg-transparent p-0" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteClassGroupEnrollment${classGroup.id}_${enrollment.studentUserId}">
                    <i class="ph ph-trash"></i>
                </button>
            </div>

            <div class="modal fade" id="editClassGroupEnrollment${classGroup.id}_${enrollment.studentUserId}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-12 border-0">
                        <div class="modal-header border-bottom border-neutral-30">
                            <h5 class="modal-title text-18 fw-semibold">Edit Class Group Enrollment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/update" method="post">
                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                            <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-enrollments">
                            <div class="modal-body">
                                <div class="bg-neutral-20 rounded-10 px-16 py-14 mb-16 text-start">
                                    <strong><c:out value="${enrollment.studentName}"/></strong>
                                    <span class="d-block text-12 text-neutral-500"><c:out value="${enrollment.studentEmail}"/></span>
                                    <span class="d-block text-12 text-neutral-500"><c:out value="${classGroup.code}"/> - <c:out value="${classGroup.subjectName}"/></span>
                                </div>
                                <div class="row gy-3 text-start">
                                    <div class="col-12">
                                        <label for="classGroupEnrollmentState${classGroup.id}_${enrollment.studentUserId}" class="fw-medium text-base text-neutral-800 mb-12">State</label>
                                        <select id="classGroupEnrollmentState${classGroup.id}_${enrollment.studentUserId}" name="state" required class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8">
                                            <option value="pending" ${enrollment.stateValue == 'pending' ? 'selected' : ''}>Pending approval</option>
                                            <option value="active" ${enrollment.stateValue == 'active' ? 'selected' : ''}>Active</option>
                                            <option value="inactive" ${enrollment.stateValue == 'inactive' ? 'selected' : ''}>Inactive</option>
                                            <option value="rejected" ${enrollment.stateValue == 'rejected' ? 'selected' : ''}>Rejected</option>
                                            <option value="completed" ${enrollment.stateValue == 'completed' ? 'selected' : ''}>Completed</option>
                                            <option value="withdrawn" ${enrollment.stateValue == 'withdrawn' ? 'selected' : ''}>Left</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="classGroupEnrollmentStart${classGroup.id}_${enrollment.studentUserId}" class="fw-medium text-base text-neutral-800 mb-12">Start</label>
                                        <input id="classGroupEnrollmentStart${classGroup.id}_${enrollment.studentUserId}" name="startDate" type="date" value="<c:out value='${enrollment.startDateValue}'/>" class="form-control px-16 py-10 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                    </div>
                                    <div class="col-sm-6">
                                        <label for="classGroupEnrollmentEnd${classGroup.id}_${enrollment.studentUserId}" class="fw-medium text-base text-neutral-800 mb-12">End</label>
                                        <input id="classGroupEnrollmentEnd${classGroup.id}_${enrollment.studentUserId}" name="endDate" type="date" value="<c:out value='${enrollment.endDateValue}'/>" class="form-control px-16 py-10 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-top border-neutral-30">
                                <button type="button" class="border border-neutral-30 px-18 py-9 rounded-8 text-14 fw-semibold text-neutral-600 bg-white" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="bg-main-600 px-18 py-9 rounded-8 text-14 fw-semibold text-white border-0">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="deleteClassGroupEnrollment${classGroup.id}_${enrollment.studentUserId}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-12 border-0">
                        <div class="modal-header border-bottom border-neutral-30">
                            <h5 class="modal-title text-18 fw-semibold">Delete Class Group Enrollment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-start">
                            <p class="text-14 text-neutral-600 mb-0">
                                This action removes the class group enrollment for
                                <strong><c:out value="${enrollment.studentName}"/></strong>.
                            </p>
                        </div>
                        <div class="modal-footer border-top border-neutral-30">
                            <button type="button" class="border border-neutral-30 px-18 py-9 rounded-8 text-14 fw-semibold text-neutral-600 bg-white" data-bs-dismiss="modal">Cancel</button>
                            <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/delete" method="post" class="m-0">
                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-enrollments">
                                <button type="submit" class="bg-danger-600 px-18 py-9 rounded-8 text-14 fw-semibold text-white border-0">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </c:if>
    </td>
</tr>

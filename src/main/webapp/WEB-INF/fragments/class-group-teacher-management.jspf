<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<div class="bg-white rounded-10 px-24 py-24 mb-24" id="class-group-teachers">
    <div class="d-flex align-items-center justify-content-between gap-16 flex-wrap mb-20">
        <div>
            <h3 class="text-18 fw-medium text-neutral-700 mb-4">Teachers</h3>
            <span class="text-14 text-neutral-500">Assign, remove and review teaching coverage for this class group.</span>
        </div>
        <span class="bg-success-50 text-success-600 px-14 py-8 rounded-pill text-13 fw-semibold">
            ${fn:length(classGroupTeachers)} assigned
        </span>
    </div>

    <c:if test="${not classGroup.archived and canManageTeacherAssignments}">
        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/teachers" method="post" class="border border-neutral-30 rounded-12 px-20 py-18 mb-20">
            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
            <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-teachers">
            <div class="row gy-3 align-items-start">
                <div class="col-lg-6 gape-select-field">
                    <label for="classGroupTeacherUserId" class="fw-medium text-base text-neutral-800 mb-12">Teacher</label>
                    <select id="classGroupTeacherUserId" name="teacherUserId" required class="form-select px-20 py-12 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select">
                        <option value="">Select teacher</option>
                        <c:forEach var="teacher" items="${teacherOptions}">
                            <option value="${teacher.id}"><c:out value="${teacher.name}"/> - <c:out value="${teacher.email}"/></option>
                        </c:forEach>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="classGroupTeacherStartDate" class="fw-medium text-base text-neutral-800 mb-12">Start</label>
                    <input id="classGroupTeacherStartDate" name="startDate" type="date" class="form-control px-20 py-12 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                </div>
                <div class="col-md-3">
                    <label for="classGroupTeacherEndDate" class="fw-medium text-base text-neutral-800 mb-12">End</label>
                    <input id="classGroupTeacherEndDate" name="endDate" type="date" class="form-control px-20 py-12 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                </div>
                <div class="col-12">
                    <button type="submit" class="bg-main-600 px-20 py-10 rounded-12 fw-semibold text-white hover-bg-main-700 transition-03 border-0">Assign Teacher</button>
                </div>
            </div>
        </form>
    </c:if>

    <div class="border border-neutral-30 rounded-12 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table mb-0">
                <thead>
                <tr>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Teacher</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Period</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="teacherAssignment" items="${classGroupTeachers}">
                    <tr class="hover-bg-neutral-20 border-bottom transition-03">
                        <td class="py-16 px-20">
                            <span class="fw-medium text-14 text-neutral-700"><c:out value="${teacherAssignment.teacherName}"/></span>
                            <span class="d-block text-12 text-neutral-500"><c:out value="${teacherAssignment.teacherEmail}"/></span>
                        </td>
                        <td class="py-16 px-20 text-14 text-neutral-500"><c:out value="${teacherAssignment.startDate}"/> to <c:out value="${teacherAssignment.endDate}"/></td>
                        <td class="py-16 px-20">
                            <span class="${teacherAssignment.stateBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                <c:out value="${teacherAssignment.stateLabel}"/>
                            </span>
                        </td>
                        <td class="py-16 px-20 text-end">
                            <c:if test="${canManageTeacherAssignments and teacherAssignment.active}">
                                <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/teachers/${teacherAssignment.teacherUserId}/remove" method="post" class="m-0 d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                    <input type="hidden" name="returnTo" value="${currentReturnTo}#class-group-teachers">
                                    <input name="endDate" type="date" class="form-control px-12 py-8 fw-normal text-13 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" style="min-width: 150px;">
                                    <button type="submit" class="border-main-600 border px-14 py-8 rounded-8 text-13 fw-semibold text-main-600 hover-bg-main-50 transition-03">Remove</button>
                                </form>
                            </c:if>
                        </td>
                    </tr>
                </c:forEach>
                <c:if test="${empty classGroupTeachers}">
                    <tr>
                        <td colspan="4" class="py-28 px-20 text-center text-14 text-neutral-500">No teachers assigned to this class group.</td>
                    </tr>
                </c:if>
                </tbody>
            </table>
        </div>
    </div>
</div>

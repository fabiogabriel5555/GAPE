                <section id="certificates-list">
                    <div class="d-flex justify-content-end mb-18">
                        <a href="${pageContext.request.contextPath}/certificates/validate" class="border border-main-600 text-main-600 px-20 py-10 rounded-8 fw-semibold hover-bg-main-600 hover-text-white transition-03 d-inline-flex align-items-center" style="min-height: 44px;">
                            <i class="ph ph-certificate me-8"></i>Validate Certificate
                        </a>
                    </div>

                    <div class="gape-desktop-table">
                        <table class="table mb-0 aac-certificate-table">
                            <thead>
                            <tr>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Student</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Email</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">&#8470; Certificates</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                                <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            <c:forEach var="group" items="${certificateGroups}">
                                <tr class="aac-certificate-summary-row hover-bg-neutral-20 border-bottom transition-03">
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <span class="fw-medium text-neutral-700"><c:out value="${group.studentLabel}"/></span>
                                    </td>
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <c:out value="${group.studentEmail}"/>
                                    </td>
                                    <td class="py-20 px-20 text-14 text-neutral-500">
                                        <span class="fw-medium text-neutral-700">${group.certificateCount}</span>
                                    </td>
                                    <td class="py-20 px-20">
                                        <div class="aac-state-summary">
                                            <c:forEach var="summary" items="${group.stateSummaries}">
                                                <span class="${summary.badgeClass} aac-state-summary__badge px-12 py-6 border-neutral-30 border rounded-pill text-12">${summary.count} <c:out value="${summary.label}"/></span>
                                            </c:forEach>
                                            <c:if test="${empty group.stateSummaries}">
                                                <span class="aac-state-empty">No state</span>
                                            </c:if>
                                        </div>
                                    </td>
                                    <td class="py-20 px-20 text-end">
                                        <button type="button" class="aac-icon-button bg-main-50 text-main-600 collapsed" title="Show all" aria-label="Show all certificates" data-bs-toggle="collapse" data-bs-target="#certificateGroup${group.studentUserId}" aria-expanded="false" aria-controls="certificateGroup${group.studentUserId}">
                                            <i class="ph ph-caret-down"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr class="collapse" id="certificateGroup${group.studentUserId}">
                                    <td colspan="5" class="aac-expanded-cell">
                                        <div class="aac-expanded-panel">
                                            <div class="aac-expanded-panel__header">
                                                <div>
                                                    <h3 class="text-16 fw-semibold text-neutral-800 mb-4">Certificates</h3>
                                                    <span class="text-13 text-neutral-600"><c:out value="${group.studentLabel}"/> | <c:out value="${group.studentEmail}"/> | ${group.certificateCount} certificates</span>
                                                </div>
                                            </div>
                                            <div class="aac-tree">
                                                <c:forEach var="item" items="${group.certificates}">
                                                    <article class="aac-tree-node aac-tree-node--course">
                                                        <div class="aac-tree-row">
                                                            <div class="aac-tree-main">
                                                                <span class="aac-tree-icon bg-info-50 text-info-600"><i class="ph ph-certificate"></i></span>
                                                                <div class="min-w-0">
                                                                    <span class="aac-tree-title"><c:out value="${item.title}"/></span>
                                                                    <span class="aac-tree-meta"><c:out value="${item.courseLabel}"/> | <c:out value="${item.issuedAt}"/> | Grade: <c:out value="${item.finalGrade}"/></span>
                                                                </div>
                                                            </div>
                                                            <div class="aac-tree-actions">
                                                                <span class="${item.statusBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                                    <c:out value="${item.statusLabel}"/>
                                                                </span>
                                                                 <button type="button" class="aac-icon-button bg-neutral-20 text-neutral-600" title="Detail" aria-label="View certificate" data-bs-toggle="modal" data-bs-target="#certificateDetail${item.id}">
                                                                     <i class="ph ph-eye"></i>
                                                                 </button>
                                                                 <c:if test="${item.completed or (certificateDraftDownloadsAllowed and item.stateValue eq 'draft')}">
                                                                     <div class="dropdown">
                                                                         <button type="button" class="aac-icon-button bg-main-50 text-main-600" title="Download" aria-label="Download certificate" data-bs-toggle="dropdown" aria-expanded="false">
                                                                             <i class="ph ph-download-simple"></i>
                                                                         </button>
                                                                        <ul class="dropdown-menu dropdown-menu-end aac-download-menu">
                                                                            <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=pdf"><i class="ph ph-file-pdf"></i>PDF</a></li>
                                                                             <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=excel"><i class="ph ph-file-xls"></i>Excel</a></li>
                                                                         </ul>
                                                                     </div>
                                                                 </c:if>
                                                                 <c:if test="${item.completed}">
                                                                     <form action="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/revoke" method="post" class="m-0">
                                                                         <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                         <button type="submit" class="aac-icon-button bg-danger-50 text-danger-600" title="Revoke" aria-label="Revoke certificate">
                                                                             <i class="ph ph-prohibit"></i>
                                                                        </button>
                                                                    </form>
                                                                </c:if>
                                                            </div>
                                                        </div>
                                                    </article>
                                                </c:forEach>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </c:forEach>
                            <c:if test="${empty certificateGroups}">
                                <tr>
                                    <td colspan="5" class="py-32 px-20 text-center text-14 text-neutral-500">No certificates available yet.</td>
                                </tr>
                            </c:if>
                            </tbody>
                        </table>
                    </div>

                    <div class="gape-mobile-list">
                        <c:forEach var="group" items="${certificateGroups}">
                            <article class="gape-mobile-row aac-certificate-summary-row">
                                <div class="gape-mobile-row__header">
                                    <div>
                                        <div class="gape-mobile-title"><c:out value="${group.studentLabel}"/></div>
                                        <div class="gape-mobile-subtitle"><c:out value="${group.studentEmail}"/></div>
                                    </div>
                                    <span class="gape-mobile-badge px-12 py-7 border-neutral-30 border rounded-pill text-12">${group.certificateCount} certificates</span>
                                </div>
                                <div class="gape-mobile-kv">
                                    <strong>State</strong>
                                    <span class="aac-state-summary">
                                        <c:forEach var="summary" items="${group.stateSummaries}">
                                            <span class="${summary.badgeClass} aac-state-summary__badge px-12 py-6 border-neutral-30 border rounded-pill text-12">${summary.count} <c:out value="${summary.label}"/></span>
                                        </c:forEach>
                                        <c:if test="${empty group.stateSummaries}">
                                            <span class="aac-state-empty">No state</span>
                                        </c:if>
                                    </span>
                                </div>
                                <div class="gape-mobile-actions">
                                    <button type="button" class="aac-icon-button bg-main-50 text-main-600 collapsed" title="Show all" aria-label="Show all certificates" data-bs-toggle="collapse" data-bs-target="#certificateMobileGroup${group.studentUserId}" aria-expanded="false" aria-controls="certificateMobileGroup${group.studentUserId}">
                                        <i class="ph ph-caret-down"></i>
                                    </button>
                                </div>
                            </article>
                            <div class="collapse" id="certificateMobileGroup${group.studentUserId}">
                                <div class="aac-expanded-panel mt-12 mb-12">
                                    <div class="aac-expanded-panel__header">
                                        <div>
                                            <h3 class="text-16 fw-semibold text-neutral-800 mb-4">Certificates</h3>
                                            <span class="text-13 text-neutral-600"><c:out value="${group.studentLabel}"/> | <c:out value="${group.studentEmail}"/> | ${group.certificateCount} certificates</span>
                                        </div>
                                    </div>
                                    <div class="aac-tree">
                                        <c:forEach var="item" items="${group.certificates}">
                                            <article class="aac-tree-node aac-tree-node--course">
                                                <div class="aac-tree-row">
                                                    <div class="aac-tree-main">
                                                        <span class="aac-tree-icon bg-info-50 text-info-600"><i class="ph ph-certificate"></i></span>
                                                        <div class="min-w-0">
                                                            <span class="aac-tree-title"><c:out value="${item.title}"/></span>
                                                            <span class="aac-tree-meta"><c:out value="${item.courseLabel}"/> | <c:out value="${item.issuedAt}"/> | Grade: <c:out value="${item.finalGrade}"/></span>
                                                        </div>
                                                    </div>
                                                    <div class="aac-tree-actions">
                                                        <span class="${item.statusBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                            <c:out value="${item.statusLabel}"/>
                                                        </span>
                                                        <button type="button" class="aac-icon-button bg-neutral-20 text-neutral-600" title="Detail" aria-label="View certificate" data-bs-toggle="modal" data-bs-target="#certificateDetail${item.id}">
                                                            <i class="ph ph-eye"></i>
                                                        </button>
                                                        <c:if test="${item.completed or (certificateDraftDownloadsAllowed and item.stateValue eq 'draft')}">
                                                            <div class="dropdown">
                                                                <button type="button" class="aac-icon-button bg-main-50 text-main-600" title="Download" aria-label="Download certificate" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class="ph ph-download-simple"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end aac-download-menu">
                                                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=pdf"><i class="ph ph-file-pdf"></i>PDF</a></li>
                                                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/download?format=excel"><i class="ph ph-file-xls"></i>Excel</a></li>
                                                                </ul>
                                                            </div>
                                                        </c:if>
                                                        <c:if test="${item.completed}">
                                                            <form action="${pageContext.request.contextPath}/learning/grades/certificates/${item.id}/revoke" method="post" class="m-0">
                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                <button type="submit" class="aac-icon-button bg-danger-50 text-danger-600" title="Revoke" aria-label="Revoke certificate">
                                                                    <i class="ph ph-prohibit"></i>
                                                                </button>
                                                            </form>
                                                        </c:if>
                                                    </div>
                                                </div>
                                            </article>
                                        </c:forEach>
                                    </div>
                                </div>
                            </div>
                        </c:forEach>
                        <c:if test="${empty certificateGroups}">
                            <div class="gape-mobile-empty">No certificates available yet.</div>
                        </c:if>
                    </div>

                    <c:forEach var="group" items="${certificateGroups}">
                        <c:forEach var="certificate" items="${group.certificates}">
                            <div class="modal fade" id="certificateDetail${certificate.id}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                    <div class="modal-content rounded-8 border-0">
                                        <div class="modal-header border-neutral-30">
                                            <div>
                                                <h5 class="modal-title text-18 fw-semibold mb-4"><c:out value="${certificate.title}"/></h5>
                                                <span class="text-13 text-neutral-500"><c:out value="${certificate.courseLabel}"/></span>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="aac-certificate-doc">
                                                <div class="aac-certificate-doc__rail" aria-hidden="true">
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                    <span></span>
                                                </div>
                                                <div class="aac-certificate-doc__body">
                                                    <h3>Certificado de Conclus&atilde;o do Curso de <c:out value="${certificate.courseName}"/></h3>
                                                    <div class="aac-certificate-doc__identity">
                                                        <div>
                                                            <span>Certifica-se que</span>
                                                            <strong><c:out value="${certificate.studentName}"/></strong>
                                                            <small>Identifica&ccedil;&atilde;o Civil (CC/BI): <c:out value="${certificate.studentEmail}"/></small>
                                                        </div>
                                                        <div>
                                                            <span>natural de</span>
                                                            <strong>Localidade</strong>
                                                        </div>
                                                        <div>
                                                            <span>nascido em</span>
                                                            <strong>DD/MM/AAAA</strong>
                                                        </div>
                                                        <div>
                                                            <span>concluiu com</span>
                                                            <small>aproveitamento o curso de</small>
                                                            <strong><c:out value="${certificate.courseName}"/></strong>
                                                        </div>
                                                        <div>
                                                            <span>com a dura&ccedil;&atilde;o de</span>
                                                            <strong><c:out value="${certificate.courseDurationLabel}"/></strong>
                                                        </div>
                                                        <div>
                                                            <span>v&aacute;lido at&eacute;</span>
                                                            <strong>DD/MM/AAAA</strong>
                                                        </div>
                                                        <div>
                                                            <span>Total ECTS</span>
                                                            <strong><c:out value="${certificate.courseEctsLabel}"/></strong>
                                                        </div>
                                                    </div>
                                                    <table class="aac-certificate-doc__table">
                                                        <colgroup>
                                                            <col class="aac-certificate-doc__subject-col">
                                                            <col class="aac-certificate-doc__ects-col">
                                                            <col class="aac-certificate-doc__grade-col">
                                                        </colgroup>
                                                        <thead>
                                                        <tr>
                                                            <th>Unidades de Forma&ccedil;&atilde;o/M&oacute;dulos/Outras Designa&ccedil;&otilde;es</th>
                                                            <th>ECTS</th>
                                                            <th>Classifica&ccedil;&atilde;o<br>0..<c:out value="${certificate.courseCertificateMaxGradeLabel}"/></th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        <c:forEach var="row" items="${certificate.subjectRows}">
                                                            <tr>
                                                                <td><c:out value="${row.subjectLabel}"/></td>
                                                                <td><c:out value="${row.ectsLabel}"/></td>
                                                                <td><c:out value="${row.gradeLabel}"/></td>
                                                            </tr>
                                                        </c:forEach>
                                                        <tr class="aac-certificate-doc__final">
                                                            <td colspan="2">Nota Final</td>
                                                            <td><c:out value="${certificate.finalGrade}"/> valores</td>
                                                        </tr>
                                                        </tbody>
                                                    </table>
                                                    <p class="aac-certificate-doc__statement">O presente certificado comprova a conclus&atilde;o, com aproveitamento, do curso <strong><c:out value="${certificate.courseName}"/></strong>, com dura&ccedil;&atilde;o total de <strong><c:out value="${certificate.courseDurationLabel}"/></strong>, <strong><c:out value="${certificate.courseEctsLabel}"/> ECTS</strong> e disciplinas/unidades curriculares, de acordo com os requisitos acad&eacute;micos definidos para esta forma&ccedil;&atilde;o.</p>
                                                    <div class="aac-certificate-doc__date">Lisboa, <c:out value="${certificate.issuedAt}"/></div>
                                                    <div class="aac-certificate-doc__signatures">
                                                        <div>
                                                            <span>O(A) Respons&aacute;vel pelo(a)</span>
                                                            <div class="aac-certificate-doc__line">Assinatura e selo branco ou carimbo</div>
                                                        </div>
                                                        <div>
                                                            <span>Entidade Formadora, Lda.</span>
                                                            <div class="aac-certificate-doc__line">Assinatura</div>
                                                        </div>
                                                    </div>
                                                    <div class="aac-certificate-doc__legal">
                                                        <strong>Certificado n.&ordm;</strong>
                                                        <span><c:out value="${certificate.validationCode}"/></span>
                                                        <span>De acordo com o modelo publicado na Portaria n.&ordm; 474/2010</span>
                                                    </div>
                                                    <div class="aac-certificate-doc__page">
                                                        N.&ordm; de Identifica&ccedil;&atilde;o Civil (CC/BI): <c:out value="${certificate.studentEmail}"/> - P&aacute;gina 1 de 1
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </c:forEach>
                    </c:forEach>
                </section>

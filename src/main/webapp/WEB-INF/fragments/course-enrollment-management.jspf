<div class="cd-surface px-22 py-22 mb-20" id="course-students">
    <div class="gape-course-structure-panel">
        <div class="px-18 py-18" data-course-detail-sort-root>
            <div class="d-flex align-items-center justify-content-between gap-12 flex-wrap mb-16">
                <div>
                    <h3 class="text-18 fw-semibold text-neutral-800 mb-4">Enrollments</h3>
                    <span class="text-13 text-neutral-500">Each enrollment belongs to one scheduled or active course occurrence. Its dates follow that occurrence automatically.</span>
                </div>
                <div class="d-flex align-items-center gap-12 flex-wrap">
                    <div class="dropdown">
                        <button type="button"
                                class="gape-filter-toggle border-neutral-30 border px-20 py-12 rounded-12 fw-semibold text-neutral-700 hover-bg-main-50 transition-03 bg-white d-flex align-items-center gap-8"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                data-course-detail-sort-toggle
                                aria-expanded="false">
                            <i class="ph ph-sort-ascending"></i>Sort by
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end rounded-12">
                            <li>
                                <button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-course-detail-sort-option data-sort-field="name" data-sort-normal="asc" data-sort-state="none" aria-pressed="false">
                                    <span>Name</span>
                                    <span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--reverse"></i></span>
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-course-detail-sort-option data-sort-field="date" data-sort-normal="desc" data-sort-state="none" aria-pressed="false">
                                    <span>Date</span>
                                    <span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--reverse"></i></span>
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-course-detail-sort-option data-sort-field="status" data-sort-normal="asc" data-sort-state="none" aria-pressed="false">
                                    <span>State</span>
                                    <span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--reverse"></i></span>
                                </button>
                            </li>
                        </ul>
                    </div>
                <c:if test="${not course.inactive and canManageCourseEnrollments}">
                    <button type="button" class="cd-primary-button cd-section-create-button" data-bs-toggle="modal" data-bs-target="#newCourseEnrollmentModal">
                        <i class="ph ph-plus-circle me-8"></i>New Enrollment
                    </button>
                </c:if>
                </div>
            </div>

            <div class="gape-structure-list-header gape-enrollment-list-header">
                <span>Student</span>
                <span>Occurrence</span>
                <span>State</span>
                <span class="text-end">Actions</span>
            </div>

            <div class="d-flex flex-column gap-12">
                <div class="d-flex flex-column gap-12" data-course-detail-sort-list>
                <c:forEach var="enrollment" items="${currentCourseEnrollments}">
                    <%@ include file="/WEB-INF/fragments/course-enrollment-card.jspf" %>
                </c:forEach>
                <c:if test="${empty currentCourseEnrollments}">
                    <div class="border border-neutral-30 rounded-8 px-18 py-28 text-center text-14 text-neutral-500">No enrollments are available for this course.</div>
                </c:if>
                </div>

                <c:if test="${not empty completedCourseEnrollments}">
                    <div class="gape-completed-occurrences-divider" aria-hidden="true"><span>Completed enrollments</span></div>
                    <article class="gape-structure-node gape-completed-occurrences-node border rounded-8 px-18 py-16 bg-white">
                        <div class="gape-structure-row gape-enrollment-row">
                            <div class="d-flex align-items-center gap-12 min-w-0">
                                <span class="bg-danger-50 text-danger-600 cd-mode-icon text-20 line-height-1"><i class="ph ph-archive" aria-hidden="true"></i></span>
                                <div class="min-w-0">
                                    <span class="fw-medium text-14 text-neutral-700 d-block">Completed enrollments</span>
                                    <span class="gape-node-meta text-12"><span>Past enrollment records</span></span>
                                </div>
                            </div>
                            <div><span class="cd-element-count"><c:out value="${fn:length(completedCourseEnrollments)}"/></span></div>
                            <div><span class="bg-neutral-20 text-neutral-600 px-14 py-6 border-neutral-30 border rounded-pill text-13">Completed</span></div>
                            <div class="d-flex justify-content-end">
                                <button type="button"
                                        class="gape-tree-toggle text-20 text-neutral-500 hover-text-main-600"
                                        data-gape-tree-toggle="completedCourseEnrollments"
                                        data-gape-open-title="Hide completed enrollments"
                                        data-gape-closed-title="Show completed enrollments"
                                        aria-expanded="false"
                                        aria-controls="completedCourseEnrollments"
                                        aria-label="Show completed enrollments"
                                        title="Show completed enrollments"><i class="ph ph-caret-down" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div id="completedCourseEnrollments" class="gape-completed-occurrences-panel d-none">
                            <div class="gape-completed-occurrences-content d-flex flex-column gap-10" data-course-detail-sort-list>
                                <c:forEach var="enrollment" items="${completedCourseEnrollments}">
                                    <%@ include file="/WEB-INF/fragments/course-enrollment-card.jspf" %>
                                </c:forEach>
                            </div>
                        </div>
                    </article>
                </c:if>
            </div>
        </div>
    </div>
</div>

<c:if test="${not course.inactive and canManageCourseEnrollments}">
    <div class="modal fade" id="newCourseEnrollmentModal" tabindex="-1" aria-labelledby="newCourseEnrollmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-12 border-0">
                <div class="modal-header border-neutral-30">
                    <h5 class="modal-title text-18 fw-semibold" id="newCourseEnrollmentModalLabel">New Enrollment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="${pageContext.request.contextPath}${courseBasePath}/${course.id}/enrollments" method="post" data-course-live-form data-course-live-panel="enrollments">
                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                    <input type="hidden" name="returnTo" value="${currentReturnTo}#course-students">
                    <div class="modal-body">
                        <p class="text-14 text-neutral-600 mb-20">Select a student and an available course occurrence. The enrollment dates are set automatically from that occurrence.</p>
                        <div class="mb-20 gape-select-field">
                            <label for="studentUserId" class="fw-medium text-base text-neutral-800 mb-12">Student</label>
                            <select id="studentUserId" name="studentUserId" required class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select">
                                <option value="">Select student</option>
                                <c:forEach var="student" items="${studentOptions}">
                                    <option value="${student.id}">#<c:out value="${student.id}"/> &middot; <c:out value="${student.name}"/> &middot; <c:out value="${student.email}"/></option>
                                </c:forEach>
                            </select>
                        </div>
                        <div class="gape-select-field">
                            <label for="courseEnrollmentOccurrenceId" class="fw-medium text-base text-neutral-800 mb-12">Occurrence</label>
                            <select id="courseEnrollmentOccurrenceId" name="courseOccurrenceId" required class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select">
                                <option value="">Select occurrence</option>
                                <c:forEach var="occurrence" items="${courseOccurrences}">
                                    <option value="${occurrence.id}"
                                            <c:if test="${occurrence.stateValue != 'scheduled' and occurrence.stateValue != 'active'}">disabled</c:if>>
                                        <c:out value="${occurrence.code}"/> - <c:out value="${occurrence.dateRangeLabel}"/>
                                        <c:if test="${occurrence.stateValue != 'scheduled' and occurrence.stateValue != 'active'}">
                                            &middot; <c:out value="${occurrence.stateLabel}"/> (enrollment unavailable)
                                        </c:if>
                                    </option>
                                </c:forEach>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-neutral-30">
                        <button type="button" class="cd-outline-button" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="cd-primary-button border-0">Enroll Student</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</c:if>

<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<section class="ad-surface px-22 py-22 mb-20" id="assessment-enrollments">
    <div class="ad-detail-panel">
        <div class="ad-detail-panel-content" data-ad-detail-sort-root>
            <div class="ad-detail-panel-header">
                <div class="ad-detail-panel-heading">
                    <h3 class="text-18 fw-semibold text-neutral-800 mb-4">Enrollments</h3>
                    <span class="text-13 text-neutral-500">Review every enrollment here and decide pending requests separately.</span>
                </div>
                <div class="ad-detail-panel-actions">
                    <div class="dropdown">
                        <button type="button" class="ad-sort-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-ad-detail-sort-toggle aria-expanded="false"><i class="ph ph-sort-ascending"></i>Sort by</button>
                        <ul class="dropdown-menu dropdown-menu-end rounded-12">
                            <li><button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-ad-detail-sort-option data-sort-field="name" data-sort-normal="asc" data-sort-state="none" aria-pressed="false"><span>Name</span><span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--reverse"></i></span></button></li>
                            <li><button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-ad-detail-sort-option data-sort-field="date" data-sort-normal="desc" data-sort-state="none" aria-pressed="false"><span>Date</span><span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--reverse"></i></span></button></li>
                            <li><button type="button" class="dropdown-item gape-sort-option d-flex align-items-center justify-content-between gap-16 px-16 py-10" data-ad-detail-sort-option data-sort-field="status" data-sort-normal="asc" data-sort-state="none" aria-pressed="false"><span>State</span><span class="gape-sort-arrows d-flex align-items-center justify-content-end gap-4" aria-hidden="true"><i class="ph ph-arrow-up gape-sort-arrow gape-sort-arrow--normal"></i><i class="ph ph-arrow-down gape-sort-arrow gape-sort-arrow--reverse"></i></span></button></li>
                        </ul>
                    </div>
                    <c:if test="${canManageAssessmentEnrollments}">
                        <button type="button" class="ad-outline-button" data-bs-toggle="modal" data-bs-target="#assessmentEnrollmentPolicyModal"><i class="ph ph-sliders-horizontal me-8"></i>Policy</button>
                        <button type="button" class="ad-primary-button" data-bs-toggle="modal" data-bs-target="#newAssessmentEnrollmentModal"><i class="ph ph-plus-circle me-8"></i>Enroll Student</button>
                    </c:if>
                </div>
            </div>

            <div class="ad-enrollment-tabs" role="tablist" aria-label="Assessment enrollment views">
                <button type="button" class="ad-enrollment-tab is-active" data-ad-enrollment-tab="enrollments" aria-selected="true"><i class="ph ph-users-three"></i>Enrollments <span class="ad-element-count">${fn:length(managedAssessmentEnrollments)}</span></button>
                <button type="button" class="ad-enrollment-tab" data-ad-enrollment-tab="requests" aria-selected="false"><i class="ph ph-clock"></i>Enrollment Requests <c:if test="${fn:length(pendingAssessmentEnrollments) > 0}"><span class="badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2" data-assessment-enrollment-requests-pending-badge>${fn:length(pendingAssessmentEnrollments)}</span></c:if></button>
            </div>

            <div class="ad-enrollment-tab-panel" data-ad-enrollment-panel="enrollments">
                <div class="ad-structure-list-header ad-assignment-list-header"><span>Student</span><span>Availability period</span><span>State</span><span class="text-end">Actions</span></div>
                <div class="d-flex flex-column gap-12" data-ad-detail-sort-list>
                    <c:set var="assessmentEnrollmentTab" value="enrollments"/>
                    <c:forEach var="enrollment" items="${managedAssessmentEnrollments}" varStatus="enrollmentLoop"><c:set var="assessmentEnrollmentRowIndex" value="${enrollmentLoop.index}"/><%@ include file="/WEB-INF/fragments/assessment-enrollment-row.jspf" %></c:forEach>
                    <c:if test="${empty managedAssessmentEnrollments}"><div class="border border-neutral-30 rounded-8 px-18 py-28 text-center text-14 text-neutral-500">No enrollments have been recorded for this assessment.</div></c:if>
                </div>
            </div>
            <div class="ad-enrollment-tab-panel" data-ad-enrollment-panel="requests" hidden>
                <div class="ad-structure-list-header ad-assignment-list-header"><span>Student</span><span>Availability period</span><span>State</span><span class="text-end">Actions</span></div>
                <div class="d-flex flex-column gap-12" data-ad-detail-sort-list>
                    <c:set var="assessmentEnrollmentTab" value="requests"/>
                    <c:forEach var="enrollment" items="${pendingAssessmentEnrollments}" varStatus="enrollmentLoop"><c:set var="assessmentEnrollmentRowIndex" value="${enrollmentLoop.index}"/><%@ include file="/WEB-INF/fragments/assessment-enrollment-row.jspf" %></c:forEach>
                    <c:if test="${empty pendingAssessmentEnrollments}"><div class="border border-neutral-30 rounded-8 px-18 py-28 text-center text-14 text-neutral-500">No pending assessment enrollment requests.</div></c:if>
                </div>
            </div>
        </div>
    </div>
</section>

<c:if test="${canManageAssessmentEnrollments}">
    <div class="modal fade" id="newAssessmentEnrollmentModal" tabindex="-1" aria-hidden="true" data-assessment-rigid-modal>
        <div class="modal-dialog modal-dialog-centered ad-enrollment-modal-dialog">
            <div class="modal-content rounded-12 border-0">
                <div class="modal-header border-neutral-30"><h5 class="modal-title text-18 fw-semibold">Enroll Student</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form action="${pageContext.request.contextPath}/learning/assessments/${assessment.id}/enrollments" method="post" data-assessment-live-form data-assessment-live-panel="enrollments">
                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                    <input type="hidden" name="returnTo" value="/learning/assessments/${assessment.id}#enrollments">
                    <div class="modal-body">
                        <p class="text-14 text-neutral-600 mb-8">Search by student ID, name or email, then select the student to enroll.</p>
                        <p class="text-13 text-neutral-500 mb-20">The enrollment period is managed automatically from this assessment's availability.</p>
                        <div class="gape-select-field mb-0">
                            <label for="assessmentEnrollmentStudentUserId" class="fw-medium text-base text-neutral-800 mb-12">Student</label>
                            <select id="assessmentEnrollmentStudentUserId" name="studentUserId" required class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select" data-select2-placeholder="Search ID, name or email">
                                <option value="">Search ID, name or email</option>
                                <c:forEach var="student" items="${assessmentStudentOptions}"><option value="${student.id}">#<c:out value="${student.id}"/> &middot; <c:out value="${student.name}"/> &middot; <c:out value="${student.email}"/></option></c:forEach>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-neutral-30"><button type="button" class="ad-outline-button" data-bs-dismiss="modal">Cancel</button><button type="submit" class="ad-primary-button border-0" data-assessment-live-submit>Enroll Student</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="assessmentEnrollmentPolicyModal" tabindex="-1" aria-hidden="true" data-assessment-rigid-modal>
        <div class="modal-dialog modal-dialog-centered ad-enrollment-modal-dialog">
            <div class="modal-content rounded-12 border-0">
                <div class="modal-header border-neutral-30"><h5 class="modal-title text-18 fw-semibold">Enrollment Policy</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <form action="${pageContext.request.contextPath}/learning/assessments/${assessment.id}/enrollment-policy" method="post" data-assessment-live-form data-assessment-live-panel="enrollments">
                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                    <input type="hidden" name="returnTo" value="/learning/assessments/${assessment.id}#enrollments">
                    <div class="modal-body"><div><label for="assessmentEnrollmentApprovalMode" class="fw-medium text-base text-neutral-800 mb-12">Approval mode</label><select id="assessmentEnrollmentApprovalMode" name="approvalMode" class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8"><option value="manual" <c:if test="${assessment.enrollmentModeValue ne 'auto_approve'}">selected</c:if>>Manual approval</option><option value="auto_approve" <c:if test="${assessment.enrollmentModeValue eq 'auto_approve'}">selected</c:if>>Automatic approval</option></select><span class="text-13 text-neutral-500 d-block mt-10">Changes are saved immediately and applied to future enrollment requests.</span></div></div>
                    <div class="modal-footer border-neutral-30"><button type="button" class="ad-outline-button" data-bs-dismiss="modal">Cancel</button><button type="submit" class="ad-primary-button border-0" data-assessment-live-submit>Save Policy</button></div>
                </form>
            </div>
        </div>
    </div>
</c:if>

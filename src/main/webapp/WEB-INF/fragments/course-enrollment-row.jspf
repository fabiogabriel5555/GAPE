<tr class="hover-bg-neutral-20 border-bottom transition-03">
    <td class="${courseEnrollmentEmbedded ? 'py-16 px-16' : 'py-20 px-20'}">
        <span class="fw-medium text-14 text-neutral-700"><c:out value="${enrollment.studentName}"/></span>
        <span class="d-block text-12 text-neutral-500"><c:out value="${enrollment.studentEmail}"/></span>
    </td>
    <td class="${courseEnrollmentEmbedded ? 'py-16 px-16' : 'py-20 px-20'} text-14 text-neutral-700">
        <span class="fw-medium"><c:out value="${enrollment.courseOccurrenceCode}"/></span>
    </td>
    <td class="${courseEnrollmentEmbedded ? 'py-16 px-16' : 'py-20 px-20'} text-14 text-neutral-500" data-gape-datetime-display><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></td>
    <td class="${courseEnrollmentEmbedded ? 'py-16 px-16' : 'py-20 px-20'}">
        <span class="${enrollment.stateBadgeClass} ${courseEnrollmentEmbedded ? 'px-12 py-6 text-12' : 'px-16 py-8 text-14'} border-neutral-30 border rounded-pill">
            <c:out value="${enrollment.stateLabel}"/>
        </span>
    </td>
    <td class="${courseEnrollmentEmbedded ? 'py-16 px-16' : 'py-20 px-20'} text-end">
        <c:if test="${not course.inactive and canManageCourseEnrollments}">
            <div class="d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                <button type="button" class="text-22 text-neutral-500 hover-text-main-600 border-0 bg-transparent p-0" title="Edit" data-bs-toggle="modal" data-bs-target="#editCourseEnrollment${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}">
                    <i class="ph ph-pencil-simple-line"></i>
                </button>
                <button type="button" class="text-22 text-neutral-500 hover-text-main-600 border-0 bg-transparent p-0" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteCourseEnrollment${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}">
                    <i class="ph ph-trash"></i>
                </button>
            </div>

            <div class="modal fade" id="editCourseEnrollment${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-12 border-0 text-start">
                        <div class="modal-header border-neutral-30">
                            <h5 class="modal-title text-18 fw-semibold">Edit Enrollment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="${pageContext.request.contextPath}${courseBasePath}/${course.id}/enrollments/${enrollment.studentUserId}/update" method="post" data-course-live-form data-course-live-panel="enrollments">
                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                            <input type="hidden" name="returnTo" value="${currentReturnTo}#course-students">
                            <input type="hidden" name="courseOccurrenceId" value="${enrollment.courseOccurrenceId}">
                            <div class="modal-body">
                                <p class="text-14 text-neutral-600 mb-20">
                                    <strong><c:out value="${enrollment.studentName}"/></strong>
                                    <span class="d-block text-12 text-neutral-500"><c:out value="${enrollment.studentEmail}"/></span>
                                </p>
                                <div class="row gy-3">
                                    <div class="col-12">
                                        <span class="text-13 text-neutral-500 d-block mb-10">Occurrence: <c:out value="${enrollment.courseOccurrenceCode}"/> &middot; <c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></span>
                                    </div>
                                    <div class="col-12 gape-select-field">
                                        <label for="courseEnrollmentState${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}" class="fw-medium text-base text-neutral-800 mb-12">State</label>
                                        <select id="courseEnrollmentState${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}" name="state" required class="form-select px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8">
                                            <option value="active" ${enrollment.stateValue == 'active' ? 'selected' : ''}>Active</option>
                                            <option value="inactive" ${enrollment.stateValue == 'inactive' ? 'selected' : ''}>Inactive</option>
                                            <option value="withdrawn" ${enrollment.stateValue == 'withdrawn' ? 'selected' : ''}>Left</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-neutral-30">
                                <button type="button" class="border-main-600 border px-20 py-10 fw-semibold rounded-12 hover-bg-main-50 transition-03" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="bg-main-600 px-20 py-10 rounded-12 fw-semibold text-white hover-bg-main-700 transition-03 border-0">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="deleteCourseEnrollment${course.id}_${enrollment.studentUserId}_${enrollment.courseOccurrenceId}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-12 border-0 text-start">
                        <div class="modal-header border-neutral-30">
                            <h5 class="modal-title text-18 fw-semibold">Delete Enrollment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-14 text-neutral-600 mb-0">
                                This action removes the course enrollment for
                                <strong><c:out value="${enrollment.studentName}"/></strong>.
                            </p>
                        </div>
                        <div class="modal-footer border-neutral-30">
                            <button type="button" class="border-main-600 border px-20 py-10 fw-semibold rounded-12 hover-bg-main-50 transition-03" data-bs-dismiss="modal">Cancel</button>
                            <form action="${pageContext.request.contextPath}${courseBasePath}/${course.id}/enrollments/${enrollment.studentUserId}/delete" method="post" class="m-0" data-course-live-form data-course-live-panel="enrollments">
                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                <input type="hidden" name="returnTo" value="${currentReturnTo}#course-students">
                                <input type="hidden" name="courseOccurrenceId" value="${enrollment.courseOccurrenceId}">
                                <button type="submit" class="gape-action-button gape-action-delete px-20 py-10 rounded-12 fw-semibold transition-03">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </c:if>
    </td>
</tr>

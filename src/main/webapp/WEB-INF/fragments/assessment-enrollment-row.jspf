<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="assessmentEnrollmentModalKey" value="${assessment.id}_${enrollment.studentUserId}_${assessmentEnrollmentTab}"/>
<article class="ad-structure-node border border-neutral-30 rounded-8 px-18 py-16 bg-white"
         data-ad-detail-sort-row
         data-sort-index="${assessmentEnrollmentRowIndex}"
         data-sort-name="<c:out value='${enrollment.studentName}'/>"
         data-sort-date="${fn:replace(enrollment.startDateValue, '-', '')}"
         data-sort-status="<c:out value='${enrollment.stateLabel}'/>">
    <div class="ad-structure-row ad-assignment-row">
        <div class="ad-assignment-cell ad-assignment-cell--student d-flex align-items-center gap-12 min-w-0">
            <span class="bg-info-50 text-info-600 ad-mode-icon text-20 line-height-1"><i class="ph ph-student" aria-hidden="true"></i></span>
            <div class="min-w-0"><span class="fw-medium text-14 text-neutral-700 d-block"><c:out value="${enrollment.studentName}"/></span><span class="ad-node-meta text-12"><c:out value="${enrollment.studentEmail}"/></span></div>
        </div>
        <div class="ad-assignment-cell ad-assignment-cell--availability min-w-0"><span class="ad-structure-cell-label">Availability period</span><span class="fw-medium text-14 text-neutral-700 d-block"><c:out value="${assessment.title}"/></span><span class="ad-node-meta text-12" data-gape-datetime-display><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></span></div>
        <div class="ad-assignment-cell ad-assignment-cell--state"><span class="ad-structure-cell-label">State</span><span class="${enrollment.stateBadgeClass} px-14 py-6 border-neutral-30 border rounded-pill text-13"><c:out value="${enrollment.stateLabel}"/></span></div>
        <div class="ad-assignment-cell ad-assignment-cell--actions d-flex align-items-center gap-10 flex-wrap justify-content-end"><span class="ad-structure-cell-label">Actions</span>
            <c:if test="${canManageAssessmentEnrollments and enrollment.pending}">
                <button type="button" class="ad-detail-action ad-detail-action--decision" title="Decide enrollment request" aria-label="Decide enrollment request" data-bs-toggle="modal" data-bs-target="#assessmentEnrollmentDecision${assessmentEnrollmentModalKey}"><i class="ph ph-check-circle"></i></button>
            </c:if>
            <button type="button" class="ad-detail-action" title="Detail" aria-label="Enrollment details" data-bs-toggle="modal" data-bs-target="#assessmentEnrollmentDetail${assessmentEnrollmentModalKey}"><i class="ph ph-eye"></i></button>
            <c:if test="${canManageAssessmentEnrollments}"><button type="button" class="ad-detail-action ad-detail-action--danger" title="Delete" aria-label="Delete enrollment" data-bs-toggle="modal" data-bs-target="#deleteAssessmentEnrollment${assessmentEnrollmentModalKey}"><i class="ph ph-trash"></i></button></c:if>
        </div>
    </div>
</article>

<c:if test="${canManageAssessmentEnrollments and enrollment.pending}">
    <div class="modal fade" id="assessmentEnrollmentDecision${assessmentEnrollmentModalKey}" tabindex="-1" aria-hidden="true" data-assessment-rigid-modal>
        <div class="modal-dialog modal-dialog-centered ad-enrollment-modal-dialog ad-enrollment-decision-modal-dialog"><div class="modal-content rounded-12 border-0 text-start"><div class="modal-header border-neutral-30"><h5 class="modal-title text-18 fw-semibold">Decide Enrollment Request</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p class="text-14 text-neutral-600 mb-16">Choose whether to approve or reject this request. The list updates immediately after the decision.</p><div class="ad-enrollment-decision-summary"><span class="text-12 text-neutral-500">Student</span><strong class="text-14 text-neutral-700">#<c:out value="${enrollment.studentUserId}"/> &middot; <c:out value="${enrollment.studentName}"/></strong><span class="text-12 text-neutral-500 mt-8">Availability period</span><span class="text-14 text-neutral-700" data-gape-datetime-display><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></span></div></div><div class="modal-footer border-neutral-30"><button type="button" class="ad-outline-button" data-bs-dismiss="modal">Cancel</button><form action="${pageContext.request.contextPath}/learning/assessments/${assessment.id}/enrollments/${enrollment.studentUserId}/reject" method="post" class="m-0" data-assessment-live-form data-assessment-live-panel="enrollments" data-assessment-live-enrollment-request-action><input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}"><input type="hidden" name="returnTo" value="/learning/assessments/${assessment.id}#enrollments"><button type="submit" class="ad-danger-button" data-assessment-live-submit>Reject</button></form><form action="${pageContext.request.contextPath}/learning/assessments/${assessment.id}/enrollments/${enrollment.studentUserId}/approve" method="post" class="m-0" data-assessment-live-form data-assessment-live-panel="enrollments" data-assessment-live-enrollment-request-action><input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}"><input type="hidden" name="returnTo" value="/learning/assessments/${assessment.id}#enrollments"><button type="submit" class="ad-primary-button border-0" data-assessment-live-submit>Approve</button></form></div></div></div>
    </div>
</c:if>

<div class="modal fade" id="assessmentEnrollmentDetail${assessmentEnrollmentModalKey}" tabindex="-1" aria-hidden="true" data-assessment-rigid-modal>
    <div class="modal-dialog modal-dialog-centered ad-enrollment-modal-dialog"><div class="modal-content rounded-12 border-0 text-start"><div class="modal-header border-neutral-30"><h5 class="modal-title text-18 fw-semibold">Enrollment Details</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3"><div class="col-sm-6"><span class="text-12 text-neutral-500 d-block mb-6">Student</span><span class="fw-medium text-14 text-neutral-700">#<c:out value="${enrollment.studentUserId}"/> &middot; <c:out value="${enrollment.studentName}"/></span></div><div class="col-sm-6"><span class="text-12 text-neutral-500 d-block mb-6">Email</span><span class="fw-medium text-14 text-neutral-700"><c:out value="${enrollment.studentEmail}"/></span></div><div class="col-sm-6"><span class="text-12 text-neutral-500 d-block mb-6">Assessment</span><span class="fw-medium text-14 text-neutral-700"><c:out value="${assessment.title}"/></span></div><div class="col-sm-6"><span class="text-12 text-neutral-500 d-block mb-6">Availability period</span><span class="fw-medium text-14 text-neutral-700" data-gape-datetime-display><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></span></div><div class="col-12"><span class="text-12 text-neutral-500 d-block mb-6">State</span><span class="${enrollment.stateBadgeClass} px-12 py-5 border-neutral-30 border rounded-pill text-12"><c:out value="${enrollment.stateLabel}"/></span></div></div></div><div class="modal-footer border-neutral-30"><button type="button" class="ad-outline-button" data-bs-dismiss="modal">Close</button></div></div></div>
</div>

<c:if test="${canManageAssessmentEnrollments}">
    <div class="modal fade" id="deleteAssessmentEnrollment${assessmentEnrollmentModalKey}" tabindex="-1" aria-hidden="true" data-assessment-rigid-modal>
        <div class="modal-dialog modal-dialog-centered ad-enrollment-modal-dialog"><div class="modal-content rounded-12 border-0 text-start"><div class="modal-header border-neutral-30"><h5 class="modal-title text-18 fw-semibold">Delete Enrollment</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p class="text-14 text-neutral-600 mb-0">This action removes the assessment enrollment for <strong><c:out value="${enrollment.studentName}"/></strong>.</p></div><div class="modal-footer border-neutral-30"><button type="button" class="ad-outline-button" data-bs-dismiss="modal">Cancel</button><form action="${pageContext.request.contextPath}/learning/assessments/${assessment.id}/enrollments/${enrollment.studentUserId}/delete" method="post" class="m-0" data-assessment-live-form data-assessment-live-panel="enrollments"><input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}"><input type="hidden" name="returnTo" value="/learning/assessments/${assessment.id}#enrollments"><button type="submit" class="ad-danger-button" data-assessment-live-submit>Delete</button></form></div></div></div>
    </div>
</c:if>

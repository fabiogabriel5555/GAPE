<c:set var="occurrenceGroupPanelId" value="${occurrenceGroupPanelPrefix}${subject.id}_${occurrenceGroup.disclosureId}" />
<article class="gape-structure-node border border-neutral-30 rounded-8 px-16 py-12 bg-white" data-subject-detail-occurrence-group>
    <div class="gape-structure-row">
        <div class="d-flex align-items-center gap-12 min-w-0">
            <span class="${occurrenceGroupIconClass} cd-mode-icon text-20 line-height-1"><i class="${occurrenceGroupIcon}" aria-hidden="true"></i></span>
            <div class="min-w-0">
                <span class="fw-medium text-14 text-neutral-700 d-block"><c:out value="${occurrenceGroup.occurrenceLabel}"/></span>
                <span class="gape-node-meta text-12"><span data-gape-datetime-display><c:out value="${occurrenceGroup.occurrenceDateRangeLabel}"/></span><span><c:out value="${occurrenceGroup.classGroupCount}"/> class groups</span></span>
            </div>
        </div>
        <div class="text-13 text-neutral-500">Course occurrence</div>
        <div><span class="cd-element-count"><c:out value="${occurrenceGroup.classGroupCount}"/></span></div>
        <div><span class="${occurrenceGroup.occurrenceStateBadgeClass} px-14 py-6 border-neutral-30 border rounded-pill text-13"><c:out value="${occurrenceGroup.occurrenceStateLabel}"/></span></div>
        <div class="d-flex justify-content-end">
            <c:choose>
                <c:when test="${occurrenceGroupStartsOpen}">
                    <button type="button"
                            class="gape-tree-toggle text-20 text-neutral-500 hover-text-main-600"
                            data-gape-tree-toggle="${occurrenceGroupPanelId}"
                            data-gape-open-title="Hide class groups"
                            data-gape-closed-title="Show class groups"
                            aria-expanded="true"
                            aria-controls="${occurrenceGroupPanelId}"
                            aria-label="Hide class groups"
                            title="Hide class groups">
                        <i class="ph ph-caret-up" aria-hidden="true"></i>
                    </button>
                </c:when>
                <c:otherwise>
                    <button type="button"
                            class="gape-tree-toggle text-20 text-neutral-500 hover-text-main-600"
                            data-gape-tree-toggle="${occurrenceGroupPanelId}"
                            data-gape-open-title="Hide class groups"
                            data-gape-closed-title="Show class groups"
                            aria-expanded="false"
                            aria-controls="${occurrenceGroupPanelId}"
                            aria-label="Show class groups"
                            title="Show class groups">
                        <i class="ph ph-caret-down" aria-hidden="true"></i>
                    </button>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
    <div id="${occurrenceGroupPanelId}" class="gape-subject-occurrence-groups-panel<c:if test="${not occurrenceGroupStartsOpen}"> d-none</c:if>">
        <div class="gape-subject-occurrence-groups-content" data-subject-detail-sort-list>
            <c:forEach var="classGroup" items="${occurrenceGroup.classGroups}" varStatus="classGroupLoop">
                <%@ include file="/WEB-INF/fragments/subject-class-group-row.jspf" %>
            </c:forEach>
        </div>
    </div>
</article>

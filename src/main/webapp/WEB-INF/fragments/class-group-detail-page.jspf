<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="${pageContext.request.contextPath}/">
    <title>GAPE - Class Group Details</title>
    <%@ include file="/WEB-INF/fragments/template-base-head.jspf" %>
    <style>
        .cg-shell {
            --cg-primary: #00a991;
            --cg-primary-dark: #008a78;
            --cg-primary-soft: #ecfdf5;
            --cg-primary-surface: #f2fffc;
            --cg-primary-rgb: 0, 169, 145;
            --cg-primary-highlight-rgb: 16, 185, 129;
            --cg-secondary: #00a991;
            --cg-secondary-dark: #008a78;
            --cg-secondary-soft: #ecfdf5;
            --cg-secondary-surface: #f2fffc;
            --cg-secondary-rgb: 0, 169, 145;
            --cg-secondary-highlight-rgb: 16, 185, 129;
            --cg-border: #e6edf0;
            --cg-muted: #64748b;
            --cg-ink: #172033;
        }

        .cg-shell--completed {
            --cg-primary: #dc2626;
            --cg-primary-dark: #b91c1c;
            --cg-primary-soft: #fef2f2;
            --cg-primary-surface: #fffafa;
            --cg-primary-rgb: 220, 38, 38;
            --cg-primary-highlight-rgb: 248, 113, 113;
            --cg-secondary: #dc2626;
            --cg-secondary-dark: #b91c1c;
            --cg-secondary-soft: #fef2f2;
            --cg-secondary-surface: #fffafa;
            --cg-secondary-rgb: 220, 38, 38;
            --cg-secondary-highlight-rgb: 248, 113, 113;
        }

        .cg-surface {
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
        }

        .cg-hero {
            background: linear-gradient(135deg, rgba(var(--cg-primary-rgb), 0.12), rgba(var(--cg-primary-highlight-rgb), 0.06)), #fff;
        }

        .cg-mode-grid {
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .cg-mode-card {
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            color: var(--cg-ink);
            cursor: pointer;
            min-height: 144px;
            padding: 20px;
            position: relative;
            text-align: left;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
            width: 100%;
        }

        .cg-mode-card.is-active {
            background: linear-gradient(135deg, rgba(var(--cg-primary-rgb), 0.14), rgba(var(--cg-primary-highlight-rgb), 0.06)), var(--cg-primary-surface);
            border-color: rgba(var(--cg-primary-rgb), 0.65);
            box-shadow: 0 16px 36px rgba(var(--cg-primary-rgb), 0.12);
            transform: translateY(-1px);
        }

        .cg-mode-card--structure.is-active {
            background: linear-gradient(135deg, rgba(var(--cg-secondary-rgb), 0.16), rgba(var(--cg-secondary-rgb), 0.06)), var(--cg-secondary-surface);
            border-color: rgba(var(--cg-secondary-rgb), 0.75);
            box-shadow: 0 16px 36px rgba(var(--cg-secondary-rgb), 0.12);
        }

        .cg-mode-card.is-active .cg-mode-icon {
            background: var(--cg-primary) !important;
            color: #fff !important;
        }

        .cg-pending-corner-badge {
            align-items: center;
            background: #dc2626;
            border: 2px solid #fff;
            border-radius: 999px;
            color: #fff;
            display: inline-flex;
            font-size: 11px;
            font-weight: 700;
            justify-content: center;
            left: -8px;
            line-height: 1;
            min-height: 22px;
            min-width: 22px;
            padding: 3px 6px;
            position: absolute;
            top: -8px;
            z-index: 2;
        }

        .cg-mode-card--structure.is-active .cg-mode-icon {
            background: var(--cg-secondary) !important;
        }

        .cg-soft-badge {
            background: var(--cg-primary-soft);
            color: var(--cg-primary);
        }

        .cg-count-text {
            color: var(--cg-primary);
        }

        .cg-structure-mode-icon {
            background: var(--cg-secondary-soft) !important;
            color: var(--cg-secondary) !important;
        }

        .cg-structure-count {
            color: var(--cg-secondary);
        }

        .cg-structure-badge {
            background: var(--cg-primary-soft);
            color: var(--cg-primary);
        }

        .cg-mode-icon,
        .cg-content-icon,
        .cg-activity-icon {
            align-items: center;
            border-radius: 8px;
            display: inline-flex;
            flex-shrink: 0;
            justify-content: center;
        }

        .cg-mode-icon {
            height: 44px;
            width: 44px;
        }

        .cg-tab-panel[hidden] {
            display: none !important;
        }

        .cg-primary-button,
        .cg-outline-button,
        .cg-danger-button,
        .cg-warning-button,
        .cg-icon-button {
            align-items: center;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            font-weight: 600;
            justify-content: center;
            line-height: 1.2;
            min-height: 42px;
            text-decoration: none;
            transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }

        .cg-primary-button {
            background: var(--cg-primary);
            border: 1px solid var(--cg-primary);
            color: #fff;
            padding: 10px 16px;
        }

        .cg-primary-button:hover {
            background: var(--cg-primary-dark);
            border-color: var(--cg-primary-dark);
            color: #fff;
            transform: translateY(-1px);
        }

        .cg-primary-button:disabled {
            cursor: not-allowed;
            opacity: 0.76;
            transform: none;
        }

        .cg-upload-button {
            gap: 8px;
            min-width: 150px;
            overflow: hidden;
            position: relative;
        }

        .cg-upload-button > span:not(.cg-upload-button-progress) {
            position: relative;
            z-index: 1;
        }

        .cg-upload-button-progress {
            background: rgba(255, 255, 255, 0.24);
            bottom: 0;
            display: none;
            left: 0;
            position: absolute;
            top: 0;
            transition: width 0.18s ease;
            width: 0;
        }

        .cg-upload-button.is-uploading .cg-upload-button-progress {
            display: block;
        }

        .cg-upload-button.is-indeterminate .cg-upload-button-progress {
            animation: cg-upload-indeterminate 1.15s ease-in-out infinite;
            width: 42%;
        }

        .cg-upload-button-spinner {
            display: none;
            font-size: 18px;
            line-height: 1;
        }

        .cg-upload-button.is-uploading .cg-upload-button-spinner {
            display: inline-flex;
        }

        .cg-upload-button-spinner i {
            animation: cg-upload-spin 0.9s linear infinite;
        }

        @keyframes cg-upload-spin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes cg-upload-indeterminate {
            0% {
                left: -45%;
            }
            55% {
                left: 42%;
            }
            100% {
                left: 100%;
            }
        }

        .cg-outline-button {
            background: #fff;
            border: 1px solid var(--cg-border);
            color: var(--cg-ink);
            padding: 10px 16px;
        }

        .cg-outline-button:hover {
            border-color: rgba(var(--cg-primary-rgb), 0.45);
            color: var(--cg-primary-dark);
        }

        .cg-danger-button {
            background: #dc2626;
            border: 1px solid #dc2626;
            color: #fff;
            padding: 10px 16px;
        }

        .cg-warning-button {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #c2410c;
            padding: 10px 16px;
        }

        .cg-danger-button:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff;
            transform: translateY(-1px);
        }

        .cg-warning-button:hover {
            background: #ffedd5;
            border-color: #fdba74;
            color: #9a3412;
            transform: translateY(-1px);
        }

        .cg-structure-theme {
            --cg-primary: var(--cg-secondary);
            --cg-primary-dark: var(--cg-secondary-dark);
            --cg-primary-soft: var(--cg-secondary-soft);
            --cg-primary-surface: var(--cg-secondary-surface);
            --cg-primary-rgb: var(--cg-secondary-rgb);
            --cg-primary-highlight-rgb: var(--cg-secondary-highlight-rgb);
        }

        .cg-lazy-loading-spinner {
            align-items: center;
            display: inline-flex;
            justify-content: center;
            min-height: 1.2em;
            min-width: 1.2em;
        }

        .cg-lazy-loading-spinner > i {
            animation: cg-lazy-loading-spin 0.8s linear infinite;
            display: inline-block;
        }

        @keyframes cg-lazy-loading-spin {
            to { transform: rotate(360deg); }
        }

        .cg-icon-button {
            background: transparent;
            border: 1px solid transparent;
            color: #64748b;
            height: 40px;
            min-height: 40px;
            padding: 0;
            width: 40px;
        }

        .cg-icon-button:hover {
            background: rgba(0, 169, 145, 0.09);
            color: var(--cg-primary-dark);
        }

        .cg-block {
            border-left: 4px solid var(--cg-primary);
            overflow: hidden;
        }

        .cg-drag-handle {
            cursor: grab;
            touch-action: none;
        }

        .cg-dragging {
            opacity: 0.58;
        }

        .cg-drop-target {
            outline: 2px dashed rgba(0, 169, 145, 0.32);
            outline-offset: 3px;
        }

        .cg-block-header {
            background: linear-gradient(180deg, #ffffff 0%, #f7fffd 100%);
            border-bottom: 2px solid rgba(0, 169, 145, 0.18);
            padding: 22px 20px 20px;
        }

        .cg-block.is-inactive {
            border-left-color: #f43f5e;
        }

        .cg-block.is-inactive .cg-block-header {
            background: linear-gradient(180deg, #ffffff 0%, #fff5f7 100%);
            border-bottom-color: rgba(244, 63, 94, 0.18);
        }

        .cg-block-number {
            color: rgba(0, 169, 145, 0.26);
            font-size: 54px;
            font-weight: 800;
            letter-spacing: 0;
            line-height: 0.9;
            min-width: 72px;
            text-align: center;
        }

        .cg-block.is-inactive .cg-block-number {
            color: rgba(244, 63, 94, 0.28);
        }

        .cg-block-toolbar {
            background: #f8fbfb;
            border-top: 1px solid var(--cg-border);
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 14px 18px;
        }

        .cg-content-list {
            background: #fff;
        }

        .cg-content-row {
            align-items: center;
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(0, 1fr) auto;
            min-height: 82px;
            padding: 16px 18px;
        }

        .cg-content-list .cg-content-row:first-child {
            padding-top: 20px;
        }

        .cg-content-row + .cg-content-row {
            border-top: 1px solid var(--cg-border);
        }

        .cg-content-icon {
            height: 44px;
            width: 44px;
        }

        .cg-content-event-count-anchor {
            display: inline-flex;
            flex: 0 0 auto;
            position: relative;
        }

        .cg-content-thumb-wrap {
            align-items: center;
            display: inline-flex;
            flex-shrink: 0;
            height: 52px;
            justify-content: center;
            width: 68px;
        }

        .cg-content-thumb {
            background: #f8fbfb;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            display: block;
            height: 52px;
            object-fit: cover;
            width: 68px;
        }

        .cg-truncate-2 {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
        }

        .cg-empty {
            background: #f8fbfb;
            border-top: 1px dashed var(--cg-border);
            min-height: 96px;
        }

        .cg-table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .cg-data-table {
            min-width: 820px;
        }

        .cg-info-grid {
            display: grid;
            gap: 14px;
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .cg-info-cell {
            background: #f8fbfb;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            min-height: 88px;
            padding: 16px;
        }

        /* Match the fixed dialog contract used by Subject Details.  Every
           Class Group Details modal keeps the geometry it had when opened;
           only the body may scroll, so form changes and Select2 never move
           the dialog or change its size. */
        .modal.gape-class-group-modal-root {
            overflow: hidden;
        }

        .gape-class-group-modal-root .gape-class-group-select2-modal-portal {
            inset: 0;
            overflow: visible;
            pointer-events: none;
            position: fixed;
            z-index: 1;
        }

        .gape-class-group-modal-root .gape-class-group-select2-modal-portal > .select2-container {
            pointer-events: auto;
        }

        .gape-class-group-modal-root .gape-select-field {
            padding-bottom: 24px;
        }

        .gape-class-group-modal-root .gape-select-field .select2-container > .dropdown-wrapper {
            display: none;
        }

        .modal-dialog.gape-class-group-modal-dialog {
            max-height: calc(100vh - 2rem);
        }

        .modal-dialog.gape-class-group-modal-dialog .modal-content {
            display: flex;
            flex-direction: column;
            height: var(--gape-class-group-modal-open-height, auto);
            max-height: calc(100vh - 2rem);
        }

        .modal-dialog.gape-class-group-modal-dialog .modal-content > form {
            display: flex;
            flex: 1 1 auto;
            flex-direction: column;
            min-height: 0;
            overflow: hidden;
        }

        .modal-dialog.gape-class-group-modal-dialog .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-x: hidden;
            overflow-y: auto;
            scrollbar-gutter: stable;
        }

        .modal-dialog.gape-class-group-modal-dialog .modal-footer,
        .modal-dialog.gape-class-group-modal-dialog .modal-header {
            flex: 0 0 auto;
        }

        .cg-activity-modal .modal-dialog {
            max-width: 1180px;
            width: min(1180px, calc(100vw - 32px));
        }

        .cg-activity-modal .modal-content {
            height: min(860px, calc(100vh - 32px));
        }

        .cg-activity-modal .modal-dialog.gape-class-group-modal-dialog .modal-content {
            height: min(860px, calc(100vh - 32px));
        }

        .cg-grade-sheet-modal {
            width: min(1180px, calc(100vw - 32px));
            max-width: 1180px;
        }

        .modal-dialog.cg-grade-sheet-modal.gape-class-group-modal-dialog .modal-content {
            height: min(860px, calc(100vh - 32px));
        }

        /* The class-group document uses the same formal grade-sheet layout as
           Subject Details.  Keeping this styling here is important because
           the grade sheet is loaded lazily as an independent fragment. */
        .aac-grade-doc {
            background: #fff;
            color: #000;
            font-family: Arial, sans-serif;
            max-width: 100%;
            min-width: 0;
            overflow: hidden;
            padding: 0;
            width: 100%;
        }

        .cd-grade-sheet-doc {
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            padding: 16px;
        }

        .aac-grade-doc__head {
            border: 1px solid #000;
            display: grid;
            gap: 0 18px;
            grid-template-areas:
                "posted institution institution"
                "blank institution institution"
                "entity title period";
            grid-template-columns: 310px minmax(330px, 1fr) 300px;
            margin-bottom: 12px;
            min-height: 184px;
            padding: 12px;
            position: relative;
        }

        .aac-grade-doc__posted {
            align-self: start;
            font-size: 18px;
            font-weight: 700;
            grid-area: posted;
            line-height: 1.2;
            text-align: left;
            white-space: nowrap;
        }

        .aac-grade-doc__institution {
            align-items: flex-start;
            display: flex;
            grid-area: institution;
            justify-content: flex-start;
            min-width: 0;
        }

        .aac-grade-doc__media {
            align-items: flex-start;
            display: flex;
            flex: 0 0 150px;
            justify-content: center;
            min-width: 0;
        }

        .aac-grade-doc__image,
        .aac-grade-doc__placeholder {
            border-radius: 8px;
            height: 58px;
            width: 58px;
        }

        .aac-grade-doc__image {
            display: block;
            object-fit: cover;
        }

        .aac-grade-doc__placeholder {
            align-items: center;
            background: #eef2f7;
            border: 1px solid #d8e0ea;
            color: #1f3b57;
            display: inline-flex;
            flex-shrink: 0;
            font-size: 24px;
            justify-content: center;
        }

        .aac-grade-doc__brand {
            align-self: start;
            border-left: 2px solid #000;
            display: block;
            flex: 1 1 auto;
            font-size: 11px;
            font-weight: 400;
            line-height: 1.25;
            min-height: 72px;
            overflow: hidden;
            overflow-wrap: anywhere;
            padding-left: 20px;
            text-align: left;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .aac-grade-doc__brand strong {
            display: inline;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .aac-grade-doc__brand strong::after {
            content: " | ";
            font-weight: 400;
        }

        .aac-grade-doc__brand span {
            display: inline;
        }

        .aac-grade-doc .gape-acronym-token {
            border-bottom: 0 !important;
            color: inherit !important;
            cursor: default !important;
            display: inline-block;
            max-width: 100%;
            overflow: hidden;
            padding: 0 !important;
            text-decoration: none !important;
            text-overflow: ellipsis;
            vertical-align: bottom;
            white-space: nowrap;
        }

        .aac-grade-doc__entity {
            align-self: end;
            border-bottom: 1px solid #000;
            font-size: 16px;
            grid-area: entity;
            line-height: 1.25;
            padding-bottom: 5px;
            text-align: left;
            white-space: nowrap;
        }

        .aac-grade-doc__head h3 {
            align-self: end;
            color: #000;
            font-size: 30px;
            font-weight: 800;
            grid-area: title;
            line-height: 1.1;
            margin: 0;
            text-align: center;
        }

        .aac-grade-doc__period {
            align-self: end;
            font-size: 16px;
            font-weight: 700;
            grid-area: period;
            line-height: 1.25;
            text-align: right;
        }

        .aac-grade-doc__table-wrap {
            max-width: 100%;
            min-width: 0;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 8px;
            scrollbar-color: #94a3b8 #eef2f7;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
        }

        .aac-grade-doc__table-wrap::-webkit-scrollbar {
            display: block;
            height: 8px;
        }

        .aac-grade-doc__table-wrap::-webkit-scrollbar-track {
            background: #eef2f7;
            border-radius: 999px;
        }

        .aac-grade-doc__table-wrap::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 999px;
        }

        .aac-grade-doc__table {
            border-collapse: collapse;
            margin: 0;
            min-width: var(--aac-grade-doc-min-width, 720px);
            table-layout: fixed;
            width: max(100%, var(--aac-grade-doc-min-width, 720px));
        }

        .aac-grade-doc__number-col {
            width: 70px;
        }

        .aac-grade-doc__name-col {
            width: 300px;
        }

        .aac-grade-doc__assessment-col {
            width: 118px;
        }

        .aac-grade-doc__final-col {
            width: 116px;
        }

        .aac-grade-doc__table th,
        .aac-grade-doc__table td {
            border: 1px solid #000;
            color: #000;
            font-size: 15px;
            line-height: 1.25;
            overflow: hidden;
            overflow-wrap: anywhere;
            padding: 7px 8px;
            text-align: center;
            text-overflow: ellipsis;
            vertical-align: middle;
            white-space: nowrap;
        }

        .aac-grade-doc__table th:nth-child(2),
        .aac-grade-doc__table td:nth-child(2) {
            min-width: 300px;
            text-align: left;
            white-space: normal;
        }

        .aac-grade-doc__table th {
            background: #fff;
            font-size: 15px;
            font-weight: 700;
            white-space: normal;
        }

        .aac-grade-doc__table th .gape-acronym-token {
            display: block;
            overflow-wrap: anywhere;
            text-overflow: clip;
            white-space: normal;
        }

        .aac-grade-doc__grade,
        .aac-grade-doc__final {
            font-weight: 700;
            white-space: nowrap;
        }

        .aac-grade-doc__alert {
            color: #6b4e00;
            font-size: 13px;
            margin-top: 10px;
        }

        .aac-grade-doc__footer {
            display: flex;
            justify-content: flex-end;
            margin-top: 34px;
            min-height: 84px;
        }

        .aac-grade-doc__footer > div:not(.aac-grade-doc__signature) {
            display: none;
        }

        .aac-grade-doc__signature {
            font-size: 18px;
            text-align: center;
            width: 300px;
        }

        .aac-grade-doc__signature em {
            border-bottom: 2px solid #000;
            display: block;
            height: 34px;
            margin-top: 10px;
            width: 100%;
        }

        .cg-activity-modal .modal-header,
        .cg-activity-modal .modal-footer {
            flex: 0 0 auto;
        }

        .cg-activity-modal .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        .cg-activity-modal [data-content-upload-form] {
            display: flex;
            flex: 1 1 auto;
            flex-direction: column;
            min-height: 0;
        }

        .cg-activity-shell {
            display: grid;
            flex: 1 1 auto;
            grid-template-columns: 240px minmax(0, 1fr);
            height: auto;
            min-height: 0;
        }

        .cg-activity-side {
            border-right: 1px solid var(--cg-border);
            min-height: 0;
            overflow-y: auto;
            padding: 16px;
        }

        .cg-activity-main {
            min-height: 0;
            overflow-y: auto;
            padding: 18px;
        }

        .cg-content-picker-panel {
            border-bottom: 1px solid var(--cg-border);
            margin: 0 -18px 18px;
            padding: 0 18px 18px;
        }

        .cg-content-details-panel {
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            padding: 16px;
        }

        .cg-content-section-label {
            align-items: center;
            color: var(--cg-muted);
            display: flex;
            font-size: 12px;
            font-weight: 700;
            gap: 10px;
            letter-spacing: 0;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .cg-content-section-label::after {
            background: var(--cg-border);
            content: "";
            flex: 1 1 auto;
            height: 1px;
        }

        .cg-activity-category,
        .cg-activity-option {
            background: transparent;
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--cg-ink);
            cursor: pointer;
            display: flex;
            text-align: left;
            width: 100%;
        }

        .cg-activity-category {
            align-items: center;
            font-weight: 600;
            gap: 10px;
            min-height: 42px;
            padding: 10px 12px;
        }

        .cg-activity-category.is-active,
        .cg-activity-category:hover {
            background: rgba(0, 169, 145, 0.09);
            color: var(--cg-primary-dark);
        }

        .cg-activity-option {
            align-items: flex-start;
            gap: 14px;
            padding: 12px;
        }

        .cg-activity-option > span:last-child {
            min-width: 0;
        }

        .cg-activity-option > span:last-child > span.text-13 {
            display: block;
            line-height: 1.35;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cg-activity-option:hover,
        .cg-activity-option.is-selected {
            background: #f8fbfb;
            border-color: rgba(0, 169, 145, 0.26);
        }

        .cg-activity-option.is-planned {
            opacity: 0.62;
        }

        .cg-activity-icon {
            color: #fff;
            font-size: 24px;
            height: 48px;
            width: 48px;
        }

        .cg-activity-options {
            display: grid;
            align-content: start;
            gap: 10px;
            max-height: 420px;
            overflow-y: auto;
            padding-right: 6px;
        }

        .cg-assessment-option {
            background: #fff;
            border-color: var(--cg-border);
            gap: 12px;
            min-height: 0;
            padding: 10px 12px;
        }

        .cg-assessment-option .cg-activity-icon {
            font-size: 22px;
            height: 42px;
            width: 42px;
        }

        .cg-assessment-option > span:last-child > span.text-13 {
            line-height: 1.35;
            overflow: visible;
            white-space: normal;
        }

        .cg-content-details-panel.is-assessment-mode {
            background: transparent;
            border: 0;
            padding: 0;
        }

        .cg-assessment-create-form {
            background: #fff;
            border: 1px solid rgba(36, 45, 58, 0.08);
            border-radius: 8px;
            padding: 14px;
        }

        .cg-repository-group,
        .cg-repository-empty {
            grid-column: 1 / -1;
        }

        .cg-repository-list {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cg-repository-item {
            align-items: stretch;
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            display: flex;
            overflow: hidden;
            transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        }

        .cg-repository-item.is-selected {
            background: rgba(0, 169, 145, 0.12);
            border-color: rgba(0, 169, 145, 0.55);
            box-shadow: inset 4px 0 0 var(--cg-primary);
        }

        .cg-repository-item.is-selected .cg-activity-option {
            background: transparent;
        }

        .cg-repository-item .cg-activity-option {
            border: 0;
            border-radius: 0;
            flex: 1 1 auto;
            min-width: 0;
        }

        .cg-repository-preview {
            align-items: center;
            border-left: 1px solid var(--cg-border);
            color: var(--cg-primary-dark);
            display: flex;
            flex: 0 0 52px;
            font-size: 20px;
            justify-content: center;
            width: 52px;
        }

        .cg-repository-item.is-selected .cg-repository-preview {
            background: rgba(0, 169, 145, 0.08);
            border-left-color: rgba(0, 169, 145, 0.35);
        }

        .cg-repository-preview:hover {
            background: rgba(0, 169, 145, 0.08);
            color: var(--cg-primary-dark);
        }

        .cg-selected-repository-file {
            background: #fff;
            border: 1px solid rgba(0, 169, 145, 0.28);
            border-left: 4px solid var(--cg-primary);
            border-radius: 8px;
            margin-top: 14px;
            padding: 12px;
        }

        /* Shared Subject Details panel composition, recoloured through the
           Class Group green palette. */
        .cg-detail-panel {
            background: transparent;
            border: 0;
            border-radius: 0;
            padding: 0;
        }

        .cg-detail-panel-content {
            padding: 0 !important;
        }

        .cg-detail-panel-header {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .cg-detail-panel-heading { min-width: 0; }

        .cg-detail-panel-actions {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .cg-sort-toggle {
            align-items: center;
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 12px;
            color: #334155;
            display: inline-flex;
            font-weight: 600;
            gap: 8px;
            padding: 12px 20px;
            transition: background-color .2s ease, border-color .2s ease, color .2s ease;
        }

        .cg-sort-toggle:hover,
        .cg-sort-toggle.is-active {
            background: var(--cg-primary-soft);
            border-color: rgba(var(--cg-primary-rgb), .34);
            color: var(--cg-primary-dark);
        }

        .cg-structure-list-header,
        .cg-structure-row {
            align-items: center;
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(280px, 1.7fr) minmax(120px, .55fr) minmax(120px, .55fr) minmax(120px, .55fr) minmax(150px, auto);
        }

        .cg-structure-list-header {
            color: #475569;
            font-size: 13px;
            font-weight: 600;
            padding: 0 16px 12px;
        }

        .cg-assignment-list-header,
        .cg-assignment-row {
            grid-template-columns: minmax(250px, 1.25fr) minmax(220px, 1.05fr) minmax(135px, .55fr) minmax(92px, auto);
        }

        .cg-structure-node {
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .cg-structure-node:hover {
            border-color: rgba(var(--cg-primary-rgb), .28) !important;
            box-shadow: 0 10px 26px rgba(15, 23, 42, .05);
        }

        .cg-element-count {
            color: var(--cg-ink);
            font-size: 13px;
            font-weight: 500;
        }

        .cg-node-meta {
            color: #64748b;
            display: block;
            line-height: 1.35;
        }

        .cg-detail-action {
            background: transparent;
            border: 0;
            color: #64748b;
            font-size: 20px;
            line-height: 1;
            padding: 0;
        }

        .cg-detail-action:hover { color: var(--cg-primary-dark); }
        .cg-detail-action--danger:hover { color: #dc2626; }

        .cg-enrollment-tabs {
            border-bottom: 1px solid var(--cg-border);
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-bottom: 20px;
            padding-bottom: 12px;
        }

        .cg-enrollment-tab {
            align-items: center;
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            color: var(--cg-ink);
            display: flex;
            font-size: 14px;
            font-weight: 600;
            gap: 10px;
            justify-content: center;
            min-height: 46px;
            padding: 10px 14px;
            transition: background-color .2s ease, border-color .2s ease, color .2s ease;
        }

        .cg-enrollment-tab:hover,
        .cg-enrollment-tab.is-active {
            background: var(--cg-primary-soft);
            border-color: rgba(var(--cg-primary-rgb), .55);
            color: var(--cg-primary-dark);
        }

        .cg-enrollment-tab-panel[hidden] { display: none !important; }

        .cg-critical-grid {
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cg-critical-card {
            background: #fff;
            border: 1px solid var(--cg-border);
            border-radius: 8px;
            padding: 20px;
        }

        .cg-critical-card--archive { border-color: #fed7aa; }
        .cg-critical-card--delete { border-color: #fecaca; }

        .cg-critical-icon {
            align-items: center;
            border-radius: 8px;
            display: inline-flex;
            height: 44px;
            justify-content: center;
            width: 44px;
        }

        .cg-critical-icon--archive { background: #fff7ed; color: #c2410c; }
        .cg-critical-icon--delete { background: #fef2f2; color: #dc2626; }

        .dashbord-body {
            min-width: 0;
        }

        @media (max-width: 1199.98px) {
            .cg-info-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (min-width: 992px) {
            .cg-activity-options {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                max-height: none;
                overflow: visible;
                padding-right: 0;
            }
        }

        @media (max-width: 991.98px) {
            .cg-mode-grid,
            .cg-activity-shell {
                grid-template-columns: 1fr;
            }

            .cg-activity-side {
                border-bottom: 1px solid var(--cg-border);
                border-right: 0;
            }

            .cg-repository-list {
                grid-template-columns: 1fr;
            }

            .cg-structure-list-header { display: none; }
            .cg-structure-row,
            .cg-assignment-row { grid-template-columns: 1fr; }
        }

        @media (max-width: 767.98px) {
            .cg-content-row,
            .cg-info-grid {
                grid-template-columns: 1fr;
            }

            .cg-content-row .text-end {
                text-align: left !important;
            }

            .cg-critical-grid,
            .cg-enrollment-tabs { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="preloader">
    <img src="${pageContext.request.contextPath}/assets/images/icons/preloader.gif" alt="">
</div>
<div class="overlay"></div>
<div class="side-overlay"></div>
<div class="dashbord bg-main-25 w-100 overflow-hidden">
    <div class="d-flex">
        <%@ include file="/WEB-INF/fragments/dashboard-sidebar.jspf" %>
        <div class="dashbord-body flex-grow-1 d-flex flex-column min-vh-100">
            <%@ include file="/WEB-INF/fragments/dashboard-topbar.jspf" %>
            <div id="classGroupDetailLiveRoot" class="cg-shell ${classGroup.completed ? 'cg-shell--completed' : ''} px-24 py-24 flex-grow-1" data-class-group-detail-live-root>
                <%@ include file="/WEB-INF/fragments/flash-messages.jspf" %>

                <section class="cg-surface cg-hero px-24 py-24 mb-20">
                    <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap">
                        <div class="d-flex align-items-center gap-16 min-w-0">
                            <span class="gape-photo-placeholder gape-photo-placeholder--image gape-photo-placeholder--learning-detail" aria-label="Class group">
                                <i class="ph ph-users-three"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="d-flex align-items-center gap-10 flex-wrap mb-10">
                                    <span class="${classGroup.stateBadgeClass} px-14 py-7 border-neutral-30 border rounded-pill text-13">
                                        <c:out value="${classGroup.stateLabel}"/>
                                    </span>
                                    <span class="cg-soft-badge px-14 py-7 rounded-pill text-13">
                                        <i class="ph ph-clock me-6"></i><c:out value="${classGroup.shift}"/>
                                    </span>
                                </div>
                                <h2 class="text-28 fw-semibold text-neutral-800 mb-8"><c:out value="${classGroup.code}"/></h2>
                                <span class="text-14 text-neutral-500" title="<c:out value='${classGroup.contextTitle}'/>">
                                    <c:out value="${classGroup.contextHtml}" escapeXml="false"/>
                                </span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-10 flex-wrap">
                            <a href="${classGroupBackHref}" class="cg-outline-button">
                                <i class="ph ph-arrow-left me-8"></i>Back
                            </a>
                            <button type="button" class="cg-outline-button" data-bs-toggle="modal" data-bs-target="#classGroupSetupModal">
                                <i class="ph ph-sliders-horizontal me-8"></i>Setup
                            </button>
                            <c:if test="${canManageClassGroup}">
                                <a href="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/edit?returnTo=${currentReturnToParam}" class="cg-outline-button">
                                    <i class="ph ph-pencil-simple-line me-8"></i>Edit
                                </a>
                            </c:if>
                        </div>
                    </div>
                </section>

                <c:if test="${not empty classGroupAssessmentWeightWarning}">
                    <div class="bg-warning-50 text-warning-600 border border-warning-100 rounded-8 px-18 py-14 mb-20 text-14 d-flex align-items-start gap-10">
                        <i class="ph ph-warning-circle text-20 flex-shrink-0"></i>
                        <span><c:out value="${classGroupAssessmentWeightWarning}"/></span>
                    </div>
                </c:if>

                <div class="cg-mode-grid mb-20" role="tablist" aria-label="Class group detail views">
                    <button type="button" class="cg-mode-card cg-mode-card--structure" data-cg-tab="structure" aria-selected="false">
                        <c:if test="${classGroupDetailPendingCorrectionCount > 0}"><span class="cg-pending-corner-badge" data-class-group-learning-plan-pending-badge title="${classGroupDetailPendingCorrectionCount} pending correction(s)"><c:out value="${classGroupDetailPendingCorrectionCount}"/></span></c:if>
                        <span class="cg-mode-icon cg-structure-mode-icon text-24 mb-14"><i class="ph ph-stack"></i></span>
                        <span class="text-20 fw-semibold text-neutral-800 d-block mb-12 cg-mode-card__title">Learning Plan</span>
                        <span class="text-13 cg-structure-count fw-semibold"><c:out value="${classGroup.blockCount}"/> blocks</span>
                    </button>
                    <button type="button" class="cg-mode-card" data-cg-tab="info" aria-selected="false">
                        <c:if test="${classGroupDetailPendingEnrollmentCount > 0}"><span class="cg-pending-corner-badge" data-class-group-enrollment-card-pending-badge><c:out value="${classGroupDetailPendingEnrollmentCount}"/></span></c:if>
                        <span class="cg-mode-icon bg-success-50 text-success-600 text-24 mb-14"><i class="ph ph-users-three"></i></span>
                        <span class="text-20 fw-semibold text-neutral-800 d-block mb-12 cg-mode-card__title">Enrollments</span>
                        <span class="d-flex align-items-center gap-8 flex-wrap"><span class="text-13 cg-count-text fw-semibold"><c:out value="${classGroup.activeEnrollmentCountLabel}"/></span></span>
                    </button>
                    <button type="button" class="cg-mode-card" data-cg-tab="teachers" aria-selected="false">
                        <span class="cg-mode-icon bg-info-50 text-info-600 text-24 mb-14"><i class="ph ph-chalkboard-teacher"></i></span>
                        <span class="text-20 fw-semibold text-neutral-800 d-block mb-12 cg-mode-card__title">Teachers</span>
                        <span class="text-13 cg-count-text fw-semibold"><c:out value="${classGroup.teacherCountLabel}"/></span>
                    </button>
                    <button type="button" class="cg-mode-card" data-cg-tab="grade-sheet" aria-selected="false">
                        <span class="cg-mode-icon bg-warning-50 text-warning-600 text-24 mb-14"><i class="ph ph-seal-check"></i></span>
                        <span class="text-20 fw-semibold text-neutral-800 d-block mb-12 cg-mode-card__title">Grade sheet</span>
                        <span class="text-13 cg-count-text fw-semibold">On demand</span>
                    </button>
                </div>

                <main class="min-w-0">
                    <div class="cg-tab-panel" data-cg-panel="structure" hidden>
                        <div data-cg-lazy-panel="structure"
                             data-cg-lazy-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/structure"
                             aria-busy="false"<c:if test="${classGroupDetailStructureLoaded}"> data-cg-lazy-loaded="true"</c:if>>
                            <c:choose>
                                <c:when test="${classGroupDetailStructureLoaded}">
                        <section id="pedagogical-blocks" class="cg-surface cg-structure-theme mb-20">
                            <div class="px-22 py-22 d-flex align-items-start justify-content-between gap-16 flex-wrap">
                                <div>
                                    <h3 class="text-20 fw-semibold text-neutral-800 mb-6">Structure</h3>
                                    <span class="text-14 text-neutral-500">Blocks, learning resources and assessments in their class order.</span>
                                </div>
                                <div class="d-flex align-items-center gap-10 flex-wrap">
                                    <span class="cg-structure-badge px-14 py-8 rounded-pill text-13">
                                        <i class="ph ph-files me-6"></i><c:out value="${blockContentCount}"/> contents
                                    </span>
                                    <span class="bg-warning-50 text-warning-600 px-14 py-8 rounded-pill text-13">
                                        <i class="ph ph-seal-question me-6"></i><c:out value="${assessmentCount}"/> assessments
                                    </span>
                                    <c:choose>
                                        <c:when test="${blockContentLoadSuccess}">
                                            <span class="bg-success-50 text-success-600 px-14 py-8 rounded-pill text-13">
                                                <i class="ph ph-check-circle me-6"></i>Loaded
                                            </span>
                                        </c:when>
                                        <c:otherwise>
                                            <span class="bg-warning-30 text-warning-600 px-14 py-8 rounded-pill text-13">
                                                <i class="ph ph-warning-circle me-6"></i>Content error
                                            </span>
                                        </c:otherwise>
                                    </c:choose>
                                    <c:if test="${canManageClassGroupStructure}">
                                        <button type="button" class="cg-primary-button" data-bs-toggle="modal" data-bs-target="#createPedagogicalBlock">
                                            <i class="ph ph-plus-circle me-8"></i>New Block
                                        </button>
                                    </c:if>
                                </div>
                            </div>

                            <div class="d-flex flex-column gap-16 px-18 pb-18" data-class-group-structure data-block-reorder-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/reorder" data-content-reorder-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/contents/reorder" data-csrf-token="${sessionScope['gape.auth.csrfToken']}">
                                <c:forEach var="block" items="${contentBlocks}" varStatus="blockLoop">
                                    <c:set var="displayBlockNumber" value="${blockLoop.count}"/>
                                    <article id="block-${block.id}" class="cg-surface cg-block${block.inactive ? ' is-inactive' : ''}" data-block-card data-block-id="${block.id}" draggable="${canManageClassGroupStructure}">
                                        <div class="cg-block-header">
                                            <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap">
                                                <div class="d-flex align-items-start gap-16 min-w-0">
                                                    <c:if test="${canManageClassGroupStructure}">
                                                        <button type="button" class="cg-icon-button cg-drag-handle" data-block-drag-handle draggable="true" title="Move block" aria-label="Move block">
                                                            <i class="ph ph-dots-six-vertical text-20"></i>
                                                        </button>
                                                    </c:if>
                                                    <div class="cg-block-number" data-block-number>
                                                        <c:choose>
                                                            <c:when test="${displayBlockNumber lt 10}">0<c:out value="${displayBlockNumber}"/></c:when>
                                                            <c:otherwise><c:out value="${displayBlockNumber}"/></c:otherwise>
                                                        </c:choose>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <div class="d-flex align-items-center gap-8 flex-wrap mb-6">
                                                            <h4 class="text-18 fw-semibold text-neutral-800 mb-0"><c:out value="${block.name}"/></h4>
                                                            <span class="${block.stateBadgeClass} px-10 py-5 rounded-pill text-12"><c:out value="${block.stateLabel}"/></span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <c:if test="${canManageClassGroupContent}">
                                                    <div class="d-flex align-items-center gap-8 flex-wrap">
                                                        <button type="button" class="cg-icon-button" title="Edit block" data-bs-toggle="modal" data-bs-target="#editPedagogicalBlock${block.id}">
                                                            <i class="ph ph-pencil-simple-line text-20"></i>
                                                        </button>
                                                        <button type="button" class="cg-icon-button" title="Delete block" data-bs-toggle="modal" data-bs-target="#deleteBlock${block.id}">
                                                            <i class="ph ph-trash text-20"></i>
                                                        </button>
                                                    </div>
                                                </c:if>
                                            </div>
                                        </div>

                                        <c:set var="blockActivities" value="${blockActivitiesByBlock[block.id]}"/>
                                        <div class="cg-content-list" data-content-list data-target-block-id="${block.id}">
                                            <c:choose>
                                                <c:when test="${not empty blockContentLoadError}">
                                                    <div class="cg-empty d-flex align-items-center justify-content-center px-18 py-18 text-warning-600 text-14">
                                                        <i class="ph ph-warning-circle me-8"></i><c:out value="${blockContentLoadError}"/>
                                                    </div>
                                                </c:when>
                                                <c:when test="${empty blockActivities}">
                                                    <div class="cg-empty d-flex align-items-center justify-content-center px-18 py-18 text-neutral-500 text-14">
                                                        <i class="ph ph-folder-open me-8 text-20"></i>No contents, lessons or assessments registered for this block.
                                                    </div>
                                                </c:when>
                                                <c:otherwise>
                                                    <c:forEach var="activity" items="${blockActivities}">
                                                        <c:choose>
                                                            <c:when test="${activity.contentActivity}">
                                                                <c:set var="content" value="${activity.content}"/>
                                                                <c:url var="contentThumbnailUrl" value="/contents/download/${content.id}">
                                                                    <c:param name="variant" value="thumbnail"/>
                                                                </c:url>
                                                                <c:url var="contentInlineUrl" value="/contents/download/${content.id}">
                                                                    <c:param name="disposition" value="inline"/>
                                                                </c:url>
                                                                <c:url var="contentDownloadUrl" value="/contents/download/${content.id}"/>
                                                                <div class="cg-content-row" data-content-row data-source-block-id="${block.id}" data-content-id="${content.id}" data-item-kind="content" data-item-id="${content.id}" draggable="${canManageClassGroupStructure}">
                                                                    <div class="d-flex align-items-start gap-14 min-w-0">
                                                                        <c:if test="${canManageClassGroupStructure}">
                                                                            <button type="button" class="cg-icon-button cg-drag-handle flex-shrink-0" data-content-drag-handle draggable="true" title="Move content" aria-label="Move content">
                                                                                <i class="ph ph-dots-six-vertical text-20"></i>
                                                                            </button>
                                                                        </c:if>
                                                                        <c:choose>
                                                                            <c:when test="${classGroup.showContentThumbnails and content.visualThumbnailAvailable}">
                                                                                <span class="cg-content-thumb-wrap" data-content-thumbnail>
                                                                                    <img src="${contentThumbnailUrl}" alt="" class="cg-content-thumb" loading="eager" onerror="this.dataset.thumbnailFailed='true';">
                                                                                </span>
                                                                                <span class="cg-content-icon ${content.formatBadgeClass} text-22 d-none" data-content-thumbnail-fallback>
                                                                                    <i class="${content.formatIconClass}"></i>
                                                                                </span>
                                                                            </c:when>
                                                                            <c:otherwise>
                                                                                <span class="cg-content-icon ${content.formatBadgeClass} text-22">
                                                                                    <i class="${content.formatIconClass}"></i>
                                                                                </span>
                                                                            </c:otherwise>
                                                                        </c:choose>
                                                                        <div class="min-w-0">
                                                                            <div class="d-flex align-items-center gap-8 flex-wrap mb-6">
                                                                                <h5 class="text-15 fw-semibold text-neutral-800 mb-0"><c:out value="${content.title}"/></h5>
                                                                                <span class="${content.stateBadgeClass} px-10 py-5 rounded-pill text-12"><c:out value="${content.stateLabel}"/></span>
                                                                            </div>
                                                                            <p class="text-13 text-neutral-500 mb-0 cg-truncate-2"><c:out value="${content.description}"/></p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="d-flex align-items-center justify-content-end gap-8 flex-wrap">
                                                                        <c:choose>
                                                                            <c:when test="${content.assessmentReference}">
                                                                                <a href="${pageContext.request.contextPath}/learning/assessments/${content.assessmentReferenceId}" class="cg-outline-button text-13 px-12 py-8" title="Detail">
                                                                                    <i class="ph ph-eye"></i>
                                                                                </a>
                                                                                <a href="${pageContext.request.contextPath}/learning/assessments/${content.assessmentReferenceId}/edit" class="cg-icon-button" title="Edit">
                                                                                    <i class="ph ph-pencil-simple-line text-20"></i>
                                                                                </a>
                                                                                <a href="${pageContext.request.contextPath}/learning/assessments/${content.assessmentReferenceId}/pdf" class="cg-primary-button text-13 px-12 py-8" title="Download">
                                                                                    <i class="ph ph-download-simple"></i>
                                                                                </a>
                                                                            </c:when>
                                                                            <c:when test="${content.downloadable}">
                                                                                <a href="${contentInlineUrl}" target="_blank" rel="noopener noreferrer" class="cg-outline-button text-13 px-12 py-8" title="View">
                                                                                    <i class="ph ph-eye"></i>
                                                                                </a>
                                                                                <a href="${contentDownloadUrl}" class="cg-primary-button text-13 px-12 py-8" title="Download">
                                                                                    <i class="ph ph-download-simple"></i>
                                                                                </a>
                                                                            </c:when>
                                                                            <c:when test="${content.linkable}">
                                                                                <a href="${fn:escapeXml(content.source)}" target="_blank" rel="noopener noreferrer" class="cg-outline-button text-13 px-12 py-8" title="Open">
                                                                                    <i class="ph ph-arrow-square-out"></i>
                                                                                </a>
                                                                            </c:when>
                                                                            <c:otherwise>
                                                                                <span class="cg-outline-button text-13 px-12 py-8 text-neutral-400" title="Preview unavailable">
                                                                                    <i class="ph ph-eye-slash"></i>
                                                                                </span>
                                                                            </c:otherwise>
                                                                        </c:choose>
                                                                        <c:if test="${canManageClassGroupContent}">
                                                                            <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/${block.id}/contents/${content.id}/delete" method="post" class="m-0">
                                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                                <button type="submit" class="cg-icon-button" title="Delete content">
                                                                                    <i class="ph ph-x text-20"></i>
                                                                                </button>
                                                                            </form>
                                                                        </c:if>
                                                                    </div>
                                                                </div>
                                                            </c:when>
                                                            <c:when test="${activity.lessonActivity}">
                                                                <c:set var="lesson" value="${activity.lesson}"/>
                                                                <div class="cg-content-row" data-content-row data-source-block-id="${block.id}" data-item-kind="lesson" data-item-id="${lesson.id}" draggable="${canManageClassGroupStructure}">
                                                                    <div class="d-flex align-items-start gap-14 min-w-0">
                                                                        <c:if test="${canManageClassGroupStructure}">
                                                                            <button type="button" class="cg-icon-button cg-drag-handle flex-shrink-0" data-content-drag-handle draggable="true" title="Move lesson" aria-label="Move lesson">
                                                                                <i class="ph ph-dots-six-vertical text-20"></i>
                                                                            </button>
                                                                        </c:if>
                                                                        <span class="cg-content-icon ${lesson.typeBadgeClass} text-22">
                                                                            <i class="${lesson.typeIconClass}"></i>
                                                                        </span>
                                                                        <div class="min-w-0">
                                                                            <div class="d-flex align-items-center gap-8 flex-wrap mb-6">
                                                                                <h5 class="text-15 fw-semibold text-neutral-800 mb-0"><c:out value="${lesson.title}"/></h5>
                                                                                <span class="${lesson.stateBadgeClass} px-10 py-5 rounded-pill text-12"><c:out value="${lesson.stateLabel}"/></span>
                                                                            </div>
                                                                            <p class="text-13 text-neutral-500 mb-0" data-gape-datetime-display>
                                                                                <c:out value="${lesson.startsAt}"/> to <c:out value="${lesson.endsAt}"/> | <c:out value="${lesson.typeLabel}"/>
                                                                                <c:if test="${lesson.hasRoom}"> | Room <c:out value="${lesson.physicalRoomCode}"/></c:if>
                                                                                <c:if test="${lesson.hasMeetingLink}"> | Meeting link</c:if>
                                                                            </p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="d-flex align-items-center justify-content-end gap-8 flex-wrap">
                                                                        <a href="${pageContext.request.contextPath}/learning/lessons/${lesson.id}" class="cg-outline-button text-13 px-12 py-8" title="Detail Lesson" data-lesson-modal-url="${pageContext.request.contextPath}/learning/lessons/${lesson.id}" data-lesson-modal-title="Lesson Details">
                                                                            <i class="ph ph-eye"></i>
                                                                        </a>
                                                                        <c:if test="${canManageLessons}">
                                                                            <a href="${pageContext.request.contextPath}/learning/lessons/${lesson.id}/edit?returnTo=${currentReturnToParam}" class="cg-icon-button" title="Edit Lesson" data-lesson-modal-url="${pageContext.request.contextPath}/learning/lessons/${lesson.id}/edit?returnTo=${currentReturnToParam}" data-lesson-modal-title="Edit Lesson">
                                                                                <i class="ph ph-pencil-simple-line text-20"></i>
                                                                            </a>
                                                                            <form action="${pageContext.request.contextPath}/learning/lessons/${lesson.id}/delete" method="post" class="m-0">
                                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                                <button type="submit" class="cg-icon-button" title="Delete lesson">
                                                                                    <i class="ph ph-x text-20"></i>
                                                                                </button>
                                                                            </form>
                                                                        </c:if>
                                                                    </div>
                                                                </div>
                                                            </c:when>
                                                            <c:when test="${activity.assessmentActivity}">
                                                                <c:set var="assessmentItem" value="${activity.assessment}"/>
                                                                <c:set var="assessmentPendingEnrollmentCount" value="${classGroupAssessmentPendingEnrollmentCountById[assessmentItem.id]}"/>
                                                                <c:set var="assessmentPendingCorrectionCount" value="${classGroupAssessmentPendingCorrectionCountById[assessmentItem.id]}"/>
                                                                <c:set var="assessmentPendingEventCount" value="${assessmentPendingEnrollmentCount + assessmentPendingCorrectionCount}"/>
                                                                <div class="cg-content-row" data-content-row data-source-block-id="${block.id}" data-item-kind="assessment" data-item-id="${assessmentItem.id}" draggable="${canManageClassGroupStructure}">
                                                                    <div class="d-flex align-items-start gap-14 min-w-0">
                                                                        <c:if test="${canManageClassGroupStructure}">
                                                                            <button type="button" class="cg-icon-button cg-drag-handle flex-shrink-0" data-content-drag-handle draggable="true" title="Move assessment" aria-label="Move assessment">
                                                                                <i class="ph ph-dots-six-vertical text-20"></i>
                                                                            </button>
                                                                        </c:if>
                                                                        <span class="cg-content-event-count-anchor">
                                                                            <c:if test="${assessmentPendingEventCount > 0}"><span class="cg-pending-corner-badge" data-class-group-assessment-pending-badge title="${assessmentPendingEnrollmentCount} pending enrollment request(s) and ${assessmentPendingCorrectionCount} pending correction(s)"><c:out value="${assessmentPendingEventCount}"/></span></c:if>
                                                                            <span class="cg-content-icon ${assessmentItem.softClass} text-22">
                                                                                <i class="${assessmentItem.iconClass}"></i>
                                                                            </span>
                                                                        </span>
                                                                        <div class="min-w-0">
                                                                            <div class="d-flex align-items-center gap-8 flex-wrap mb-6">
                                                                                <h5 class="text-15 fw-semibold text-neutral-800 mb-0"><c:out value="${assessmentItem.title}"/></h5>
                                                                                <span class="${assessmentItem.stateBadgeClass} px-10 py-5 rounded-pill text-12"><c:out value="${assessmentItem.stateLabel}"/></span>
                                                                                <span class="bg-neutral-20 text-neutral-600 px-10 py-5 rounded-pill text-12"><c:out value="${assessmentItem.typeLabel}"/></span>
                                                                            </div>
                                                                            <p class="text-13 text-neutral-500 mb-0">
                                                                                <c:out value="${assessmentItem.questionCountLabel}"/> | <c:out value="${assessmentItem.attemptCountLabel}"/> | <c:out value="${assessmentItem.correctionModeLabel}"/> correction
                                                                            </p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="d-flex align-items-center justify-content-end gap-8 flex-wrap">
                                                                        <a href="${pageContext.request.contextPath}/learning/assessments/${assessmentItem.id}" class="cg-outline-button text-13 px-12 py-8" title="Detail">
                                                                            <i class="ph ph-eye"></i>
                                                                        </a>
                                                                        <c:if test="${canManageClassGroupContent}">
                                                                            <a href="${pageContext.request.contextPath}/learning/assessments/${assessmentItem.id}/edit" class="cg-icon-button" title="Edit">
                                                                                <i class="ph ph-pencil-simple-line text-20"></i>
                                                                            </a>
                                                                        </c:if>
                                                                        <a href="${pageContext.request.contextPath}/learning/assessments/${assessmentItem.id}/pdf" class="cg-primary-button text-13 px-12 py-8" title="Download">
                                                                            <i class="ph ph-download-simple"></i>
                                                                        </a>
                                                                        <c:if test="${canManageClassGroupContent}">
                                                                            <form action="${pageContext.request.contextPath}/learning/assessments/${assessmentItem.id}/delete" method="post" class="m-0">
                                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                                <input type="hidden" name="returnTo" value="/learning/class-groups/${classGroup.id}#block-${block.id}">
                                                                                <button type="submit" class="cg-icon-button" title="Delete assessment">
                                                                                    <i class="ph ph-x text-20"></i>
                                                                                </button>
                                                                            </form>
                                                                        </c:if>
                                                                    </div>
                                                                </div>
                                                            </c:when>
                                                        </c:choose>
                                                    </c:forEach>
                                                </c:otherwise>
                                            </c:choose>
                                        </div>

                                        <c:if test="${canManageClassGroupContent}">
                                            <div class="cg-block-toolbar">
                                                <a href="${pageContext.request.contextPath}/learning/lessons/new?classGroupId=${classGroup.id}&contentBlockId=${block.id}"
                                                   class="cg-outline-button"
                                                   data-lesson-modal-url="${pageContext.request.contextPath}/learning/lessons/new?classGroupId=${classGroup.id}&contentBlockId=${block.id}"
                                                   data-lesson-modal-title="Create Lesson">
                                                    <i class="ph ph-chalkboard-teacher me-8"></i>New Lesson
                                                </a>
                                                <button type="button" class="cg-primary-button" data-bs-toggle="modal" data-bs-target="#addContent${block.id}">
                                                    <i class="ph ph-plus-circle me-8"></i>Add Content
                                                </button>
                                            </div>
                                        </c:if>

                                    </article>

                                    <c:if test="${canManageClassGroupContent}">
                                        <div class="modal fade cg-activity-modal" id="addContent${block.id}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-xl">
                                                <div class="modal-content rounded-8 border-0">
                                                    <div class="modal-header border-neutral-30">
                                                        <div>
                                                            <h5 class="modal-title text-18 fw-semibold">Add Content</h5>
                                                            <span class="text-13 text-neutral-500">Choose an activity type supported by the current GAPE content architecture.</span>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form id="contentUploadForm${block.id}" action="${pageContext.request.contextPath}/contents/upload" method="post" enctype="multipart/form-data" data-content-upload-form data-content-upload-action="${pageContext.request.contextPath}/contents/upload" data-lesson-action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/${block.id}/lessons" data-assessment-action="${pageContext.request.contextPath}/learning/assessments" data-assessment-return-anchor="block-${block.id}" data-class-group-start="${classGroup.startsAt}" data-class-group-end="${classGroup.endsAt}">
                                                        <div class="cg-activity-shell">
                                                            <div class="cg-activity-side">
                                                                <input type="search" class="form-control px-16 py-10 text-14 bg-neutral-20 border-neutral-30 border rounded-8 mb-14" placeholder="Search activity" aria-label="Search activities" data-activity-search>
                                                                <div class="d-flex flex-column gap-4">
                                                                    <button type="button" class="cg-activity-category" data-content-category="repository"><i class="ph ph-folder-open"></i>Repository</button>
                                                                    <button type="button" class="cg-activity-category is-active" data-content-category="multimedia"><i class="ph ph-monitor-play"></i>Multimedia</button>
                                                                    <button type="button" class="cg-activity-category" data-content-category="class"><i class="ph ph-chalkboard-teacher"></i>Class</button>
                                                                    <button type="button" class="cg-activity-category" data-content-category="assessment"><i class="ph ph-eye"></i>Assessment</button>
                                                                </div>
                                                            </div>
                                                            <div class="cg-activity-main">
                                                                <div class="cg-content-picker-panel">
                                                                    <div class="cg-content-section-label">Choose content</div>
                                                                    <div class="cg-activity-options" data-activity-options>
                                                                    <button type="button" class="cg-activity-option is-selected" data-content-option data-category="multimedia" data-supported="true" data-format="pdf" data-role="support_material" data-source-kind="file" data-title="PDF" data-submit-label="Upload PDF" data-accept="application/pdf,.pdf">
                                                                        <span class="cg-activity-icon bg-danger-600"><i class="ph ph-file-pdf"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">PDF</strong><span class="text-13 text-neutral-500">PDF file.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="multimedia" data-supported="true" data-format="text" data-role="text" data-source-kind="file" data-title="Text" data-submit-label="Upload Text" data-accept="text/plain,.txt">
                                                                        <span class="cg-activity-icon bg-main-two-600"><i class="ph ph-text-aa"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Text</strong><span class="text-13 text-neutral-500">Text file.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="multimedia" data-supported="true" data-format="image" data-role="image" data-source-kind="file" data-title="Image" data-submit-label="Upload Image" data-accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.gif,.bmp">
                                                                        <span class="cg-activity-icon bg-success-600"><i class="ph ph-image"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Image</strong><span class="text-13 text-neutral-500">Image file.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="multimedia" data-supported="true" data-format="video" data-role="video" data-source-kind="file" data-title="Video" data-submit-label="Upload Video" data-accept="video/mp4,video/webm,video/quicktime,video/x-m4v,video/x-matroska,video/x-msvideo,video/mpeg,video/3gpp,.mp4,.webm,.mov,.m4v,.mkv,.avi,.mpeg,.mpg,.3gp,.3gpp">
                                                                        <span class="cg-activity-icon bg-main-600"><i class="ph ph-play-circle"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Video</strong><span class="text-13 text-neutral-500">Video file.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="multimedia" data-supported="true" data-format="audio" data-role="audio" data-source-kind="file" data-title="Audio" data-submit-label="Upload Audio" data-accept="audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/x-wav,audio/ogg,audio/flac,audio/aac,audio/webm,audio/opus,application/ogg,.mp3,.m4a,.wav,.ogg,.flac,.aac,.weba,.opus">
                                                                        <span class="cg-activity-icon bg-main-600"><i class="ph ph-speaker-high"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Audio</strong><span class="text-13 text-neutral-500">Audio file.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="multimedia" data-supported="true" data-format="url" data-role="video_link" data-source-kind="url" data-title="YouTube" data-submit-label="Create Link">
                                                                        <span class="cg-activity-icon bg-danger-600"><i class="ph ph-youtube-logo"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">YouTube</strong><span class="text-13 text-neutral-500">Video URL.</span></span>
                                                                    </button>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">PDF</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.format eq 'pdf'}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-preview-url="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse File">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">Text</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.format eq 'text'}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-preview-url="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse File">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">Image</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.format eq 'image'}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-preview-url="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse File">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">Video</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.format eq 'video'}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-preview-url="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse File">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">Audio</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.format eq 'audio'}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-preview-url="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse File">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/contents/download/${repositoryItem.id}?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <div class="cg-repository-empty text-center py-32 px-16 border border-neutral-30 rounded-8 bg-neutral-20" data-repository-empty data-category="repository" hidden>
                                                                        <span class="text-14 text-neutral-500">No reusable pedagogical items are available yet.</span>
                                                                    </div>
                                                                    <div class="cg-repository-group" data-repository-group data-category="repository" hidden>
                                                                        <div class="d-flex align-items-center justify-content-between gap-12 mb-8">
                                                                            <span class="text-13 fw-semibold text-neutral-600 text-uppercase">Assessments</span>
                                                                            <span class="h-1 bg-neutral-30 flex-grow-1"></span>
                                                                        </div>
                                                                        <div class="cg-repository-list">
                                                                            <c:forEach var="repositoryItem" items="${contentRepository}">
                                                                                <c:if test="${repositoryItem.assessmentReference}">
                                                                                    <div class="cg-repository-item" data-repository-item>
                                                                                        <button type="button" class="cg-activity-option" data-content-option data-category="repository" data-supported="true" data-format="${repositoryItem.format}" data-role="${repositoryItem.defaultRole}" data-source-kind="repository" data-content-id="${repositoryItem.id}" data-assessment-reference="true" data-preview-url="${pageContext.request.contextPath}/learning/assessments/${repositoryItem.assessmentReferenceId}/pdf?disposition=inline" data-original-title="${repositoryItem.rawTitleAttribute}" data-original-description="${repositoryItem.rawDescriptionAttribute}" data-original-mandatory="${repositoryItem.defaultMandatory}" data-submit-label="Reuse Assessment">
                                                                                            <span class="cg-activity-icon ${repositoryItem.formatBadgeClass}"><i class="${repositoryItem.formatIconClass}"></i></span>
                                                                                            <span><strong class="text-15 text-neutral-800 d-block mb-4"><c:out value="${repositoryItem.title}"/></strong><span class="text-13 text-neutral-500 cg-truncate-2"><c:out value="${repositoryItem.description}"/></span></span>
                                                                                        </button>
                                                                                        <a href="${pageContext.request.contextPath}/learning/assessments/${repositoryItem.assessmentReferenceId}/pdf?disposition=inline" target="_blank" rel="noopener noreferrer" class="cg-repository-preview" title="Preview" aria-label="Preview">
                                                                                            <i class="ph ph-eye"></i>
                                                                                        </a>
                                                                                    </div>
                                                                                </c:if>
                                                                            </c:forEach>
                                                                        </div>
                                                                    </div>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="class" data-supported="true" data-source-kind="lesson" data-lesson-type="online" data-title="Online" data-submit-label="Create Lesson">
                                                                        <span class="cg-activity-icon bg-success-600"><i class="ph ph-video-camera"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Online</strong><span class="text-13 text-neutral-500">Meeting link and schedule.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="class" data-supported="true" data-source-kind="lesson" data-lesson-type="onsite" data-title="In-Person" data-submit-label="Create Lesson">
                                                                        <span class="cg-activity-icon bg-main-two-600"><i class="ph ph-book-open"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">In-Person</strong><span class="text-13 text-neutral-500">Room, schedule and attendance.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option" data-content-option data-category="class" data-supported="true" data-source-kind="lesson" data-lesson-type="hybrid" data-title="Hybrid" data-submit-label="Create Lesson">
                                                                        <span class="cg-activity-icon bg-info-600"><i class="ph ph-broadcast"></i></span>
                                                                        <span><strong class="text-15 text-neutral-800 d-block mb-4">Hybrid</strong><span class="text-13 text-neutral-500">Meeting link and physical room.</span></span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option cg-assessment-option" data-content-option data-category="assessment" data-supported="true" data-format="other" data-role="assessment" data-source-kind="assessment-create" data-title="Online Assessment" data-submit-label="Create" data-assessment-type="form" data-assessment-mode="online" data-assessment-correction-mode="automatic" data-assessment-subject-id="${classGroup.subjectId}" data-assessment-content-block-id="${block.id}" data-assessment-summary="Reusable online assessment with setup, questions, enrollment policy and attempts." data-assessment-settings="Assessment | Online | Automatic correction">
                                                                        <span class="cg-activity-icon bg-info-600"><i class="ph ph-eye"></i></span>
                                                                        <span>
                                                                            <strong class="text-15 text-neutral-800 d-block mb-4">Online</strong>
                                                                            <span class="text-13 text-neutral-500">Form, test or exam completed online.</span>
                                                                        </span>
                                                                    </button>
                                                                    <button type="button" class="cg-activity-option cg-assessment-option" data-content-option data-category="assessment" data-supported="true" data-format="other" data-role="assessment" data-source-kind="assessment-create" data-title="In-Person Assessment" data-submit-label="Create" data-assessment-type="form" data-assessment-mode="onsite" data-assessment-correction-mode="manual" data-assessment-subject-id="${classGroup.subjectId}" data-assessment-content-block-id="${block.id}" data-assessment-summary="Reusable in-person assessment with setup, questions, enrollment policy and attempts." data-assessment-settings="Assessment | In-Person | Manual correction">
                                                                        <span class="cg-activity-icon bg-main-two-600"><i class="ph ph-eye"></i></span>
                                                                        <span>
                                                                            <strong class="text-15 text-neutral-800 d-block mb-4">In-Person</strong>
                                                                            <span class="text-13 text-neutral-500">Form, test or exam delivered in the classroom.</span>
                                                                        </span>
                                                                    </button>
                                                                    </div>
                                                                    <div class="cg-selected-repository-file d-none" data-selected-repository-file>
                                                                        <div class="d-flex align-items-start justify-content-between gap-12">
                                                                            <div class="d-flex align-items-start gap-12 min-w-0">
                                                                                <span class="cg-activity-icon bg-main-600 flex-shrink-0" data-selected-repository-icon><i class="ph ph-file"></i></span>
                                                                                <span class="min-w-0">
                                                                                    <strong class="text-15 text-neutral-800 d-block mb-4" data-selected-repository-title></strong>
                                                                                    <span class="text-13 text-neutral-500 cg-truncate-2" data-selected-repository-description></span>
                                                                                </span>
                                                                            </div>
                                                                            <a href="#" target="_blank" rel="noopener noreferrer" class="cg-outline-button text-18 px-12 py-8 flex-shrink-0" data-selected-repository-preview title="Preview" aria-label="Preview">
                                                                                <i class="ph ph-eye"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="cg-content-details-panel" data-content-details-panel>
                                                                <div class="cg-content-section-label" data-content-details-label>Item details</div>
                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                <input type="hidden" name="contextType" value="content_block">
                                                                <input type="hidden" name="contextId" value="${block.id}">
                                                                <input type="hidden" name="format" value="pdf" data-content-format>
                                                                <input type="hidden" name="role" value="support_material" data-content-role>
                                                                <input type="hidden" name="classGroupId" value="${classGroup.id}">
                                                                <input type="hidden" name="contentBlockId" value="${block.id}">
                                                                <input type="hidden" name="type" value="" data-lesson-type-input>
                                                                <input type="hidden" name="repositorySourceContentItemId" value="" data-repository-content-id>
                                                                <input type="hidden" name="repositoryMetadataMode" value="custom" data-repository-metadata-mode>
                                                                <div class="cg-assessment-create-form d-none" data-assessment-create-fields>
                                                                        <input type="hidden" value="${classGroup.subjectId}" data-assessment-field="subjectId" disabled>
                                                                        <input type="hidden" value="${block.id}" data-assessment-field="contentBlockId" disabled>
                                                                        <input type="hidden" value="online" data-assessment-field="mode" disabled>
                                                                        <div class="cg-content-section-label">Assessment Details</div>
                                                                        <div class="row gy-3">
                                                                            <div class="col-lg-8">
                                                                                <label for="assessmentTitle${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Title</label>
                                                                                <input id="assessmentTitle${block.id}" type="text" maxlength="160" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="title" disabled>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label class="fw-medium text-base text-neutral-800 mb-10 d-block">State</label>
                                                                                <span class="d-inline-flex align-items-center gap-8 px-14 py-11 bg-neutral-20 border border-neutral-30 rounded-8 text-14 fw-semibold text-neutral-700" data-assessment-state-display>Draft</span>
                                                                            </div>
                                                                            <div class="col-12">
                                                                                <label for="assessmentDescription${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Description</label>
                                                                                <textarea id="assessmentDescription${block.id}" rows="2" maxlength="500" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="description" disabled></textarea>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentCorrectionMode${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Correction</label>
                                                                                <select id="assessmentCorrectionMode${block.id}" required class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8" data-assessment-field="correctionMode" disabled>
                                                                                    <option value="automatic">Automatic</option>
                                                                                    <option value="mixed">Mixed</option>
                                                                                    <option value="manual">Manual</option>
                                                                                </select>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentMaxGrade${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Maximum Grade</label>
                                                                                <input id="assessmentMaxGrade${block.id}" type="number" step="0.01" min="0.01" required value="20.00" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="maxGrade" disabled>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentPassingGrade${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Passing Grade</label>
                                                                                <input id="assessmentPassingGrade${block.id}" type="number" step="0.01" min="0" required value="10.00" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="passingGrade" disabled>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentFinalGradeWeight${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Final Weight (%)</label>
                                                                                <input id="assessmentFinalGradeWeight${block.id}" type="number" step="0.01" min="0" max="100" required value="100.00" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="finalGradeWeight" disabled>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentAttemptsLimit${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Attempts Limit</label>
                                                                                <input id="assessmentAttemptsLimit${block.id}" type="number" min="1" placeholder="Unlimited" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="attemptsLimit" disabled>
                                                                            </div>
                                                                            <div class="col-lg-4">
                                                                                <label for="assessmentType${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Type</label>
                                                                                <select id="assessmentType${block.id}" required class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8" data-assessment-field="type" disabled>
                                                                                    <option value="exam">Exam</option>
                                                                                    <option value="test">Test</option>
                                                                                    <option value="form" selected>Form</option>
                                                                                </select>
                                                                            </div>
                                                                            <div class="col-lg-6 gape-context-date-field">
                                                                                <label for="assessmentAvailableFrom${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Available From</label>
                                                                                <div class="gape-context-date-control">
                                                                                    <i class="ph ph-calendar-dots"></i>
                                                                                    <input id="assessmentAvailableFrom${block.id}" type="datetime-local" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="availableFrom" disabled>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-lg-6 gape-context-date-field">
                                                                                <label for="assessmentAvailableUntil${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Available Until</label>
                                                                                <div class="gape-context-date-control">
                                                                                    <i class="ph ph-calendar-check"></i>
                                                                                    <input id="assessmentAvailableUntil${block.id}" type="datetime-local" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-assessment-field="availableUntil" disabled>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                <div class="row gy-3" data-content-details-fields>
                                                                    <div class="col-12 d-none" data-repository-metadata-wrapper>
                                                                        <label class="fw-medium text-base text-neutral-800 mb-10 d-block">Item details</label>
                                                                        <div class="d-flex flex-wrap gap-10">
                                                                            <label class="d-inline-flex align-items-center gap-8 px-14 py-10 border border-neutral-30 rounded-8 bg-neutral-20 text-14 text-neutral-700">
                                                                                <input type="radio" name="repositoryMetadataChoice" value="custom" checked data-repository-metadata-choice>
                                                                                Custom details
                                                                            </label>
                                                                            <label class="d-inline-flex align-items-center gap-8 px-14 py-10 border border-neutral-30 rounded-8 bg-neutral-20 text-14 text-neutral-700">
                                                                                <input type="radio" name="repositoryMetadataChoice" value="original" data-repository-metadata-choice>
                                                                                Use original details
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-8" data-title-wrapper>
                                                                        <label for="contentTitle${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Title</label>
                                                                        <input id="contentTitle${block.id}" name="title" type="text" maxlength="160" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                                                    </div>
                                                                    <div class="col-md-4" data-mandatory-wrapper>
                                                                        <label for="contentMandatory${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Mandatory</label>
                                                                        <select id="contentMandatory${block.id}" name="mandatory" class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8" data-mandatory-input>
                                                                            <option value="false">Optional</option>
                                                                            <option value="true">Mandatory</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12" data-description-wrapper>
                                                                        <label for="contentDescription${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Description</label>
                                                                        <textarea id="contentDescription${block.id}" name="description" rows="2" maxlength="500" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600"></textarea>
                                                                    </div>
                                                                    <div class="col-12" data-file-wrapper>
                                                                        <label for="contentFile${block.id}" class="fw-medium text-base text-neutral-800 mb-10" data-file-label>File</label>
                                                                        <input id="contentFile${block.id}" name="file" type="file" accept="application/pdf,.pdf" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                                                    </div>
                                                                    <div class="col-12 d-none" data-source-wrapper>
                                                                        <label for="contentSource${block.id}" class="fw-medium text-base text-neutral-800 mb-10" data-source-label>Source</label>
                                                                        <textarea id="contentSource${block.id}" name="source" rows="2" maxlength="1000" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-source-input></textarea>
                                                                    </div>
                                                                    <div class="col-md-4 d-none" data-lesson-schedule-wrapper>
                                                                        <label class="fw-medium text-base text-neutral-800 mb-10 d-block">State</label>
                                                                        <span class="d-inline-flex align-items-center gap-8 px-14 py-11 bg-neutral-20 border border-neutral-30 rounded-8 text-14 fw-semibold text-neutral-700" data-lesson-state-display>Draft</span>
                                                                    </div>
                                                                    <div class="col-md-4 d-none gape-context-date-field" data-lesson-schedule-wrapper>
                                                                        <label for="lessonStartsAt${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Starts At</label>
                                                                        <div class="gape-context-date-control">
                                                                            <i class="ph ph-calendar-dots"></i>
                                                                            <input id="lessonStartsAt${block.id}" name="startsAt" type="datetime-local" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-lesson-starts-at>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4 d-none gape-context-date-field" data-lesson-schedule-wrapper>
                                                                        <label for="lessonEndsAt${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Ends At</label>
                                                                        <div class="gape-context-date-control">
                                                                            <i class="ph ph-calendar-check"></i>
                                                                            <input id="lessonEndsAt${block.id}" name="endsAt" type="datetime-local" required class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" data-lesson-ends-at>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4 d-none" data-lesson-meeting-wrapper>
                                                                        <label for="lessonProvider${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Provider</label>
                                                                        <select id="lessonProvider${block.id}" name="provider" class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8" data-lesson-provider>
                                                                            <option value="">Select provider</option>
                                                                            <option value="Zoom">Zoom</option>
                                                                            <option value="Teams">Teams</option>
                                                                            <option value="Meet">Meet</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-8 d-none" data-lesson-meeting-wrapper>
                                                                        <label for="lessonAccessUrl${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Meeting Link</label>
                                                                        <input id="lessonAccessUrl${block.id}" name="accessUrl" type="url" maxlength="255" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600" placeholder="https://..." data-lesson-access-url>
                                                                    </div>
                                                                    <div class="col-md-8 d-none" data-lesson-room-wrapper>
                                                                        <label for="lessonPhysicalRoom${block.id}" class="fw-medium text-base text-neutral-800 mb-10" data-lesson-room-label>Physical Room</label>
                                                                        <select id="lessonPhysicalRoom${block.id}" name="physicalRoomCode" class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8" data-lesson-room>
                                                                            <option value="">No room</option>
                                                                            <c:forEach var="room" items="${physicalRoomOptions}">
                                                                                <option value="<c:out value='${room.code}'/>">
                                                                                    <c:out value="${room.code}"/> - <c:out value="${room.name}"/> &middot; <c:out value="${room.capacityLabel}"/>
                                                                                </option>
                                                                            </c:forEach>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-4 d-none" data-lesson-attendance-wrapper>
                                                                        <label class="fw-medium text-base text-neutral-800 mb-10 d-block">Attendance</label>
                                                                        <label class="d-flex align-items-center gap-10 px-14 py-11 border border-neutral-30 rounded-8 bg-neutral-20 text-14 text-neutral-700">
                                                                            <input type="checkbox" name="attendanceRequired" value="true" checked data-lesson-attendance>
                                                                            Required
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                                <p class="text-13 text-danger-600 mt-14 mb-0" data-upload-status aria-live="polite"></p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-neutral-30">
                                                            <button type="button" class="cg-outline-button" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="cg-primary-button cg-upload-button" form="contentUploadForm${block.id}" data-content-submit data-idle-label="Add Content">
                                                                <span class="cg-upload-button-progress" data-upload-button-progress></span>
                                                                <span data-upload-button-label>Add Content</span>
                                                                <span class="cg-upload-button-spinner" aria-hidden="true"><i class="ph ph-circle-notch"></i></span>
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal fade" id="editPedagogicalBlock${block.id}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-8 border-0">
                                                    <div class="modal-header border-neutral-30">
                                                        <div>
                                                            <h5 class="modal-title text-18 fw-semibold">Edit Pedagogical Block</h5>
                                                            <span class="text-13 text-neutral-500"><c:out value="${classGroup.code}"/> | <c:out value="${block.code}"/></span>
                                                        </div>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/${block.id}" method="post" data-class-group-live-form>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                            <input type="hidden" name="returnTo" value="/learning/class-groups/${classGroup.id}#block-${block.id}">
                                                            <input type="hidden" name="classGroupId" value="${classGroup.id}">
                                                            <input type="hidden" name="code" value="<c:out value='${block.code}'/>">
                                                            <input type="hidden" name="orderNo" value="<c:out value='${block.orderNo}'/>">
                                                            <div class="row gy-4">
                                                                <div class="col-md-8">
                                                                    <label for="editBlockName${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Name</label>
                                                                    <input id="editBlockName${block.id}" name="name" type="text" value="<c:out value='${block.name}'/>" required pattern="[^|]*" title="Names cannot contain |" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                                                </div>
                                                                <div class="col-md-4 gape-select-field">
                                                                    <label for="editBlockState${block.id}" class="fw-medium text-base text-neutral-800 mb-10">State</label>
                                                                    <select id="editBlockState${block.id}" name="state" required class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8">
                                                                        <option value="ACTIVE" ${block.state == 'ACTIVE' ? 'selected' : ''}>Active</option>
                                                                        <option value="INACTIVE" ${block.state == 'INACTIVE' ? 'selected' : ''}>Inactive</option>
                                                                    </select>
                                                                </div>
                                                                <div class="col-12">
                                                                    <label for="editBlockDescription${block.id}" class="fw-medium text-base text-neutral-800 mb-10">Description</label>
                                                                    <textarea id="editBlockDescription${block.id}" name="description" rows="4" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600"><c:out value="${block.description}"/></textarea>
                                                                </div>
                                                            </div>
                                                            <p class="text-13 text-danger-600 mt-14 mb-0 d-none" data-class-group-live-error aria-live="polite"></p>
                                                        </div>
                                                        <div class="modal-footer border-neutral-30">
                                                            <button type="button" class="cg-outline-button" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="cg-primary-button" data-class-group-live-submit>Save</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal fade" id="deleteBlock${block.id}" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-8 border-0">
                                                    <div class="modal-header border-neutral-30">
                                                        <h5 class="modal-title text-18 fw-semibold">Delete Content Block</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="text-14 text-neutral-600 mb-0">This action removes the block if it has no dependencies.</p>
                                                    </div>
                                                    <div class="modal-footer border-neutral-30">
                                                        <button type="button" class="cg-outline-button" data-bs-dismiss="modal">Cancel</button>
                                                        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks/${block.id}/delete" method="post" class="m-0">
                                                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                            <button type="submit" class="cg-danger-button">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </c:if>
                                </c:forEach>

                                <c:if test="${empty contentBlocks}">
                                    <div class="cg-empty d-flex align-items-center justify-content-center px-20 py-32 text-center text-14 text-neutral-500">
                                        No pedagogical blocks created for this class group.
                                    </div>
                                </c:if>
                            </div>
                        </section>

                        <c:if test="${canManageClassGroupStructure}">
                            <div class="modal fade" id="createPedagogicalBlock" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content rounded-8 border-0">
                                        <div class="modal-header border-neutral-30">
                                            <div>
                                                <h5 class="modal-title text-18 fw-semibold">Create Pedagogical Block</h5>
                                                <span class="text-13 text-neutral-500"><c:out value="${classGroup.code}"/> | new block</span>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/blocks" method="post" data-class-group-live-form>
                                            <div class="modal-body">
                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                <input type="hidden" name="returnTo" value="/learning/class-groups/${classGroup.id}#pedagogical-blocks">
                                                <input type="hidden" name="classGroupId" value="${classGroup.id}">
                                                <div class="row gy-4">
                                                    <div class="col-md-8">
                                                        <label for="createBlockName" class="fw-medium text-base text-neutral-800 mb-10">Name</label>
                                                        <input id="createBlockName" name="name" type="text" required pattern="[^|]*" title="Names cannot contain |" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600">
                                                    </div>
                                                    <div class="col-md-4 gape-select-field">
                                                        <label for="createBlockState" class="fw-medium text-base text-neutral-800 mb-10">State</label>
                                                        <select id="createBlockState" name="state" required class="form-select px-18 py-11 text-14 bg-neutral-20 border-neutral-30 border rounded-8">
                                                            <option value="ACTIVE" selected>Active</option>
                                                            <option value="INACTIVE">Inactive</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12">
                                                        <label for="createBlockDescription" class="fw-medium text-base text-neutral-800 mb-10">Description</label>
                                                        <textarea id="createBlockDescription" name="description" rows="4" class="form-control px-18 py-11 fw-normal text-14 text-neutral-700 bg-neutral-20 border-neutral-30 border rounded-8 focus-visible-outline focus-border-main-600"></textarea>
                                                    </div>
                                                </div>
                                                <p class="text-13 text-danger-600 mt-14 mb-0 d-none" data-class-group-live-error aria-live="polite"></p>
                                            </div>
                                            <div class="modal-footer border-neutral-30">
                                                <button type="button" class="cg-outline-button" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="cg-primary-button" data-class-group-live-submit>Create</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </c:if>

                                </c:when>
                                <c:otherwise>
                                    <div class="cg-surface px-22 py-22 text-center text-14 text-neutral-500">Open this tab to load the learning plan.</div>
                                </c:otherwise>
                            </c:choose>
                        </div>
                    </div>

                    <div class="cg-tab-panel" data-cg-panel="info" hidden>
                        <div data-cg-lazy-panel="info"
                             data-cg-lazy-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments"
                             aria-busy="false">
                            <div class="cg-surface px-22 py-22 text-center text-14 text-neutral-500">Open this tab to load enrollments.</div>
                        </div>
                        <c:if test="${classGroupDetailInfoContentLoaded}">
                        <section id="class-setup" class="d-none">
                            <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap mb-18">
                                <div>
                                    <h3 class="text-18 fw-semibold text-neutral-800 mb-6">Setup</h3>
                                    <span class="text-14 text-neutral-500">Course, subject, dates, modality, capacity and fixed shift.</span>
                                </div>
                                <span class="${classGroup.stateBadgeClass} px-14 py-7 border-neutral-30 border rounded-pill text-13">
                                    <c:out value="${classGroup.stateLabel}"/>
                                </span>
                            </div>
                            <div class="cg-info-grid">
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Course</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.courseName}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Subject</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.subjectName}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Capacity</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.capacityLabel}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Shift</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.shift}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Modality</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.modalityLabel}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Dates</span><strong class="text-14 text-neutral-800" data-gape-datetime-display><c:out value="${classGroup.dateRangeLabel}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Students</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.activeEnrollmentCountLabel}"/></strong></div>
                                <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Teachers</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.teacherCountLabel}"/></strong></div>
                            </div>
                        </section>

                        <%@ include file="/WEB-INF/fragments/class-group-enrollment-management.jspf" %>

                        <section id="students" class="d-none">
                            <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap mb-18">
                                <div>
                                    <h3 class="text-18 fw-semibold text-neutral-800 mb-6">Students</h3>
                                    <span class="text-14 text-neutral-500">Enroll, approve, reject and review student membership in this class group.</span>
                                </div>
                                <span class="bg-main-50 text-main-600 px-14 py-8 rounded-pill text-13">
                                    <c:out value="${classGroup.activeEnrollmentCountLabel}"/>
                                </span>
                            </div>
                            <c:if test="${canManageClassGroupEnrollments}">
                                <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollment-policy" method="post" class="d-flex align-items-center gap-10 flex-wrap mb-20">
                                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                    <span class="text-14 text-neutral-600 fw-medium">Enrollment policy</span>
                                    <select name="approvalMode" class="form-select px-14 py-8 text-13 bg-neutral-20 border-neutral-30 border rounded-8" style="max-width: 190px;">
                                        <option value="manual" <c:if test="${classGroupEnrollmentPolicy ne 'auto_approve'}">selected</c:if>>Manual approval</option>
                                        <option value="auto_approve" <c:if test="${classGroupEnrollmentPolicy eq 'auto_approve'}">selected</c:if>>Auto approve</option>
                                    </select>
                                    <button type="submit" class="cg-outline-button px-12 py-8 text-13">Save policy</button>
                                </form>
                                <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments" method="post" class="border border-neutral-30 rounded-8 px-18 py-18 mb-20">
                                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                    <div class="row gy-3 align-items-start">
                                        <div class="col-lg-8 gape-select-field">
                                            <label for="studentUserId" class="fw-medium text-base text-neutral-800 mb-12">Student</label>
                                            <select id="studentUserId" name="studentUserId" required class="form-select px-20 py-12 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select">
                                                <option value="">Select student</option>
                                                <c:forEach var="student" items="${studentOptions}">
                                                    <c:if test="${not activeEnrollmentByStudent[student.id]}">
                                                        <option value="${student.id}"><c:out value="${student.name}"/> - <c:out value="${student.email}"/></option>
                                                    </c:if>
                                                </c:forEach>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="cg-primary-button">Enroll Student</button>
                                        </div>
                                    </div>
                                </form>
                            </c:if>
                            <div class="cg-table-wrap">
                                <table class="table mb-0 cg-data-table">
                                    <thead>
                                    <tr>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">Student</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">Period</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">State</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600 text-end">Management</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <c:forEach var="enrollment" items="${classGroupEnrollments}">
                                        <tr class="hover-bg-neutral-20 border-bottom transition-03">
                                            <td class="py-16 px-16">
                                                <span class="fw-medium text-14 text-neutral-700"><c:out value="${enrollment.studentName}"/></span>
                                                <span class="d-block text-12 text-neutral-500"><c:out value="${enrollment.studentEmail}"/></span>
                                            </td>
                                            <td class="py-16 px-16 text-14 text-neutral-500" data-gape-datetime-display><c:out value="${enrollment.startDate}"/> to <c:out value="${enrollment.endDate}"/></td>
                                            <td class="py-16 px-16">
                                                <span class="${enrollment.stateBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                    <c:out value="${enrollment.stateLabel}"/>
                                                </span>
                                            </td>
                                            <td class="py-16 px-16 text-end">
                                                <c:if test="${canManageClassGroupEnrollments and enrollment.pending}">
                                                    <div class="d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                                                        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/approve" method="post" class="m-0 d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                                                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                            <button type="submit" class="cg-primary-button px-12 py-8 text-13">Approve</button>
                                                        </form>
                                                        <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/reject" method="post" class="m-0">
                                                            <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                            <button type="submit" class="cg-outline-button px-12 py-8 text-13">Reject</button>
                                                        </form>
                                                    </div>
                                                </c:if>
                                                <c:if test="${canManageClassGroupEnrollments and enrollment.active}">
                                                    <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/enrollments/${enrollment.studentUserId}/withdraw" method="post" class="m-0 d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                                                        <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                        <button type="submit" class="cg-outline-button px-12 py-8 text-13">Remove</button>
                                                    </form>
                                                </c:if>
                                            </td>
                                        </tr>
                                    </c:forEach>
                                    <c:if test="${empty classGroupEnrollments}">
                                        <tr>
                                            <td colspan="4" class="py-32 px-16 text-center text-14 text-neutral-500">No students enrolled in this class group.</td>
                                        </tr>
                                    </c:if>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        </c:if>
                    </div>

                    <div class="cg-tab-panel" data-cg-panel="teachers" hidden>
                        <div data-cg-lazy-panel="teachers"
                             data-cg-lazy-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/teachers"
                             aria-busy="false">
                            <div class="cg-surface px-22 py-22 text-center text-14 text-neutral-500">Open this tab to load teachers.</div>
                        </div>
                        <c:if test="${classGroupDetailTeachersContentLoaded}">
                        <section id="teachers" class="cg-surface px-22 py-22 mb-20">
                            <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap mb-18">
                                <div>
                                    <h3 class="text-18 fw-semibold text-neutral-800 mb-6">Teachers</h3>
                                    <span class="text-14 text-neutral-500">Assign, remove and review teaching coverage for this class group.</span>
                                </div>
                                <span class="bg-success-50 text-success-600 px-14 py-8 rounded-pill text-13">
                                    <c:out value="${classGroup.teacherCountLabel}"/>
                                </span>
                            </div>
                            <c:if test="${canManageTeacherAssignments}">
                                <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/teachers" method="post" class="border border-neutral-30 rounded-8 px-18 py-18 mb-20">
                                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                    <div class="row gy-3 align-items-start">
                                        <div class="col-lg-6 gape-select-field">
                                            <label for="teacherUserId" class="fw-medium text-base text-neutral-800 mb-12">Teacher</label>
                                            <select id="teacherUserId" name="teacherUserId" required class="form-select px-20 py-12 text-14 bg-neutral-20 border-neutral-30 border rounded-8 js-example-basic-single gape-eduall-select">
                                                <option value="">Select teacher</option>
                                                <c:forEach var="teacher" items="${teacherOptions}">
                                                    <option value="${teacher.id}"><c:out value="${teacher.name}"/> - <c:out value="${teacher.email}"/></option>
                                                </c:forEach>
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="cg-primary-button">Assign Teacher</button>
                                        </div>
                                    </div>
                                </form>
                            </c:if>
                            <div class="cg-table-wrap">
                                <table class="table mb-0 cg-data-table">
                                    <thead>
                                    <tr>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">Teacher</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">Period</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600">State</th>
                                        <th class="py-14 px-16 text-14 fw-medium text-neutral-600 text-end">Management</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <c:forEach var="teacherAssignment" items="${classGroupTeachers}">
                                        <tr class="hover-bg-neutral-20 border-bottom transition-03">
                                            <td class="py-16 px-16">
                                                <span class="fw-medium text-14 text-neutral-700"><c:out value="${teacherAssignment.teacherName}"/></span>
                                                <span class="d-block text-12 text-neutral-500"><c:out value="${teacherAssignment.teacherEmail}"/></span>
                                            </td>
                                            <td class="py-16 px-16 text-14 text-neutral-500" data-gape-datetime-display><c:out value="${teacherAssignment.startDate}"/> to <c:out value="${teacherAssignment.endDate}"/></td>
                                            <td class="py-16 px-16">
                                                <span class="${teacherAssignment.stateBadgeClass} px-12 py-6 border-neutral-30 border rounded-pill text-12">
                                                    <c:out value="${teacherAssignment.stateLabel}"/>
                                                </span>
                                            </td>
                                            <td class="py-16 px-16 text-end">
                                                <c:if test="${canManageTeacherAssignments and teacherAssignment.active}">
                                                    <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/teachers/${teacherAssignment.teacherUserId}/remove" method="post" class="m-0 d-inline-flex align-items-center gap-8 flex-wrap justify-content-end">
                                                        <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                        <button type="submit" class="cg-outline-button px-12 py-8 text-13">Remove</button>
                                                    </form>
                                                </c:if>
                                            </td>
                                        </tr>
                                    </c:forEach>
                                    <c:if test="${empty classGroupTeachers}">
                                        <tr>
                                            <td colspan="4" class="py-32 px-16 text-center text-14 text-neutral-500">No teachers assigned to this class group.</td>
                                        </tr>
                                    </c:if>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        </c:if>
                    </div>

                    <div class="cg-tab-panel" data-cg-panel="grade-sheet" hidden>
                        <div data-cg-lazy-panel="grade-sheet"
                             data-cg-lazy-url="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/grade-sheet"
                             aria-busy="false">
                            <div class="cg-surface px-22 py-22 text-center text-14 text-neutral-500">Open this tab to load the grade sheet.</div>
                        </div>
                        <c:if test="${classGroupDetailGradeSheetContentLoaded}">
                        <section id="class-group-grade-sheet" class="cg-surface px-22 py-22 mb-20">
                            <c:choose>
                                <c:when test="${classGroupGradeSheetAvailable}">
                                    <c:set var="doc" value="${classGroupGradeDocument}"/>
                                    <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap mb-18">
                                        <div>
                                            <h3 class="text-20 fw-semibold text-neutral-800 mb-6">Grade sheet</h3>
                                            <span class="text-14 text-neutral-500">
                                                <c:out value="${classGroupGradeSheet.courseOccurrenceLabel}"/> &middot;
                                                <c:out value="${fn:length(doc.rows)}"/> students
                                            </span>
                                        </div>
                                        <span class="${classGroupGradeSheet.stateBadgeClass} px-14 py-8 border-neutral-30 border rounded-pill text-13">
                                            <c:out value="${classGroupGradeSheet.stateLabel}"/>
                                        </span>
                                    </div>
                                    <div class="aac-grade-doc cd-grade-sheet-doc">
                                        <div class="aac-grade-doc__head">
                                            <div class="aac-grade-doc__posted">Published on: ___ / ___ / _____</div>
                                            <div class="aac-grade-doc__institution">
                                                <div class="aac-grade-doc__media">
                                                    <c:choose>
                                                        <c:when test="${doc.hasImage}">
                                                            <img src="${pageContext.request.contextPath}/media/${doc.imagePath}?v=${mediaCacheVersion}" alt="" class="aac-grade-doc__image" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none');">
                                                            <span class="aac-grade-doc__placeholder d-none"><i class="${doc.fallbackIconClass}"></i></span>
                                                        </c:when>
                                                        <c:otherwise>
                                                            <span class="aac-grade-doc__placeholder"><i class="${doc.fallbackIconClass}"></i></span>
                                                        </c:otherwise>
                                                    </c:choose>
                                                </div>
                                                <div class="aac-grade-doc__brand" title="<c:out value='${doc.contextTitle}'/>"><c:out value="${doc.contextHtml}" escapeXml="false"/></div>
                                            </div>
                                            <div class="aac-grade-doc__entity"><strong><c:out value="${doc.entityLabel}"/>:</strong> <c:out value="${doc.entityName}"/></div>
                                            <h3><c:out value="${doc.title}"/></h3>
                                            <div class="aac-grade-doc__period" data-gape-datetime-display>Academic period: <c:out value="${doc.periodLabel}"/></div>
                                        </div>
                                        <div class="aac-grade-doc__table-wrap" style="--aac-grade-doc-columns: ${doc.variableColumnCount}; --aac-grade-doc-min-width: ${doc.tableMinWidthPx}px;">
                                            <table class="aac-grade-doc__table">
                                                <colgroup>
                                                    <col class="aac-grade-doc__number-col">
                                                    <col class="aac-grade-doc__name-col">
                                                    <c:choose>
                                                        <c:when test="${empty doc.columns}">
                                                            <col class="aac-grade-doc__assessment-col">
                                                        </c:when>
                                                        <c:otherwise>
                                                            <c:forEach var="column" items="${doc.columns}">
                                                                <col class="aac-grade-doc__assessment-col">
                                                            </c:forEach>
                                                        </c:otherwise>
                                                    </c:choose>
                                                    <col class="aac-grade-doc__final-col">
                                                </colgroup>
                                                <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Student name</th>
                                                    <c:choose>
                                                        <c:when test="${empty doc.columns}">
                                                            <th>Assessments</th>
                                                        </c:when>
                                                        <c:otherwise>
                                                            <c:forEach var="column" items="${doc.columns}">
                                                                <th title="<c:out value='${column.headerTitle}'/>"><span class="gape-acronym-token"><c:out value="${column.headerLabel}"/></span></th>
                                                            </c:forEach>
                                                        </c:otherwise>
                                                    </c:choose>
                                                    <th>Final grade</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <c:forEach var="row" items="${doc.rows}">
                                                    <tr>
                                                        <td><c:out value="${row.studentId}"/></td>
                                                        <td class="text-start"><c:out value="${row.studentName}"/></td>
                                                        <c:choose>
                                                            <c:when test="${empty doc.columns}">
                                                                <td class="aac-grade-doc__grade">-</td>
                                                            </c:when>
                                                            <c:otherwise>
                                                                <c:forEach var="value" items="${row.values}">
                                                                    <td class="aac-grade-doc__grade"><c:out value="${value}"/></td>
                                                                </c:forEach>
                                                            </c:otherwise>
                                                        </c:choose>
                                                        <td class="aac-grade-doc__final"><c:out value="${row.finalGrade}"/></td>
                                                    </tr>
                                                </c:forEach>
                                                <c:if test="${empty doc.rows}">
                                                    <tr>
                                                        <td colspan="${doc.documentColumnCount}" class="py-24 text-center text-neutral-500"><c:out value="${doc.emptyMessage}"/></td>
                                                    </tr>
                                                </c:if>
                                                </tbody>
                                            </table>
                                        </div>
                                        <c:if test="${doc.hasAlert}">
                                            <div class="aac-grade-doc__alert"><c:out value="${doc.alert}"/></div>
                                        </c:if>
                                    </div>
                                </c:when>
                                <c:otherwise>
                                    <div class="border border-neutral-30 rounded-8 px-20 py-32 text-center text-14 text-neutral-500 bg-white">
                                        No grade sheet is available for this class group.
                                    </div>
                                </c:otherwise>
                            </c:choose>
                        </section>
                        </c:if>
                    </div>

                </main>

                <c:if test="${canDeleteClassGroup}">
                    <section class="cg-surface px-22 py-22 mb-20" id="class-group-critical-actions">
                        <div class="d-flex align-items-start justify-content-between gap-16 flex-wrap mb-18">
                            <div>
                                <h3 class="text-20 fw-semibold text-neutral-800 mb-6">Critical Actions</h3>
                                <span class="text-14 text-neutral-500">Restricted lifecycle operations for this class group.</span>
                            </div>
                            <span class="bg-warning-50 text-warning-600 px-14 py-8 rounded-pill text-13"><i class="ph ph-lock-key me-6"></i>Requires confirmation</span>
                        </div>
                        <div class="cg-critical-grid">
                            <article class="cg-critical-card cg-critical-card--delete">
                                <div class="d-flex align-items-start gap-14 mb-16"><span class="cg-critical-icon cg-critical-icon--delete text-22"><i class="ph ph-trash"></i></span><div><h4 class="text-16 fw-semibold text-neutral-800 mb-6">Delete Class Group</h4><p class="text-14 text-neutral-500 mb-0">Permanently removes this item when the database allows it.</p></div></div>
                                <button type="button" class="cg-danger-button" data-bs-toggle="modal" data-bs-target="#deleteClassGroup">Delete</button>
                            </article>
                        </div>
                    </section>
                </c:if>
            </div>
            <%@ include file="/WEB-INF/fragments/dashboard-footer.jspf" %>
        </div>
    </div>
</div>

<div class="modal fade" id="classGroupSetupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-8 border-0">
            <div class="modal-header border-neutral-30">
                <div>
                    <h5 class="modal-title text-18 fw-semibold mb-4">Setup</h5>
                    <span class="text-13 text-neutral-500">Course, subject, dates, modality, capacity and fixed shift.</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-10 flex-wrap mb-18">
                    <span class="${classGroup.stateBadgeClass} px-14 py-7 border-neutral-30 border rounded-pill text-13">
                        <c:out value="${classGroup.stateLabel}"/>
                    </span>
                    <span class="bg-main-50 text-main-600 px-14 py-7 rounded-pill text-13">
                        <i class="ph ph-clock me-6"></i><c:out value="${classGroup.shift}"/>
                    </span>
                </div>
                <div class="cg-info-grid">
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Course</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.courseName}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Subject</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.subjectName}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Capacity</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.capacityLabel}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Shift</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.shift}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Modality</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.modalityLabel}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Dates</span><strong class="text-14 text-neutral-800" data-gape-datetime-display><c:out value="${classGroup.dateRangeLabel}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Students</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.activeEnrollmentCountLabel}"/></strong></div>
                    <div class="cg-info-cell"><span class="text-12 text-neutral-500 d-block mb-6">Teachers</span><strong class="text-14 text-neutral-800"><c:out value="${classGroup.teacherCountLabel}"/></strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<c:if test="${canDeleteClassGroup}">
<div class="modal fade" id="deleteClassGroup" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-8 border-0">
            <div class="modal-header border-neutral-30">
                <h5 class="modal-title text-18 fw-semibold">Delete Class Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-14 text-neutral-600 mb-0">This action removes the class group if it has no dependencies.</p>
            </div>
            <div class="modal-footer border-neutral-30">
                <button type="button" class="cg-outline-button" data-bs-dismiss="modal">Cancel</button>
                <form action="${pageContext.request.contextPath}/learning/class-groups/${classGroup.id}/delete" method="post" class="m-0" data-class-group-live-form data-class-group-live-panel="structure">
                    <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                    <button type="submit" class="cg-danger-button">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
</c:if>

<%@ include file="/WEB-INF/fragments/template-base-scripts.jspf" %>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        window.GapeClassGroupModalSelect2Portal = {
            dropdownParent: function (modal) {
                if (!modal || !modal.classList.contains('gape-class-group-modal-root')) {
                    return null;
                }
                var portal = modal.querySelector('[data-gape-class-group-select2-modal-portal]');
                if (!portal) {
                    portal = document.createElement('div');
                    portal.className = 'gape-class-group-select2-modal-portal';
                    portal.setAttribute('data-gape-class-group-select2-modal-portal', '');
                    modal.appendChild(portal);
                }
                return portal;
            }
        };

        function classGroupDetailRoot() {
            return document.querySelector('[data-class-group-detail-live-root]');
        }

        function withCurrentClassGroupSession(url) {
            var target = new URL(url, window.location.href);
            var match = window.location.pathname.match(/^(\/[^/]+)(;jsessionid=[^/]+)/i);
            if (match && target.origin === window.location.origin && target.pathname.indexOf(match[2]) === -1
                    && target.pathname.indexOf(match[1] + '/') === 0) {
                target.pathname = match[1] + match[2] + target.pathname.substring(match[1].length);
            }
            return target.toString();
        }

        function prepareClassGroupDetailModals(scope) {
            Array.prototype.slice.call((scope || document).querySelectorAll('.modal')).forEach(function (modal) {
                modal.classList.add('gape-class-group-modal-root');
                var dialog = modal.querySelector('.modal-dialog');
                if (dialog) {
                    dialog.classList.add('gape-class-group-modal-dialog');
                }
            });
        }

        function classGroupModalContent(modal) {
            if (!modal || !modal.classList.contains('gape-class-group-modal-root')) {
                return null;
            }
            return modal.querySelector('.modal-content');
        }

        function lockClassGroupModalGeometry(modal) {
            var content = classGroupModalContent(modal);
            if (!content) {
                return;
            }
            var height = Math.round(content.getBoundingClientRect().height);
            if (height > 0) {
                content.style.setProperty('--gape-class-group-modal-open-height', height + 'px');
            }
        }

        function unlockClassGroupModalGeometry(modal) {
            var content = classGroupModalContent(modal);
            if (content) {
                content.style.removeProperty('--gape-class-group-modal-open-height');
            }
        }

        function closeClassGroupModal(modal) {
            if (!modal || typeof bootstrap === 'undefined' || !bootstrap.Modal) {
                return;
            }
            var instance = bootstrap.Modal.getInstance(modal) || bootstrap.Modal.getOrCreateInstance(modal);
            instance.hide();
        }

        function clearModalBackdrops() {
            document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
                backdrop.remove();
            });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
        }

        function syncClassGroupTab(tab) {
            if (!tab) {
                return;
            }
            var root = classGroupDetailRoot();
            if (!root || !root.contains(tab)) {
                return;
            }
            var target = tab.getAttribute('data-cg-tab');
                root.querySelectorAll('[data-cg-tab]').forEach(function (item) {
                    var active = item === tab;
                    item.classList.toggle('is-active', active);
                    item.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            root.querySelectorAll('[data-cg-panel]').forEach(function (panel) {
                panel.hidden = panel.getAttribute('data-cg-panel') !== target;
            });
        }

        function currentClassGroupPanel() {
            var root = classGroupDetailRoot();
            var active = root ? root.querySelector('[data-cg-tab].is-active') : null;
            return active ? active.getAttribute('data-cg-tab') : 'structure';
        }

        function classGroupLazyLoadingMarkup() {
            return '<span class="cg-lazy-loading-spinner" role="status" aria-label="Loading">'
                    + '<i class="ph ph-spinner-gap" aria-hidden="true"></i>'
                    + '<span class="visually-hidden">Loading</span>'
                    + '</span>';
        }

        /* Keep action controls on the same live-loading contract as Subject
           Details: only the button interior changes while work is pending. */
        function setClassGroupControlLoading(control, busy) {
            if (!control || control.tagName !== 'BUTTON') {
                return;
            }
            if (busy) {
                if (control.dataset.classGroupLoadingOriginalHtml === undefined) {
                    control.dataset.classGroupLoadingOriginalHtml = control.innerHTML;
                    control.dataset.classGroupLoadingOriginalTitle = control.getAttribute('title') || '';
                    control.dataset.classGroupLoadingOriginalAriaLabel = control.getAttribute('aria-label') || '';
                    control.dataset.classGroupPreviousDisabled = control.disabled ? 'true' : 'false';
                }
                control.innerHTML = classGroupLazyLoadingMarkup();
                control.setAttribute('title', 'Loading');
                control.setAttribute('aria-label', 'Loading');
                control.setAttribute('aria-busy', 'true');
                control.disabled = true;
                return;
            }
            if (control.dataset.classGroupLoadingOriginalHtml === undefined) {
                return;
            }
            control.innerHTML = control.dataset.classGroupLoadingOriginalHtml;
            if (control.dataset.classGroupLoadingOriginalTitle) {
                control.setAttribute('title', control.dataset.classGroupLoadingOriginalTitle);
            } else {
                control.removeAttribute('title');
            }
            if (control.dataset.classGroupLoadingOriginalAriaLabel) {
                control.setAttribute('aria-label', control.dataset.classGroupLoadingOriginalAriaLabel);
            } else {
                control.removeAttribute('aria-label');
            }
            control.removeAttribute('aria-busy');
            control.disabled = control.dataset.classGroupPreviousDisabled === 'true';
            delete control.dataset.classGroupLoadingOriginalHtml;
            delete control.dataset.classGroupLoadingOriginalTitle;
            delete control.dataset.classGroupLoadingOriginalAriaLabel;
            delete control.dataset.classGroupPreviousDisabled;
        }

        function setClassGroupTabLoading(name, busy) {
            var root = classGroupDetailRoot();
            var tab = root ? root.querySelector('[data-cg-tab="' + name + '"]') : null;
            var title = tab ? tab.querySelector('.cg-mode-card__title') : null;
            if (!tab || !title) {
                return;
            }
            if (busy) {
                if (title.dataset.classGroupLoadingOriginalHtml === undefined) {
                    title.dataset.classGroupLoadingOriginalHtml = title.innerHTML;
                }
                title.innerHTML = classGroupLazyLoadingMarkup();
                tab.setAttribute('aria-busy', 'true');
                tab.disabled = true;
                return;
            }
            if (title.dataset.classGroupLoadingOriginalHtml !== undefined) {
                title.innerHTML = title.dataset.classGroupLoadingOriginalHtml;
                delete title.dataset.classGroupLoadingOriginalHtml;
            }
            tab.removeAttribute('aria-busy');
            tab.disabled = false;
        }

        function configureClassGroupDetailSorting(scope) {
            var roots = Array.prototype.slice.call((scope || document).querySelectorAll('[data-cg-detail-sort-root]'));
            roots.forEach(function (root) {
                if (root.dataset.cgDetailSortInitialized === 'true') {
                    return;
                }
                root.dataset.cgDetailSortInitialized = 'true';
                var lists = Array.prototype.slice.call(root.querySelectorAll('[data-cg-detail-sort-list]'));
                var options = Array.prototype.slice.call(root.querySelectorAll('[data-cg-detail-sort-option]'));
                var toggle = root.querySelector('[data-cg-detail-sort-toggle]');
                if (!lists.length || !options.length) {
                    return;
                }

                function datasetKey(field) {
                    return 'sort' + field.charAt(0).toUpperCase() + field.slice(1);
                }

                function oppositeDirection(direction) {
                    return direction === 'asc' ? 'desc' : 'asc';
                }

                var listGroups = lists.map(function (list) {
                    var rows = Array.prototype.slice.call(list.children).filter(function (child) {
                        return child.hasAttribute('data-cg-detail-sort-row');
                    });
                    return {
                        list: list,
                        rows: rows.map(function (row, index) {
                            if (!row.dataset.sortIndex) {
                                row.dataset.sortIndex = String(index);
                            }
                            return { row: row, index: index };
                        })
                    };
                });
                var collator = new Intl.Collator(document.documentElement.lang || undefined, {
                    numeric: true,
                    sensitivity: 'base'
                });
                var activeField = null;
                var activeDirection = null;

                function originalIndex(group) {
                    return Number(group.row.dataset.sortIndex || group.index || '0');
                }

                function sortValue(group, field) {
                    return group.row.dataset[datasetKey(field)] || '';
                }

                function compareGroups(first, second) {
                    if (!activeField || !activeDirection) {
                        return originalIndex(first) - originalIndex(second);
                    }
                    var firstValue = sortValue(first, activeField);
                    var secondValue = sortValue(second, activeField);
                    var result = activeField === 'date'
                        ? Number(firstValue || '0') - Number(secondValue || '0')
                        : collator.compare(firstValue, secondValue);
                    if (result === 0) {
                        result = originalIndex(first) - originalIndex(second);
                    }
                    return activeDirection === 'desc' ? -result : result;
                }

                function renderRows() {
                    listGroups.forEach(function (listGroup) {
                        var sorted = listGroup.rows.slice().sort(compareGroups);
                        listGroup.rows.forEach(function (group) {
                            group.row.remove();
                        });
                        sorted.forEach(function (group) {
                            listGroup.list.appendChild(group.row);
                        });
                    });
                }

                function updateOptionStates() {
                    if (toggle) {
                        toggle.classList.toggle('is-active', activeField !== null);
                    }
                    options.forEach(function (option) {
                        var field = option.dataset.sortField;
                        var normalDirection = option.dataset.sortNormal;
                        var state = 'none';
                        if (activeField === field) {
                            state = activeDirection === normalDirection ? 'normal' : 'reverse';
                        }
                        option.dataset.sortState = state;
                        option.classList.toggle('is-active', state !== 'none');
                        option.setAttribute('aria-pressed', String(state !== 'none'));
                    });
                }

                function closeDropdown() {
                    if (toggle && window.bootstrap && window.bootstrap.Dropdown) {
                        window.bootstrap.Dropdown.getOrCreateInstance(toggle).hide();
                    }
                }

                if (toggle) {
                    toggle.addEventListener('click', function (event) {
                        if (!activeField) {
                            return;
                        }
                        event.preventDefault();
                        event.stopPropagation();
                        activeField = null;
                        activeDirection = null;
                        updateOptionStates();
                        renderRows();
                        closeDropdown();
                    });
                }

                options.forEach(function (option) {
                    option.addEventListener('click', function () {
                        var field = option.dataset.sortField;
                        var normal = option.dataset.sortNormal;
                        var currentState = option.dataset.sortState;
                        if (activeField !== field || currentState === 'none') {
                            activeField = field;
                            activeDirection = normal;
                        } else if (currentState === 'normal') {
                            activeDirection = oppositeDirection(normal);
                        } else {
                            activeField = null;
                            activeDirection = null;
                        }
                        updateOptionStates();
                        renderRows();
                    });
                });

                updateOptionStates();
            });
        }

        function syncClassGroupEnrollmentTab(name, scope) {
            var root = scope || classGroupDetailRoot();
            if (!root || !name) {
                return;
            }
            root.querySelectorAll('[data-cg-enrollment-tab]').forEach(function (tab) {
                var active = tab.getAttribute('data-cg-enrollment-tab') === name;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            root.querySelectorAll('[data-cg-enrollment-panel]').forEach(function (panel) {
                panel.hidden = panel.getAttribute('data-cg-enrollment-panel') !== name;
            });
        }

        function currentClassGroupEnrollmentTab() {
            var root = classGroupDetailRoot();
            var active = root ? root.querySelector('[data-cg-enrollment-tab].is-active') : null;
            return active ? active.getAttribute('data-cg-enrollment-tab') : 'enrollments';
        }

        function initializeClassGroupEnrollmentTabs(scope) {
            var root = scope || classGroupDetailRoot();
            if (root && root.querySelector('[data-cg-enrollment-tab].is-active')) {
                syncClassGroupEnrollmentTab(currentClassGroupEnrollmentTab(), root);
            }
        }

        function initializeClassGroupLazyPanel(scope) {
            prepareClassGroupDetailModals(scope);
            configureClassGroupDetailSorting(scope);
            initializeClassGroupEnrollmentTabs(scope);
            if (!scope || !window.jQuery || !window.jQuery.fn || !window.jQuery.fn.select2) {
                return;
            }
            window.jQuery(scope).find('.js-example-basic-single').each(function () {
                var select = window.jQuery(this);
                if (!select.hasClass('select2-hidden-accessible')) {
                    var modalParent = this.closest('.modal');
                    var options = { width: '100%' };
                    if (modalParent) {
                        var portal = window.GapeClassGroupModalSelect2Portal.dropdownParent(modalParent);
                        options.dropdownParent = window.jQuery(portal || modalParent);
                    }
                    select.select2(options);
                }
            });
        }

        async function loadClassGroupLazyPanel(name) {
            var root = classGroupDetailRoot();
            var panel = root ? root.querySelector('[data-cg-lazy-panel="' + name + '"]') : null;
            if (!panel || panel.dataset.cgLazyLoaded === 'true') {
                return true;
            }
            if (panel.dataset.cgLazyLoading === 'true') {
                return false;
            }
            var url = panel.dataset.cgLazyUrl;
            if (!url) {
                return false;
            }
            panel.dataset.cgLazyLoading = 'true';
            panel.setAttribute('aria-busy', 'true');
            setClassGroupTabLoading(name, true);
            panel.innerHTML = '<div class="cg-surface px-22 py-22 text-center text-14 text-neutral-500">Loading&hellip;</div>';
            try {
                var response = await fetch(withCurrentClassGroupSession(url), {
                    method: 'GET',
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'text/html',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                if (!response.ok) {
                    throw new Error('The panel could not be loaded.');
                }
                var html = await response.text();
                if (name === 'structure') {
                    var documentFragment = new DOMParser().parseFromString(html, 'text/html');
                    var structurePanel = documentFragment.querySelector('[data-cg-lazy-panel="structure"]');
                    if (!structurePanel) {
                        throw new Error('The learning plan could not be loaded.');
                    }
                    panel.innerHTML = structurePanel.innerHTML;
                } else {
                    panel.innerHTML = html;
                }
                panel.dataset.cgLazyLoaded = 'true';
                initializeClassGroupLazyPanel(panel);
                return true;
            } catch (error) {
                panel.innerHTML = '<div class="cg-surface px-22 py-22 text-center text-14 text-danger-600">Unable to load this section. Please try again.</div>';
                return false;
            } finally {
                delete panel.dataset.cgLazyLoading;
                panel.setAttribute('aria-busy', 'false');
                setClassGroupTabLoading(name, false);
            }
        }

        async function activateClassGroupPanel(tab) {
            if (!tab) {
                return;
            }
            var target = tab.getAttribute('data-cg-tab');
            var loaded = await loadClassGroupLazyPanel(target);
            if (!loaded) {
                return;
            }
            syncClassGroupTab(tab);
        }

        function hydrateClassGroupBasics(scope) {
            var root = scope || document;
            root.querySelectorAll('[data-content-thumbnail] img:not([data-cg-thumbnail-bound])').forEach(function (image) {
                image.setAttribute('data-cg-thumbnail-bound', 'true');
                image.addEventListener('error', function () {
                    showContentThumbnailFallback(image);
                }, { once: true });
                if (image.dataset.thumbnailFailed === 'true') {
                    showContentThumbnailFallback(image);
                }
            });
        }

        function scrollToClassGroupAnchor(anchor) {
            if (!anchor) {
                return;
            }
            var root = classGroupDetailRoot();
            var target = root ? root.querySelector(anchor) : null;
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            history.replaceState(null, '', window.location.pathname + window.location.search + anchor);
        }

        function initClassGroupDetail(preferredPanel, anchor) {
            var root = classGroupDetailRoot();
            if (!root) {
                return Promise.resolve(false);
            }
            // Keep the preloaded Structure panel on the same initialization path as
            // panels fetched after a card is selected.  In particular, its Sort by
            // controls must be ready before the user opens any other card.
            initializeClassGroupLazyPanel(root);
            hydrateClassGroupBasics(root);
            var target = preferredPanel || currentClassGroupPanel() || 'structure';
            var tab = root.querySelector('[data-cg-tab="' + target + '"]');
            if (!tab) {
                return Promise.resolve(false);
            }
            return activateClassGroupPanel(tab).then(function () {
                scrollToClassGroupAnchor(anchor);
                return true;
            });
        }

        function syncClassGroupSidebarPendingBadges(parsedDocument) {
            if (!parsedDocument) {
                return;
            }
            var incomingBadge = parsedDocument.querySelector('[data-sidebar-class-group-pending-badge]');
            var pendingCount = incomingBadge ? Number(incomingBadge.textContent.trim()) || 0 : 0;
            document.querySelectorAll('[data-sidebar-class-group-pending-badge]').forEach(function (badge) {
                badge.textContent = String(pendingCount);
                badge.classList.toggle('d-none', pendingCount <= 0);
            });
            var incomingEventBadge = parsedDocument.querySelector('[data-sidebar-event-badge]');
            var eventCount = incomingEventBadge ? Number(incomingEventBadge.textContent.trim()) || 0 : 0;
            document.querySelectorAll('[data-sidebar-event-badge]').forEach(function (badge) {
                badge.textContent = String(eventCount);
                badge.classList.toggle('d-none', eventCount <= 0);
            });
        }

        function replaceClassGroupDetailRoot(html, anchor, requestedEnrollmentTab) {
            var parsed = new DOMParser().parseFromString(html, 'text/html');
            var incomingRoot = parsed.querySelector('[data-class-group-detail-live-root]');
            var currentRoot = classGroupDetailRoot();
            if (!incomingRoot || !currentRoot) {
                throw new Error('Updated class group detail could not be loaded.');
            }
            var activePanel = currentClassGroupPanel();
            var activeEnrollmentTab = requestedEnrollmentTab || currentClassGroupEnrollmentTab();
            syncClassGroupSidebarPendingBadges(parsed);
            currentRoot.innerHTML = incomingRoot.innerHTML;
            clearModalBackdrops();
            return initClassGroupDetail(activePanel, anchor).then(function () {
                syncClassGroupEnrollmentTab(activeEnrollmentTab);
            });
        }

        document.addEventListener('click', function (event) {
            var enrollmentTab = event.target.closest('[data-cg-enrollment-tab]');
            var root = classGroupDetailRoot();
            if (enrollmentTab && root && root.contains(enrollmentTab)) {
                syncClassGroupEnrollmentTab(enrollmentTab.getAttribute('data-cg-enrollment-tab'));
                return;
            }
            var tab = event.target.closest('[data-cg-tab]');
            if (tab && root && root.contains(tab)) {
                activateClassGroupPanel(tab);
            }
        });

        document.addEventListener('shown.bs.modal', function (event) {
            lockClassGroupModalGeometry(event.target);
        });

        document.addEventListener('hidden.bs.modal', function (event) {
            unlockClassGroupModalGeometry(event.target);
        });

        document.addEventListener('submit', async function (event) {
            var form = event.target.closest('[data-class-group-live-form]');
            if (!form) {
                return;
            }
            event.preventDefault();
            if (!form.reportValidity()) {
                return;
            }
            var submitButton = form.querySelector('[data-class-group-live-submit]');
            var status = form.querySelector('[data-class-group-live-error]');
            var modal = form.closest('.modal');
            var returnTo = form.querySelector('input[name="returnTo"]');
            var anchor = '';
            if (returnTo && returnTo.value) {
                try {
                    anchor = new URL(returnTo.value, window.location.origin).hash;
                } catch (ignored) {
                    anchor = '';
                }
            }
            if (status) {
                status.classList.add('d-none');
                status.textContent = '';
            }
            setClassGroupControlLoading(submitButton, true);
            var requestedEnrollmentTab = form.hasAttribute('data-class-group-live-enrollment-request-action')
                    ? 'requests'
                    : null;
            try {
                var response = await fetch(withCurrentClassGroupSession(form.action), {
                    method: form.method || 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                var html = await response.text();
                if (!response.ok) {
                    throw new Error(readableUploadError(html, response.headers.get('content-type') || ''));
                }
                closeClassGroupModal(modal);
                try {
                    await replaceClassGroupDetailRoot(html, anchor, requestedEnrollmentTab);
                } catch (error) {
                    window.location.assign(withCurrentClassGroupSession(response.url || form.action));
                }
            } catch (error) {
                if (status) {
                    status.textContent = error.message || 'The block could not be saved.';
                    status.classList.remove('d-none');
                } else {
                    alert(error.message || 'The block could not be saved.');
                }
            } finally {
                setClassGroupControlLoading(submitButton, false);
            }
        });

        prepareClassGroupDetailModals(document);
        hydrateClassGroupBasics(document);

        function uploadButtonLabel(button) {
            if (!button) {
                return '';
            }
            var label = button.querySelector('[data-upload-button-label]');
            return label ? label.textContent.trim() : button.textContent.trim();
        }

        function setUploadButtonLabel(button, label) {
            if (!button) {
                return;
            }
            var normalizedLabel = label || 'Upload';
            button.setAttribute('data-idle-label', normalizedLabel);
            var labelNode = button.querySelector('[data-upload-button-label]');
            if (labelNode) {
                labelNode.textContent = normalizedLabel;
            } else {
                button.textContent = normalizedLabel;
            }
        }

        function setUploadButtonProgress(button, percent, label, indeterminate) {
            if (!button) {
                return;
            }
            var progress = button.querySelector('[data-upload-button-progress]');
            button.classList.add('is-uploading');
            button.classList.toggle('is-indeterminate', !!indeterminate);
            if (progress && !indeterminate) {
                progress.style.width = Math.max(0, Math.min(100, percent || 0)) + '%';
            }
            var labelNode = button.querySelector('[data-upload-button-label]');
            if (labelNode) {
                labelNode.textContent = label || 'Uploading...';
            } else {
                button.textContent = label || 'Uploading...';
            }
        }

        function resetUploadButton(button) {
            if (!button) {
                return;
            }
            var progress = button.querySelector('[data-upload-button-progress]');
            button.classList.remove('is-uploading', 'is-indeterminate');
            if (progress) {
                progress.style.width = '0%';
            }
            var idleLabel = button.getAttribute('data-idle-label') || uploadButtonLabel(button) || 'Upload';
            var labelNode = button.querySelector('[data-upload-button-label]');
            if (labelNode) {
                labelNode.textContent = idleLabel;
            } else {
                button.textContent = idleLabel;
            }
        }

        function setUploadStatus(status, message, isError) {
            if (!status) {
                return;
            }
            status.textContent = message || '';
            status.classList.toggle('d-none', !message);
            status.classList.toggle('text-danger-600', !!isError);
            status.classList.toggle('text-neutral-600', !isError && !!message);
        }

        function showContentThumbnailFallback(image) {
            if (!image) {
                return;
            }
                var thumbnail = image.closest('[data-content-thumbnail]');
                var fallback = thumbnail ? thumbnail.nextElementSibling : null;
                if (thumbnail) {
                    thumbnail.classList.add('d-none');
                }
                if (fallback && fallback.hasAttribute('data-content-thumbnail-fallback')) {
                    fallback.classList.remove('d-none');
                }
        }

        document.querySelectorAll('[data-content-thumbnail] img').forEach(function (image) {
            image.addEventListener('error', function () {
                showContentThumbnailFallback(image);
            }, { once: true });
            if (image.dataset.thumbnailFailed === 'true') {
                showContentThumbnailFallback(image);
            }
        });

        document.querySelectorAll('.cg-activity-modal').forEach(function (modal) {
            var selectedCategory = 'multimedia';
            var form = modal.querySelector('[data-content-upload-form]');
            var search = modal.querySelector('[data-activity-search]');
            var submit = modal.querySelector('[data-content-submit]');
            var fileWrapper = modal.querySelector('[data-file-wrapper]');
            var fileInput = modal.querySelector('input[name="file"]');
            var fileLabel = modal.querySelector('[data-file-label]');
            var sourceWrapper = modal.querySelector('[data-source-wrapper]');
            var sourceInput = modal.querySelector('[data-source-input]');
            var sourceLabel = modal.querySelector('[data-source-label]');
            var formatInput = modal.querySelector('[data-content-format]');
            var roleInput = modal.querySelector('[data-content-role]');
            var repositoryInput = modal.querySelector('[data-repository-content-id]');
            var repositoryMetadataWrapper = modal.querySelector('[data-repository-metadata-wrapper]');
            var repositoryMetadataModeInput = modal.querySelector('[data-repository-metadata-mode]');
            var repositoryMetadataChoices = modal.querySelectorAll('[data-repository-metadata-choice]');
            var selectedRepositoryFile = modal.querySelector('[data-selected-repository-file]');
            var selectedRepositoryIcon = modal.querySelector('[data-selected-repository-icon]');
            var selectedRepositoryTitle = modal.querySelector('[data-selected-repository-title]');
            var selectedRepositoryDescription = modal.querySelector('[data-selected-repository-description]');
            var selectedRepositoryPreview = modal.querySelector('[data-selected-repository-preview]');
            var titleWrapper = modal.querySelector('[data-title-wrapper]');
            var titleInput = modal.querySelector('input[name="title"]');
            var mandatoryWrapper = modal.querySelector('[data-mandatory-wrapper]');
            var mandatoryInput = modal.querySelector('[data-mandatory-input]');
            var descriptionWrapper = modal.querySelector('[data-description-wrapper]');
            var descriptionInput = modal.querySelector('textarea[name="description"]');
            var contentDetailsPanel = modal.querySelector('[data-content-details-panel]');
            var contentDetailsLabel = modal.querySelector('[data-content-details-label]');
            var contentDetailsFields = modal.querySelector('[data-content-details-fields]');
            var assessmentCreateFields = modal.querySelector('[data-assessment-create-fields]');
            var assessmentFieldInputs = modal.querySelectorAll('[data-assessment-field]');
            var assessmentStateDisplay = modal.querySelector('[data-assessment-state-display]');
            var lessonTypeInput = modal.querySelector('[data-lesson-type-input]');
            var lessonScheduleWrappers = modal.querySelectorAll('[data-lesson-schedule-wrapper]');
            var lessonStateDisplay = modal.querySelector('[data-lesson-state-display]');
            var lessonStartsAtInput = modal.querySelector('[data-lesson-starts-at]');
            var lessonEndsAtInput = modal.querySelector('[data-lesson-ends-at]');
            var lessonMeetingWrappers = modal.querySelectorAll('[data-lesson-meeting-wrapper]');
            var lessonProviderInput = modal.querySelector('[data-lesson-provider]');
            var lessonAccessUrlInput = modal.querySelector('[data-lesson-access-url]');
            var lessonRoomWrapper = modal.querySelector('[data-lesson-room-wrapper]');
            var lessonRoomInput = modal.querySelector('[data-lesson-room]');
            var lessonRoomLabel = modal.querySelector('[data-lesson-room-label]');
            var lessonAttendanceWrapper = modal.querySelector('[data-lesson-attendance-wrapper]');
            var lessonAttendanceInput = modal.querySelector('[data-lesson-attendance]');
            var selectedTypeInput = modal.querySelector('[data-selected-activity]');
            var status = modal.querySelector('[data-upload-status]');
            var selectedOption = null;

            function applyFilter() {
                var term = search ? search.value.trim().toLowerCase() : '';
                modal.querySelectorAll('[data-content-option]').forEach(function (option) {
                    var categoryMatches = option.getAttribute('data-category') === selectedCategory;
                    var textMatches = !term || option.textContent.toLowerCase().indexOf(term) >= 0;
                    option.hidden = !(categoryMatches && textMatches);
                    var repositoryItem = option.closest('[data-repository-item]');
                    if (repositoryItem) {
                        repositoryItem.hidden = option.hidden;
                    }
                });
                modal.querySelectorAll('[data-repository-group]').forEach(function (group) {
                    var visibleOption = group.querySelector('[data-content-option]:not([hidden])');
                    group.hidden = selectedCategory !== 'repository' || !visibleOption;
                });
                var visibleRepositoryOption = modal.querySelector('[data-content-option][data-category="repository"]:not([hidden])');
                modal.querySelectorAll('[data-repository-empty]').forEach(function (emptyState) {
                    emptyState.hidden = selectedCategory !== 'repository' || !!visibleRepositoryOption;
                });
            }

            function updateSelectedRepositoryFile(option) {
                var expectsRepository = option
                        && option.getAttribute('data-supported') === 'true'
                        && option.getAttribute('data-source-kind') === 'repository';
                if (!expectsRepository) {
                    if (selectedRepositoryFile) {
                        selectedRepositoryFile.classList.add('d-none');
                    }
                    if (selectedRepositoryPreview) {
                        selectedRepositoryPreview.removeAttribute('href');
                    }
                    return;
                }

                if (selectedRepositoryFile) {
                    selectedRepositoryFile.classList.remove('d-none');
                }
                var sourceIcon = option.querySelector('.cg-activity-icon');
                if (selectedRepositoryIcon) {
                    selectedRepositoryIcon.className = sourceIcon
                            ? sourceIcon.className + ' flex-shrink-0'
                            : 'cg-activity-icon bg-main-600 flex-shrink-0';
                    selectedRepositoryIcon.innerHTML = sourceIcon ? sourceIcon.innerHTML : '<i class="ph ph-file"></i>';
                }
                if (selectedRepositoryTitle) {
                    selectedRepositoryTitle.textContent = option.getAttribute('data-original-title') || option.innerText.trim();
                }
                if (selectedRepositoryDescription) {
                    selectedRepositoryDescription.textContent = option.getAttribute('data-original-description') || 'No description.';
                }
                if (selectedRepositoryPreview) {
                    selectedRepositoryPreview.href = option.getAttribute('data-preview-url') || '#';
                }
            }

            function setAssessmentFieldValue(name, value) {
                var field = modal.querySelector('[data-assessment-field="' + name + '"]');
                if (field) {
                    field.value = value || '';
                }
            }

            function toggleAssessmentFields(show) {
                if (assessmentCreateFields) {
                    assessmentCreateFields.classList.toggle('d-none', !show);
                }
                assessmentFieldInputs.forEach(function (field) {
                    field.disabled = !show;
                    field.setCustomValidity('');
                });
                syncAssessmentCorrectionMode();
            }

            function syncAssessmentCorrectionMode() {
                var modeField = modal.querySelector('[data-assessment-field="mode"]');
                var correctionField = modal.querySelector('[data-assessment-field="correctionMode"]');
                if (!modeField || !correctionField) {
                    return;
                }
                var isInPerson = modeField.value === 'onsite';
                if (isInPerson) {
                    correctionField.value = 'manual';
                }
                correctionField.disabled = isInPerson || correctionField.closest('.d-none') !== null;
            }

            function clearAssessmentValidation() {
                assessmentFieldInputs.forEach(function (field) {
                    field.setCustomValidity('');
                });
                if (status && selectedOption
                        && selectedOption.getAttribute('data-source-kind') === 'assessment-create') {
                    setUploadStatus(status, '', false);
                }
            }

            function updateAssessmentDetails(option, show) {
                if (contentDetailsPanel) {
                    contentDetailsPanel.classList.toggle('is-assessment-mode', show);
                }
                if (contentDetailsLabel) {
                    contentDetailsLabel.classList.toggle('d-none', show);
                }
                if (contentDetailsFields) {
                    contentDetailsFields.classList.toggle('d-none', show);
                }
                toggleAssessmentFields(show);
                if (!show || !option) {
                    return;
                }
                var assessmentType = option.getAttribute('data-assessment-type') || 'form';
                var assessmentMode = option.getAttribute('data-assessment-mode') || 'online';
                var assessmentCorrectionMode = option.getAttribute('data-assessment-correction-mode') || 'automatic';
                setAssessmentFieldValue('subjectId', option.getAttribute('data-assessment-subject-id') || '');
                setAssessmentFieldValue('contentBlockId', option.getAttribute('data-assessment-content-block-id') || '');
                setAssessmentFieldValue('type', assessmentType);
                setAssessmentFieldValue('mode', assessmentMode);
                setAssessmentFieldValue('title', option.getAttribute('data-title') || '');
                setAssessmentFieldValue('description', option.getAttribute('data-assessment-summary') || '');
                setAssessmentFieldValue('correctionMode', assessmentCorrectionMode);
                syncAssessmentCorrectionMode();
            }

            function repositoryMetadataMode() {
                var checked = modal.querySelector('[data-repository-metadata-choice]:checked');
                return checked ? checked.value : 'custom';
            }

            function resetRepositoryMetadataMode() {
                repositoryMetadataChoices.forEach(function (choice) {
                    choice.checked = choice.value === 'custom';
                });
                if (repositoryMetadataModeInput) {
                    repositoryMetadataModeInput.value = 'custom';
                }
            }

            function toggleNodes(nodes, show) {
                nodes.forEach(function (node) {
                    node.classList.toggle('d-none', !show);
                });
            }

            function localMinuteValue() {
                var now = new Date();
                now.setSeconds(0, 0);
                var month = String(now.getMonth() + 1).padStart(2, '0');
                var day = String(now.getDate()).padStart(2, '0');
                var hours = String(now.getHours()).padStart(2, '0');
                var minutes = String(now.getMinutes()).padStart(2, '0');
                return now.getFullYear() + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
            }

            function temporalStateLabel(startsAtValue, endsAtValue) {
                var now = localMinuteValue();
                if (!startsAtValue) {
                    return 'Draft';
                }
                if (endsAtValue && endsAtValue <= now) {
                    return 'Completed';
                }
                return startsAtValue <= now ? 'Active' : 'Scheduled';
            }

            function updateLessonStateDisplay() {
                if (lessonStateDisplay && lessonStartsAtInput && lessonEndsAtInput) {
                    lessonStateDisplay.textContent = temporalStateLabel(lessonStartsAtInput.value, lessonEndsAtInput.value);
                }
            }

            function updateAssessmentStateDisplay() {
                var availableFrom = modal.querySelector('[data-assessment-field="availableFrom"]');
                var availableUntil = modal.querySelector('[data-assessment-field="availableUntil"]');
                if (assessmentStateDisplay && availableFrom && availableUntil) {
                    assessmentStateDisplay.textContent = temporalStateLabel(availableFrom.value, availableUntil.value);
                }
            }

            function resetLessonFields() {
                if (lessonTypeInput) {
                    lessonTypeInput.value = '';
                }
                toggleNodes(lessonScheduleWrappers, false);
                toggleNodes(lessonMeetingWrappers, false);
                if (lessonRoomWrapper) {
                    lessonRoomWrapper.classList.add('d-none');
                }
                if (lessonAttendanceWrapper) {
                    lessonAttendanceWrapper.classList.add('d-none');
                }
                if (lessonStateDisplay) {
                    lessonStateDisplay.textContent = 'Draft';
                }
                [lessonStartsAtInput, lessonEndsAtInput, lessonProviderInput, lessonAccessUrlInput, lessonRoomInput].forEach(function (input) {
                    if (!input) {
                        return;
                    }
                    input.required = false;
                    input.disabled = false;
                    input.setCustomValidity('');
                    if (input.tagName === 'SELECT') {
                        input.value = '';
                    }
                });
                if (lessonAttendanceInput) {
                    lessonAttendanceInput.checked = true;
                    lessonAttendanceInput.disabled = true;
                }
            }

            function applyLessonFields(option, sourceKind) {
                var lessonType = option ? (option.getAttribute('data-lesson-type') || '') : '';
                var expectsLesson = sourceKind === 'lesson';
                if (lessonTypeInput) {
                    lessonTypeInput.value = expectsLesson ? lessonType : '';
                }
                if (form) {
                    form.action = expectsLesson
                            ? (form.getAttribute('data-lesson-action') || form.action)
                            : (form.getAttribute('data-content-upload-action') || form.action);
                }
                toggleNodes(lessonScheduleWrappers, expectsLesson);
                toggleNodes(lessonMeetingWrappers, expectsLesson && (lessonType === 'online' || lessonType === 'hybrid'));
                if (lessonRoomWrapper) {
                    lessonRoomWrapper.classList.toggle('d-none', !(expectsLesson && (lessonType === 'onsite' || lessonType === 'hybrid')));
                }
                if (lessonAttendanceWrapper) {
                    lessonAttendanceWrapper.classList.toggle('d-none', !expectsLesson);
                }
                if (lessonStartsAtInput) {
                    lessonStartsAtInput.required = expectsLesson;
                    lessonStartsAtInput.disabled = !expectsLesson;
                    if (!expectsLesson) {
                        lessonStartsAtInput.value = '';
                    }
                }
                if (lessonEndsAtInput) {
                    lessonEndsAtInput.required = expectsLesson;
                    lessonEndsAtInput.disabled = !expectsLesson;
                    if (!expectsLesson) {
                        lessonEndsAtInput.value = '';
                    }
                }
                if (lessonAccessUrlInput) {
                    lessonAccessUrlInput.required = expectsLesson && (lessonType === 'online' || lessonType === 'hybrid');
                    lessonAccessUrlInput.disabled = !(expectsLesson && (lessonType === 'online' || lessonType === 'hybrid'));
                    if (!lessonAccessUrlInput.required) {
                        lessonAccessUrlInput.value = '';
                    }
                }
                if (lessonProviderInput) {
                    lessonProviderInput.required = expectsLesson && (lessonType === 'online' || lessonType === 'hybrid');
                    lessonProviderInput.disabled = !(expectsLesson && (lessonType === 'online' || lessonType === 'hybrid'));
                    if (!lessonProviderInput.required) {
                        lessonProviderInput.value = '';
                    }
                }
                if (lessonRoomInput) {
                    lessonRoomInput.required = expectsLesson && (lessonType === 'onsite' || lessonType === 'hybrid');
                    lessonRoomInput.disabled = !(expectsLesson && (lessonType === 'onsite' || lessonType === 'hybrid'));
                    if (lessonRoomLabel) {
                        lessonRoomLabel.textContent = 'Physical Room';
                    }
                    if (!(expectsLesson && (lessonType === 'onsite' || lessonType === 'hybrid'))) {
                        lessonRoomInput.value = '';
                    }
                }
                if (lessonAttendanceInput) {
                    lessonAttendanceInput.disabled = !expectsLesson;
                    if (expectsLesson) {
                        lessonAttendanceInput.checked = true;
                    }
                }
                updateLessonStateDisplay();
                validateLessonSchedule();
                validateMeetingLink();
            }

            function providerHost(providerValue) {
                switch ((providerValue || '').toLowerCase()) {
                    case 'zoom':
                        return 'zoom.us';
                    case 'teams':
                        return 'teams.microsoft.com';
                    case 'meet':
                        return 'meet.google.com';
                    default:
                        return '';
                }
            }

            function hostMatches(host, expectedHost) {
                return host === expectedHost || host.endsWith('.' + expectedHost);
            }

            function validateMeetingLink() {
                if (!lessonAccessUrlInput || !lessonProviderInput || lessonAccessUrlInput.disabled) {
                    return;
                }
                lessonAccessUrlInput.setCustomValidity('');
                var expectedHost = providerHost(lessonProviderInput.value);
                if (!lessonAccessUrlInput.value || !expectedHost) {
                    return;
                }
                try {
                    var parsed = new URL(lessonAccessUrlInput.value);
                    if (parsed.protocol !== 'https:' || !hostMatches(parsed.hostname.toLowerCase(), expectedHost)) {
                        lessonAccessUrlInput.setCustomValidity('The meeting link must match the selected provider.');
                    }
                } catch (ignored) {
                    lessonAccessUrlInput.setCustomValidity('The meeting link must be a valid HTTPS URL.');
                }
            }

            function maxDateTime(first, second) {
                if (!first) {
                    return second || '';
                }
                if (!second) {
                    return first;
                }
                return first > second ? first : second;
            }

            function classGroupWindow() {
                return {
                    start: form ? (form.getAttribute('data-class-group-start') || '') : '',
                    end: form ? (form.getAttribute('data-class-group-end') || '') : ''
                };
            }

            function dayStart(dateValue) {
                return dateValue ? dateValue + 'T00:00' : '';
            }

            function dayEnd(dateValue) {
                return dateValue ? dateValue + 'T23:59' : '';
            }

            function formatDateTimeLabel(value) {
                if (!value) {
                    return 'not set';
                }
                if (window.GapeDateTimeFormat) {
                    return window.GapeDateTimeFormat.formatTechnicalDateTime(value);
                }
                var normalized = value.replace('T', ' ');
                var date = normalized.substring(0, 10).split('-');
                var time = normalized.substring(11, 16);
                return date.length === 3 ? date[2] + '-' + date[1] + '-' + date[0] + (time ? ' ' + time.replace(':', '-') + '-00' : '') : value;
            }

            function minDateTime(first, second) {
                if (!first) {
                    return second || '';
                }
                if (!second) {
                    return first;
                }
                return first < second ? first : second;
            }

            function addMinutes(value, minutes) {
                if (!value) {
                    return '';
                }
                var date = new Date(value);
                if (Number.isNaN(date.getTime())) {
                    return value;
                }
                date.setMinutes(date.getMinutes() + minutes);
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                var hours = String(date.getHours()).padStart(2, '0');
                var mins = String(date.getMinutes()).padStart(2, '0');
                return date.getFullYear() + '-' + month + '-' + day + 'T' + hours + ':' + mins;
            }

            function syncModalDateContext(selector, copyPrefix, lowerBound, upperBound) {
                var panel = modal.querySelector(selector);
                if (!panel) {
                    return;
                }
                var copy = panel.querySelector('[data-date-context-copy]');
                var dateWindow = classGroupWindow();
                var hasWindow = !!(dateWindow.start && dateWindow.end);
                var usable = hasWindow && (!lowerBound || !upperBound || lowerBound <= upperBound);
                if (copy) {
                    copy.textContent = hasWindow
                            ? copyPrefix + ' ' + formatDateTimeLabel(lowerBound || dayStart(dateWindow.start)) + ' to ' + formatDateTimeLabel(upperBound)
                            : 'This class group has no date window.';
                }
                panel.querySelectorAll('[data-lesson-date-action], [data-assessment-date-action]').forEach(function (button) {
                    button.disabled = !usable;
                });
            }

            function applyLessonDateAction(action) {
                if (!lessonStartsAtInput || !lessonEndsAtInput || lessonStartsAtInput.disabled) {
                    return;
                }
                var now = localMinuteValue();
                var dateWindow = classGroupWindow();
                var lowerBound = maxDateTime(now, dayStart(dateWindow.start));
                var upperBound = dayEnd(dateWindow.end);
                if (!dateWindow.start || !dateWindow.end || lowerBound > upperBound) {
                    validateLessonSchedule();
                    return;
                }
                if (action === 'fill-start') {
                    lessonStartsAtInput.value = lowerBound;
                } else if (action === 'fill-end') {
                    lessonEndsAtInput.value = upperBound;
                } else if (action === 'fill-slot') {
                    lessonStartsAtInput.value = lowerBound;
                    lessonEndsAtInput.value = minDateTime(addMinutes(lowerBound, 90), upperBound);
                }
                validateLessonSchedule();
            }

            function applyAssessmentDateAction(action) {
                var availableFrom = modal.querySelector('[data-assessment-field="availableFrom"]');
                var availableUntil = modal.querySelector('[data-assessment-field="availableUntil"]');
                if (!availableFrom || !availableUntil || availableFrom.disabled || availableUntil.disabled) {
                    return;
                }
                var now = localMinuteValue();
                var dateWindow = classGroupWindow();
                var lowerBound = maxDateTime(now, dayStart(dateWindow.start));
                var upperBound = dayEnd(dateWindow.end);
                if (!dateWindow.start || !dateWindow.end || lowerBound > upperBound) {
                    validateAssessmentForm(form);
                    return;
                }
                if (action === 'fill-start') {
                    availableFrom.value = lowerBound;
                } else if (action === 'fill-end') {
                    availableUntil.value = upperBound;
                } else if (action === 'fill-window') {
                    availableFrom.value = lowerBound;
                    availableUntil.value = upperBound;
                }
                validateAssessmentForm(form);
                updateAssessmentStateDisplay();
            }

            function validateLessonSchedule() {
                if (!lessonStartsAtInput || !lessonEndsAtInput) {
                    return;
                }
                var now = localMinuteValue();
                var dateWindow = classGroupWindow();
                var lowerBound = maxDateTime(now, dayStart(dateWindow.start));
                var upperBound = dayEnd(dateWindow.end);
                if (lessonStartsAtInput.disabled || lessonEndsAtInput.disabled) {
                    syncModalDateContext('[data-lesson-date-context]', 'Schedule window:', lowerBound, upperBound);
                    return;
                }
                lessonStartsAtInput.required = true;
                lessonStartsAtInput.min = lowerBound;
                lessonStartsAtInput.max = upperBound;
                lessonEndsAtInput.required = true;
                lessonEndsAtInput.min = maxDateTime(lessonStartsAtInput.value || lowerBound, dayStart(dateWindow.start));
                lessonEndsAtInput.max = upperBound;
                lessonStartsAtInput.setCustomValidity('');
                lessonEndsAtInput.setCustomValidity('');
                if (dateWindow.start && dateWindow.end && lowerBound > upperBound) {
                    lessonStartsAtInput.setCustomValidity('The selected class group has no available schedule window.');
                }
                if (!lessonStartsAtInput.value) {
                    lessonStartsAtInput.setCustomValidity('Lesson start date is required.');
                }
                if (!lessonEndsAtInput.value) {
                    lessonEndsAtInput.setCustomValidity('Lesson end date is required.');
                }
                if (lessonStartsAtInput.value && lessonStartsAtInput.value < now) {
                    lessonStartsAtInput.setCustomValidity('Start date cannot be in the past.');
                }
                if (lessonEndsAtInput.value && lessonEndsAtInput.value < now) {
                    lessonEndsAtInput.setCustomValidity('End date cannot be in the past.');
                }
                if (dateWindow.start && lessonStartsAtInput.value && lessonStartsAtInput.value < dayStart(dateWindow.start)) {
                    lessonStartsAtInput.setCustomValidity('Start date cannot be before the class group start date.');
                }
                if (dateWindow.end && lessonStartsAtInput.value && lessonStartsAtInput.value > dayEnd(dateWindow.end)) {
                    lessonStartsAtInput.setCustomValidity('Start date cannot be after the class group end date.');
                }
                if (dateWindow.start && lessonEndsAtInput.value && lessonEndsAtInput.value < dayStart(dateWindow.start)) {
                    lessonEndsAtInput.setCustomValidity('End date cannot be before the class group start date.');
                }
                if (dateWindow.end && lessonEndsAtInput.value && lessonEndsAtInput.value > dayEnd(dateWindow.end)) {
                    lessonEndsAtInput.setCustomValidity('End date cannot be after the class group end date.');
                }
                if (lessonStartsAtInput.value && lessonEndsAtInput.value && lessonEndsAtInput.value <= lessonStartsAtInput.value) {
                    lessonEndsAtInput.setCustomValidity('End date must be after start date.');
                }
                syncModalDateContext('[data-lesson-date-context]', 'Schedule window:', lowerBound, upperBound);
                updateLessonStateDisplay();
            }

            function applyRepositoryMetadataMode() {
                var expectsRepository = selectedOption
                        && selectedOption.getAttribute('data-supported') === 'true'
                        && selectedOption.getAttribute('data-source-kind') === 'repository';
                var expectsAssessmentRepository = expectsRepository
                        && selectedOption.getAttribute('data-assessment-reference') === 'true';
                var expectsLesson = selectedOption
                        && selectedOption.getAttribute('data-supported') === 'true'
                        && selectedOption.getAttribute('data-source-kind') === 'lesson';
                var expectsAssessmentCreate = selectedOption
                        && selectedOption.getAttribute('data-supported') === 'true'
                        && selectedOption.getAttribute('data-source-kind') === 'assessment-create';
                if (!expectsRepository || expectsAssessmentRepository) {
                    if (repositoryMetadataWrapper) {
                        repositoryMetadataWrapper.classList.add('d-none');
                    }
                    if (repositoryMetadataModeInput) {
                        repositoryMetadataModeInput.value = 'custom';
                    }
                    if (titleInput) {
                        titleInput.disabled = expectsAssessmentCreate || expectsAssessmentRepository;
                        titleInput.required = !expectsAssessmentCreate && !expectsAssessmentRepository;
                    }
                    if (descriptionInput) {
                        descriptionInput.disabled = expectsAssessmentCreate || expectsAssessmentRepository;
                    }
                    if (mandatoryInput) {
                        mandatoryInput.disabled = expectsLesson || expectsAssessmentCreate || expectsAssessmentRepository;
                    }
                    return;
                }

                if (repositoryMetadataWrapper) {
                    repositoryMetadataWrapper.classList.remove('d-none');
                }
                var mode = repositoryMetadataMode();
                if (repositoryMetadataModeInput) {
                    repositoryMetadataModeInput.value = mode;
                }
                var useOriginal = mode === 'original';
                if (titleInput) {
                    titleInput.value = useOriginal ? (selectedOption.getAttribute('data-original-title') || '') : '';
                    titleInput.disabled = useOriginal;
                    titleInput.required = !useOriginal;
                }
                if (descriptionInput) {
                    descriptionInput.value = useOriginal ? (selectedOption.getAttribute('data-original-description') || '') : '';
                    descriptionInput.disabled = useOriginal;
                }
                if (mandatoryInput) {
                    mandatoryInput.value = useOriginal && selectedOption.getAttribute('data-original-mandatory') === 'true'
                            ? 'true'
                            : 'false';
                    mandatoryInput.disabled = useOriginal;
                }
            }

            function selectOption(option) {
                selectedOption = option;
                if (!option) {
                    modal.querySelectorAll('[data-content-option]').forEach(function (item) {
                        item.classList.remove('is-selected');
                        var repositoryItem = item.closest('[data-repository-item]');
                        if (repositoryItem) {
                            repositoryItem.classList.remove('is-selected');
                        }
                    });
                    if (submit) {
                        submit.disabled = true;
                        setUploadButtonLabel(submit, 'Not Available');
                        resetUploadButton(submit);
                    }
                    if (repositoryInput) {
                        repositoryInput.value = '';
                    }
                    resetRepositoryMetadataMode();
                    if (repositoryMetadataWrapper) {
                        repositoryMetadataWrapper.classList.add('d-none');
                    }
                    updateSelectedRepositoryFile(null);
                    updateAssessmentDetails(null, false);
                    if (fileWrapper && fileInput) {
                        fileWrapper.classList.add('d-none');
                        fileInput.required = false;
                        fileInput.value = '';
                    }
                    if (sourceWrapper && sourceInput) {
                        sourceWrapper.classList.add('d-none');
                        sourceInput.required = false;
                        sourceInput.value = '';
                    }
                    if (titleWrapper && titleInput) {
                        titleWrapper.classList.add('d-none');
                        titleInput.required = false;
                        titleInput.disabled = true;
                    }
                    if (descriptionWrapper && descriptionInput) {
                        descriptionWrapper.classList.add('d-none');
                        descriptionInput.disabled = true;
                    }
                    if (mandatoryInput) {
                        mandatoryInput.disabled = false;
                        mandatoryInput.value = 'false';
                    }
                    resetLessonFields();
                    if (status) {
                        setUploadStatus(status, selectedCategory === 'repository' ? 'No reusable pedagogical files are available yet.' : '', false);
                    }
                    return;
                }
                modal.querySelectorAll('[data-content-option]').forEach(function (item) {
                    var active = item === option;
                    item.classList.toggle('is-selected', active);
                    var repositoryItem = item.closest('[data-repository-item]');
                    if (repositoryItem) {
                        repositoryItem.classList.toggle('is-selected', active);
                    }
                });
                var supported = option.getAttribute('data-supported') === 'true';
                var sourceKind = option.getAttribute('data-source-kind');
                var expectsLesson = supported && sourceKind === 'lesson';
                var expectsAssessmentCreate = supported && sourceKind === 'assessment-create';
                var optionTitle = option.getAttribute('data-title') || '';
                formatInput.value = option.getAttribute('data-format') || 'pdf';
                roleInput.value = option.getAttribute('data-role') || 'support_material';
                if (selectedTypeInput) {
                        selectedTypeInput.value = optionTitle;
                }
                if (titleInput) {
                    titleInput.value = optionTitle;
                }
                if (submit) {
                    submit.disabled = !supported;
                    setUploadButtonLabel(submit, supported ? (option.getAttribute('data-submit-label') || 'Add Content') : 'Not Available');
                    resetUploadButton(submit);
                }
                if (status) {
                    setUploadStatus(status, expectsAssessmentCreate
                            ? ''
                            : (supported
                            ? ''
                            : (option.getAttribute('data-unavailable-message') || 'This content type is represented in the GAPE data model but does not yet have a complete creation workflow here.')), !supported);
                }
                var expectsFile = supported && sourceKind === 'file';
                var expectsSource = supported && (sourceKind === 'url' || sourceKind === 'embed');
                var expectsRepository = supported && sourceKind === 'repository';
                var expectsAssessmentRepository = expectsRepository && option.getAttribute('data-assessment-reference') === 'true';
                applyLessonFields(option, sourceKind);
                if (repositoryInput) {
                    repositoryInput.value = expectsRepository ? (option.getAttribute('data-content-id') || '') : '';
                }
                updateSelectedRepositoryFile(option);
                updateAssessmentDetails(option, expectsAssessmentCreate);
                if (expectsRepository) {
                    resetRepositoryMetadataMode();
                }
                if (titleWrapper && titleInput) {
                    titleWrapper.classList.toggle('d-none', expectsAssessmentCreate || expectsAssessmentRepository);
                    titleInput.required = supported && !expectsAssessmentCreate && !expectsAssessmentRepository;
                    titleInput.disabled = expectsAssessmentCreate || expectsAssessmentRepository;
                }
                if (mandatoryWrapper) {
                    mandatoryWrapper.classList.toggle('d-none', expectsLesson || expectsAssessmentCreate || expectsAssessmentRepository);
                }
                if (mandatoryInput) {
                    mandatoryInput.disabled = expectsLesson || expectsAssessmentCreate || expectsAssessmentRepository;
                    if (expectsLesson || expectsAssessmentCreate || expectsAssessmentRepository) {
                        mandatoryInput.value = 'false';
                    }
                }
                if (descriptionWrapper && descriptionInput) {
                    descriptionWrapper.classList.toggle('d-none', expectsAssessmentCreate || expectsAssessmentRepository);
                    descriptionInput.disabled = expectsAssessmentCreate || expectsAssessmentRepository;
                }
                if (fileWrapper && fileInput) {
                    fileWrapper.classList.toggle('d-none', !expectsFile);
                    fileInput.required = expectsFile;
                    fileInput.setAttribute('accept', option.getAttribute('data-accept') || 'application/pdf,.pdf');
                    if (fileLabel) {
                        fileLabel.textContent = 'File';
                    }
                    if (!expectsFile) {
                        fileInput.value = '';
                    }
                }
                if (sourceWrapper && sourceInput) {
                    sourceWrapper.classList.toggle('d-none', !expectsSource);
                    sourceInput.required = expectsSource;
                    if (sourceLabel) {
                        sourceLabel.textContent = sourceKind === 'embed' ? 'Embed source' : (sourceKind === 'text' ? 'Text' : 'URL');
                    }
                    if (!expectsSource) {
                        sourceInput.value = '';
                    }
                }
                applyRepositoryMetadataMode();
            }

            modal.querySelectorAll('[data-content-category]').forEach(function (categoryButton) {
                categoryButton.addEventListener('click', function () {
                    selectedCategory = categoryButton.getAttribute('data-content-category');
                    modal.querySelectorAll('[data-content-category]').forEach(function (item) {
                        item.classList.toggle('is-active', item === categoryButton);
                    });
                    applyFilter();
                    selectOption(modal.querySelector('[data-content-option]:not([hidden])'));
                });
            });
            modal.querySelectorAll('[data-content-option]').forEach(function (option) {
                option.addEventListener('click', function () {
                    selectOption(option);
                });
            });
            if (search) {
                search.addEventListener('input', applyFilter);
            }
            if (lessonProviderInput) {
                lessonProviderInput.addEventListener('change', validateMeetingLink);
            }
            if (lessonAccessUrlInput) {
                lessonAccessUrlInput.addEventListener('input', validateMeetingLink);
            }
            if (lessonStartsAtInput) {
                lessonStartsAtInput.addEventListener('input', validateLessonSchedule);
            }
            if (lessonEndsAtInput) {
                lessonEndsAtInput.addEventListener('input', validateLessonSchedule);
            }
            modal.querySelectorAll('[data-lesson-date-action]').forEach(function (button) {
                button.addEventListener('click', function () {
                    applyLessonDateAction(button.getAttribute('data-lesson-date-action'));
                });
            });
            modal.querySelectorAll('[data-assessment-date-action]').forEach(function (button) {
                button.addEventListener('click', function () {
                    applyAssessmentDateAction(button.getAttribute('data-assessment-date-action'));
                });
            });
            repositoryMetadataChoices.forEach(function (choice) {
                choice.addEventListener('change', applyRepositoryMetadataMode);
            });
            assessmentFieldInputs.forEach(function (field) {
                field.addEventListener('input', function () {
                    clearAssessmentValidation();
                    updateAssessmentStateDisplay();
                });
                field.addEventListener('change', function () {
                    clearAssessmentValidation();
                    updateAssessmentStateDisplay();
                });
            });
            applyFilter();
            selectOption(modal.querySelector('[data-content-option].is-selected'));
            updateAssessmentStateDisplay();
            updateLessonStateDisplay();
            window.setInterval(function () {
                validateLessonSchedule();
                updateAssessmentStateDisplay();
            }, 30000);
        });

        function expectedLessonProviderHost(providerValue) {
            switch ((providerValue || '').toLowerCase()) {
                case 'zoom':
                    return 'zoom.us';
                case 'teams':
                    return 'teams.microsoft.com';
                case 'meet':
                    return 'meet.google.com';
                default:
                    return '';
            }
        }

        function currentLocalMinuteValue() {
            var now = new Date();
            now.setSeconds(0, 0);
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            return now.getFullYear() + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
        }

        function maxDateTimeValue(first, second) {
            if (!first) {
                return second || '';
            }
            if (!second) {
                return first;
            }
            return first > second ? first : second;
        }

        function classGroupDateWindow(form) {
            return {
                start: form ? (form.getAttribute('data-class-group-start') || '') : '',
                end: form ? (form.getAttribute('data-class-group-end') || '') : ''
            };
        }

        function classGroupDayStart(dateValue) {
            return dateValue ? dateValue + 'T00:00' : '';
        }

        function classGroupDayEnd(dateValue) {
            return dateValue ? dateValue + 'T23:59' : '';
        }

        function formatDateTimeValue(value) {
            if (!value) {
                return 'not set';
            }
            if (window.GapeDateTimeFormat) {
                return window.GapeDateTimeFormat.formatTechnicalDateTime(value);
            }
            var normalized = value.replace('T', ' ');
            var date = normalized.substring(0, 10).split('-');
            var time = normalized.substring(11, 16);
            return date.length === 3 ? date[2] + '-' + date[1] + '-' + date[0] + (time ? ' ' + time.replace(':', '-') + '-00' : '') : value;
        }

        function syncFormDateContext(form, selector, copyPrefix, lowerBound, upperBound) {
            var panel = form ? form.querySelector(selector) : null;
            if (!panel) {
                return;
            }
            var copy = panel.querySelector('[data-date-context-copy]');
            var dateWindow = classGroupDateWindow(form);
            var hasWindow = !!(dateWindow.start && dateWindow.end);
            var usable = hasWindow && (!lowerBound || !upperBound || lowerBound <= upperBound);
            if (copy) {
                copy.textContent = hasWindow
                        ? copyPrefix + ' ' + formatDateTimeValue(lowerBound || classGroupDayStart(dateWindow.start)) + ' to ' + formatDateTimeValue(upperBound)
                        : 'This class group has no date window.';
            }
            panel.querySelectorAll('[data-lesson-date-action], [data-assessment-date-action]').forEach(function (button) {
                button.disabled = !usable;
            });
        }

        function lessonHostMatches(host, expectedHost) {
            return host === expectedHost || host.endsWith('.' + expectedHost);
        }

        function validateLessonForm(form) {
            var startsAt = form.querySelector('[data-lesson-starts-at]');
            var endsAt = form.querySelector('[data-lesson-ends-at]');
            var provider = form.querySelector('[data-lesson-provider]');
            var accessUrl = form.querySelector('[data-lesson-access-url]');
            if (startsAt && endsAt) {
                var now = currentLocalMinuteValue();
                var dateWindow = classGroupDateWindow(form);
                var lowerBound = maxDateTimeValue(now, classGroupDayStart(dateWindow.start));
                var upperBound = classGroupDayEnd(dateWindow.end);
                startsAt.required = true;
                startsAt.min = lowerBound;
                startsAt.max = upperBound;
                endsAt.required = true;
                endsAt.min = maxDateTimeValue(startsAt.value || lowerBound, classGroupDayStart(dateWindow.start));
                endsAt.max = upperBound;
                startsAt.setCustomValidity('');
                endsAt.setCustomValidity('');
                if (dateWindow.start && dateWindow.end && lowerBound > upperBound) {
                    startsAt.setCustomValidity('The selected class group has no available schedule window.');
                }
                if (!startsAt.value) {
                    startsAt.setCustomValidity('Lesson start date is required.');
                }
                if (!endsAt.value) {
                    endsAt.setCustomValidity('Lesson end date is required.');
                }
                if (startsAt.value && startsAt.value < now) {
                    startsAt.setCustomValidity('Start date cannot be in the past.');
                }
                if (endsAt.value && endsAt.value < now) {
                    endsAt.setCustomValidity('End date cannot be in the past.');
                }
                if (dateWindow.start && startsAt.value && startsAt.value < classGroupDayStart(dateWindow.start)) {
                    startsAt.setCustomValidity('Start date cannot be before the class group start date.');
                }
                if (dateWindow.end && startsAt.value && startsAt.value > classGroupDayEnd(dateWindow.end)) {
                    startsAt.setCustomValidity('Start date cannot be after the class group end date.');
                }
                if (dateWindow.start && endsAt.value && endsAt.value < classGroupDayStart(dateWindow.start)) {
                    endsAt.setCustomValidity('End date cannot be before the class group start date.');
                }
                if (dateWindow.end && endsAt.value && endsAt.value > classGroupDayEnd(dateWindow.end)) {
                    endsAt.setCustomValidity('End date cannot be after the class group end date.');
                }
                if (startsAt.value && endsAt.value && endsAt.value <= startsAt.value) {
                    endsAt.setCustomValidity('End date must be after start date.');
                }
                syncFormDateContext(form, '[data-lesson-date-context]', 'Schedule window:', lowerBound, upperBound);
            }
            if (provider && accessUrl && !accessUrl.disabled) {
                accessUrl.setCustomValidity('');
                var expectedHost = expectedLessonProviderHost(provider.value);
                if (accessUrl.value && expectedHost) {
                    try {
                        var parsed = new URL(accessUrl.value);
                        if (parsed.protocol !== 'https:' || !lessonHostMatches(parsed.hostname.toLowerCase(), expectedHost)) {
                            accessUrl.setCustomValidity('The meeting link must match the selected provider.');
                        }
                    } catch (ignored) {
                        accessUrl.setCustomValidity('The meeting link must be a valid HTTPS URL.');
                    }
                }
            }
            return form.checkValidity();
        }

        function validateAssessmentForm(form) {
            var maxGrade = form.querySelector('[data-assessment-field="maxGrade"]');
            var passingGrade = form.querySelector('[data-assessment-field="passingGrade"]');
            var finalGradeWeight = form.querySelector('[data-assessment-field="finalGradeWeight"]');
            var attemptsLimit = form.querySelector('[data-assessment-field="attemptsLimit"]');
            var availableFrom = form.querySelector('[data-assessment-field="availableFrom"]');
            var availableUntil = form.querySelector('[data-assessment-field="availableUntil"]');
            [maxGrade, passingGrade, finalGradeWeight, attemptsLimit, availableFrom, availableUntil].forEach(function (field) {
                if (field) {
                    field.setCustomValidity('');
                }
            });
            var now = currentLocalMinuteValue();
            if (availableFrom && availableUntil) {
                var dateWindow = classGroupDateWindow(form);
                var lowerBound = maxDateTimeValue(now, classGroupDayStart(dateWindow.start));
                var upperBound = classGroupDayEnd(dateWindow.end);
                availableFrom.required = true;
                availableUntil.required = true;
                availableFrom.min = lowerBound;
                availableFrom.max = upperBound;
                availableUntil.min = maxDateTimeValue(availableFrom.value || lowerBound, classGroupDayStart(dateWindow.start));
                availableUntil.max = upperBound;
                if (dateWindow.start && dateWindow.end && lowerBound > upperBound) {
                    availableFrom.setCustomValidity('The selected context has no available assessment window.');
                }
                if (!availableFrom.value) {
                    availableFrom.setCustomValidity('Assessment availability start is required.');
                }
                if (!availableUntil.value) {
                    availableUntil.setCustomValidity('Assessment availability end is required.');
                }
                if (dateWindow.start && availableFrom.value && availableFrom.value < classGroupDayStart(dateWindow.start)) {
                    availableFrom.setCustomValidity('Availability start cannot be before the class group start date.');
                }
                if (dateWindow.end && availableFrom.value && availableFrom.value > classGroupDayEnd(dateWindow.end)) {
                    availableFrom.setCustomValidity('Availability start cannot be after the class group end date.');
                }
                if (dateWindow.start && availableUntil.value && availableUntil.value < classGroupDayStart(dateWindow.start)) {
                    availableUntil.setCustomValidity('Availability end cannot be before the class group start date.');
                }
                if (dateWindow.end && availableUntil.value && availableUntil.value > classGroupDayEnd(dateWindow.end)) {
                    availableUntil.setCustomValidity('Availability end cannot be after the class group end date.');
                }
                syncFormDateContext(form, '[data-assessment-date-context]', 'Availability window:', lowerBound, upperBound);
            }
            if (availableFrom && availableFrom.value && availableFrom.value < now) {
                availableFrom.setCustomValidity('Availability start cannot be in the past.');
            }
            if (availableUntil && availableUntil.value && availableUntil.value < now) {
                availableUntil.setCustomValidity('Availability end cannot be in the past.');
            }
            if (maxGrade && passingGrade && maxGrade.value && passingGrade.value
                    && parseFloat(passingGrade.value) > parseFloat(maxGrade.value)) {
                passingGrade.setCustomValidity('Passing grade cannot exceed maximum grade.');
            }
            if (finalGradeWeight && finalGradeWeight.value) {
                var weightValue = parseFloat(finalGradeWeight.value);
                if (!Number.isFinite(weightValue) || weightValue < 0 || weightValue > 100) {
                    finalGradeWeight.setCustomValidity('Final weight must be between 0 and 100.');
                }
            }
            if (availableFrom && availableUntil && availableFrom.value && availableUntil.value
                    && availableUntil.value < availableFrom.value) {
                availableUntil.setCustomValidity('Availability end cannot be before start.');
            }
            if (attemptsLimit && attemptsLimit.value && parseInt(attemptsLimit.value, 10) <= 0) {
                attemptsLimit.setCustomValidity('Attempts limit must be greater than zero.');
            }
            return form.checkValidity();
        }

        function assessmentRequestBody(form) {
            var requestBody = new URLSearchParams();
            var csrfToken = form.querySelector('input[name="csrfToken"]');
            if (csrfToken) {
                requestBody.append('csrfToken', csrfToken.value);
            }
            requestBody.append('modalCreate', 'true');
            form.querySelectorAll('[data-assessment-field]').forEach(function (field) {
                if (!field.disabled) {
                    requestBody.append(field.getAttribute('data-assessment-field'), field.value || '');
                }
            });
            return requestBody.toString();
        }

        function withCurrentUrlSession(targetUrl) {
            var sessionIndex = window.location.pathname.indexOf(';jsessionid=');
            var learningIndex = window.location.pathname.indexOf('/learning/');
            if (!targetUrl || sessionIndex < 0 || learningIndex < 0 || targetUrl.indexOf(';jsessionid=') >= 0 || targetUrl.charAt(0) !== '/') {
                return targetUrl;
            }
            var currentContextWithSession = window.location.pathname.substring(0, learningIndex);
            var currentContext = currentContextWithSession.substring(0, sessionIndex);
            var targetPath = targetUrl.indexOf(currentContext + '/') === 0
                    ? targetUrl.substring(currentContext.length)
                    : targetUrl;
            return currentContextWithSession + targetPath;
        }

        function returnToAssessmentBlock(form) {
            var returnAnchor = form.getAttribute('data-assessment-return-anchor') || '';
            if (returnAnchor) {
                window.location.hash = returnAnchor;
            }
            window.location.reload();
        }

        document.querySelectorAll('[data-content-upload-form]').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                var status = form.querySelector('[data-upload-status]');
                var formModal = form.closest('.cg-activity-modal');
                var submit = form.querySelector('[data-content-submit]')
                        || (formModal ? formModal.querySelector('[data-content-submit]') : null);
                if (submit && submit.disabled) {
                    return;
                }
                var selectedSubmitOption = form.querySelector('[data-content-option].is-selected');
                var createsAssessment = selectedSubmitOption
                        && selectedSubmitOption.getAttribute('data-source-kind') === 'assessment-create';
                if (createsAssessment) {
                    if (!validateAssessmentForm(form)) {
                        form.reportValidity();
                        setUploadStatus(status, 'Please review the assessment fields.', true);
                        return;
                    }
                    var assessmentRequest = new XMLHttpRequest();
                    assessmentRequest.open('POST', withCurrentUrlSession(form.getAttribute('data-assessment-action') || form.action), true);
                    assessmentRequest.timeout = 30000;
                    assessmentRequest.withCredentials = true;
                    assessmentRequest.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded;charset=UTF-8');
                    assessmentRequest.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                    if (submit) {
                        submit.disabled = true;
                        setUploadButtonProgress(submit, 35, 'Creating...', false);
                    }
                    setUploadStatus(status, 'Creating assessment...', false);
                    assessmentRequest.addEventListener('load', function () {
                        if (assessmentRequest.status >= 200
                                && assessmentRequest.status < 300) {
                            setUploadButtonProgress(submit, 100, 'Ready', false);
                            setUploadStatus(status, 'Assessment created. Returning to class group...', false);
                            returnToAssessmentBlock(form);
                            return;
                        }
                        setUploadStatus(status, readableUploadError(assessmentRequest.responseText, assessmentRequest.getResponseHeader('content-type')), true);
                        if (submit) {
                            submit.disabled = false;
                            resetUploadButton(submit);
                        }
                    });
                    assessmentRequest.addEventListener('error', function () {
                        setUploadStatus(status, 'Assessment could not be created. Please try again.', true);
                        if (submit) {
                            submit.disabled = false;
                            resetUploadButton(submit);
                        }
                    });
                    assessmentRequest.addEventListener('abort', function () {
                        setUploadStatus(status, 'Assessment creation was cancelled.', true);
                        if (submit) {
                            submit.disabled = false;
                            resetUploadButton(submit);
                        }
                    });
                    assessmentRequest.addEventListener('timeout', function () {
                        setUploadStatus(status, 'Assessment creation took too long. Please try again.', true);
                        if (submit) {
                            submit.disabled = false;
                            resetUploadButton(submit);
                        }
                    });
                    assessmentRequest.send(assessmentRequestBody(form));
                    return;
                }
                var createsLesson = selectedSubmitOption
                        && selectedSubmitOption.getAttribute('data-source-kind') === 'lesson';
                if (createsLesson && !validateLessonForm(form)) {
                    form.reportValidity();
                    setUploadStatus(status, 'Please review the lesson fields.', true);
                    return;
                }
                var requestBody = new FormData(form);
                if (submit) {
                    submit.disabled = true;
                    setUploadButtonProgress(submit, 0, createsLesson ? 'Preparing lesson...' : 'Preparing...', true);
                }
                setUploadStatus(status, createsLesson ? 'Preparing lesson...' : 'Preparing upload...', false);

                var request = new XMLHttpRequest();
                request.open('POST', form.action, true);
                request.withCredentials = true;
                request.upload.addEventListener('loadstart', function () {
                    setUploadButtonProgress(submit, 0, createsLesson ? 'Saving...' : 'Uploading...', true);
                    setUploadStatus(status, createsLesson ? 'Saving lesson...' : 'Uploading file...', false);
                });
                request.upload.addEventListener('progress', function (progressEvent) {
                    if (createsLesson) {
                        setUploadButtonProgress(submit, 35, 'Saving...', false);
                        setUploadStatus(status, 'Saving lesson...', false);
                        return;
                    }
                    if (!progressEvent.lengthComputable) {
                        setUploadButtonProgress(submit, 0, 'Uploading...', true);
                        setUploadStatus(status, 'Uploading file...', false);
                        return;
                    }
                    var uploadPercent = Math.max(1, Math.min(100, Math.round((progressEvent.loaded / progressEvent.total) * 100)));
                    var processAwarePercent = Math.max(1, Math.min(90, Math.round(uploadPercent * 0.9)));
                    setUploadButtonProgress(submit, processAwarePercent, 'Uploading ' + uploadPercent + '%', false);
                    setUploadStatus(status, 'Uploading file... ' + uploadPercent + '%', false);
                });
                request.upload.addEventListener('load', function () {
                    setUploadButtonProgress(submit, 90, createsLesson ? 'Validating...' : 'Processing...', false);
                    setUploadStatus(status, createsLesson ? 'Validating lesson...' : 'Upload complete. Processing file...', false);
                });
                request.addEventListener('load', function () {
                    if (request.status >= 200 && request.status < 300) {
                        setUploadButtonProgress(submit, 100, 'Ready', false);
                        setUploadStatus(status, createsLesson ? 'Lesson saved. Refreshing...' : 'Content saved. Refreshing...', false);
                        window.location.reload();
                        return;
                    }
                    setUploadStatus(status, readableUploadError(request.responseText, request.getResponseHeader('content-type')), true);
                    if (submit) {
                        submit.disabled = false;
                        resetUploadButton(submit);
                    }
                });
                request.addEventListener('error', function () {
                    setUploadStatus(status, 'Content could not be saved. Please try again.', true);
                    if (submit) {
                        submit.disabled = false;
                        resetUploadButton(submit);
                    }
                });
                request.addEventListener('abort', function () {
                    setUploadStatus(status, 'Upload was cancelled.', true);
                    if (submit) {
                        submit.disabled = false;
                        resetUploadButton(submit);
                    }
                });
                request.send(requestBody);
            });
        });

        (function setupStructureReorder() {
            var root = document.querySelector('[data-class-group-structure]');
            if (!root || !root.dataset.csrfToken) {
                return;
            }
            var draggedBlock = null;
            var draggedContent = null;

            function postForm(url, formData) {
                return fetch(withCurrentClassGroupSession(url), {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin',
                    headers: {'X-Requested-With': 'XMLHttpRequest'}
                }).then(function (response) {
                    if (response.ok) {
                        return response;
                    }
                    return response.text().then(function (text) {
                        throw new Error(text || 'Order could not be saved.');
                    });
                });
            }

            function syncBlockNumbers() {
                Array.prototype.slice.call(root.querySelectorAll('[data-block-card]')).forEach(function (block, index) {
                    var number = block.querySelector('[data-block-number]');
                    if (!number) {
                        return;
                    }
                    var value = index + 1;
                    number.textContent = value < 10 ? '0' + value : String(value);
                });
            }

            function saveBlockOrder() {
                if (!root.dataset.blockReorderUrl) {
                    return;
                }
                var formData = new FormData();
                formData.append('csrfToken', root.dataset.csrfToken);
                Array.prototype.slice.call(root.querySelectorAll('[data-block-card]')).forEach(function (block) {
                    formData.append('blockId', block.dataset.blockId);
                });
                postForm(root.dataset.blockReorderUrl, formData).catch(function () {
                    window.location.reload();
                });
            }

            function saveContentOrder() {
                if (!root.dataset.contentReorderUrl) {
                    return;
                }
                var formData = new FormData();
                formData.append('csrfToken', root.dataset.csrfToken);
                Array.prototype.slice.call(root.querySelectorAll('[data-content-list]')).forEach(function (list) {
                    var targetBlockId = list.dataset.targetBlockId;
                    Array.prototype.slice.call(list.querySelectorAll('[data-content-row]')).forEach(function (row) {
                        formData.append('itemPlacement', [
                            row.dataset.itemKind || 'content',
                            row.dataset.sourceBlockId,
                            targetBlockId,
                            row.dataset.itemId || row.dataset.contentId
                        ].join(':'));
                    });
                });
                postForm(root.dataset.contentReorderUrl, formData).then(function () {
                    Array.prototype.slice.call(root.querySelectorAll('[data-content-list]')).forEach(function (list) {
                        var targetBlockId = list.dataset.targetBlockId;
                        Array.prototype.slice.call(list.querySelectorAll('[data-content-row]')).forEach(function (row) {
                            row.dataset.sourceBlockId = targetBlockId;
                        });
                    });
                    refreshEmptyStates();
                }).catch(function () {
                    window.location.reload();
                });
            }

            function refreshEmptyStates() {
                Array.prototype.slice.call(root.querySelectorAll('[data-content-list]')).forEach(function (list) {
                    var hasRows = !!list.querySelector('[data-content-row]');
                    Array.prototype.slice.call(list.querySelectorAll('.cg-empty')).forEach(function (empty) {
                        empty.hidden = hasRows;
                    });
                });
            }

            root.addEventListener('dragstart', function (event) {
                var blockHandle = event.target.closest('[data-block-drag-handle]');
                var contentHandle = event.target.closest('[data-content-drag-handle]');
                if (blockHandle) {
                    draggedBlock = blockHandle.closest('[data-block-card]');
                    if (draggedBlock) {
                        draggedBlock.classList.add('cg-dragging');
                        event.dataTransfer.effectAllowed = 'move';
                        event.dataTransfer.setData('text/plain', 'block:' + draggedBlock.dataset.blockId);
                    }
                    return;
                }
                if (contentHandle) {
                    draggedContent = contentHandle.closest('[data-content-row]');
                    if (draggedContent) {
                        draggedContent.classList.add('cg-dragging');
                        event.dataTransfer.effectAllowed = 'move';
                        event.dataTransfer.setData('text/plain', (draggedContent.dataset.itemKind || 'content') + ':' + (draggedContent.dataset.itemId || draggedContent.dataset.contentId));
                    }
                }
            });

            root.addEventListener('dragend', function () {
                if (draggedBlock) {
                    draggedBlock.classList.remove('cg-dragging');
                    draggedBlock = null;
                    syncBlockNumbers();
                }
                if (draggedContent) {
                    draggedContent.classList.remove('cg-dragging');
                    draggedContent = null;
                    refreshEmptyStates();
                }
                Array.prototype.slice.call(root.querySelectorAll('.cg-drop-target')).forEach(function (target) {
                    target.classList.remove('cg-drop-target');
                });
            });

            root.addEventListener('dragover', function (event) {
                if (draggedBlock) {
                    var overBlock = event.target.closest('[data-block-card]');
                    if (!overBlock || overBlock === draggedBlock) {
                        return;
                    }
                    event.preventDefault();
                    var rect = overBlock.getBoundingClientRect();
                    var after = event.clientY > rect.top + rect.height / 2;
                    root.insertBefore(draggedBlock, after ? overBlock.nextSibling : overBlock);
                    syncBlockNumbers();
                    return;
                }
                if (draggedContent) {
                    var list = event.target.closest('[data-content-list]');
                    if (!list) {
                        return;
                    }
                    event.preventDefault();
                    list.classList.add('cg-drop-target');
                    var rows = Array.prototype.slice.call(list.querySelectorAll('[data-content-row]:not(.cg-dragging)'));
                    var before = rows.find(function (row) {
                        var rect = row.getBoundingClientRect();
                        return event.clientY < rect.top + rect.height / 2;
                    });
                    list.insertBefore(draggedContent, before || null);
                    refreshEmptyStates();
                }
            });

            root.addEventListener('dragleave', function (event) {
                var list = event.target.closest('[data-content-list]');
                if (list && !list.contains(event.relatedTarget)) {
                    list.classList.remove('cg-drop-target');
                }
            });

            root.addEventListener('drop', function (event) {
                if (draggedBlock) {
                    event.preventDefault();
                    syncBlockNumbers();
                    saveBlockOrder();
                    return;
                }
                if (draggedContent) {
                    event.preventDefault();
                    saveContentOrder();
                }
            });
        })();

        function readableUploadError(message, contentType) {
            if (!message || !message.trim()) {
                return 'Content could not be saved.';
            }
            var normalizedType = (contentType || '').toLowerCase();
            if (normalizedType.indexOf('text/html') >= 0 || message.trim().charAt(0) === '<') {
                try {
                    var parsed = new DOMParser().parseFromString(message, 'text/html');
                    var alert = parsed.querySelector('.alert-danger');
                    if (alert && alert.textContent.trim()) {
                        return alert.textContent.trim();
                    }
                    var title = parsed.querySelector('title');
                    if (title && title.textContent.trim()) {
                        return title.textContent.trim();
                    }
                } catch (ignored) {
                }
                return 'Content could not be saved. Please try again.';
            }
            return message.trim();
        }

        initClassGroupDetail();
    });
</script>
</body>
</html>

<c:if test="${learningRoomActiveChild == 'new'}">
    <ul class="mt-8 ps-24">
        <li class="mb-6 activePage">
            <a href="${pageContext.request.contextPath}/learning/rooms/new" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-plus-circle"></i></span>
                Create
            </a>
        </li>
    </ul>
</c:if>
<c:if test="${not empty learningRoomContextCode}">
    <ul class="mt-8 ps-24">
        <li class="mb-6 ${learningRoomActiveChild == 'detail' ? 'activePage' : ''}">
            <a href="${pageContext.request.contextPath}/learning/rooms/${learningRoomContextCode}" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-eye"></i></span>
                Detail
            </a>
        </li>
        <c:if test="${canManageRoom}">
            <li class="mb-6 ${learningRoomActiveChild == 'edit' ? 'activePage' : ''}">
                <a href="${pageContext.request.contextPath}/learning/rooms/${learningRoomContextCode}/edit" class="fw-medium d-flex align-items-center text-13 gap-8 text-neutral-500 hover-bg-main-600 px-20 py-8 hover-text-white rounded-12 item-hover flex-wrap">
                    <span class="text-15 text-main-600 item-hover__text transition-03"><i class="ph ph-pencil-simple-line"></i></span>
                    Edit
                </a>
            </li>
        </c:if>
    </ul>
</c:if>

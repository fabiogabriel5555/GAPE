<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="notificationCount" value="${empty notificationUnreadCount ? 0 : notificationUnreadCount}" />
<div class="dropdown">
    <button type="button" class="position-relative w-36 h-36 border-neutral-50 border rounded-pill justify-content-center align-items-center d-flex text-20 text-neutral-500 hover-bg-main-600 hover-text-white transition-03 bg-white" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
        <i class="ph ph-bell-simple"></i>
        <c:if test="${notificationCount > 0}">
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger-600 text-white text-10 px-6 py-2">
                ${notificationCount}
            </span>
        </c:if>
    </button>
    <div class="dropdown-menu dropdown-menu-end rounded-12 border-0 shadow p-0" style="width: min(360px, calc(100vw - 32px));">
        <div class="px-20 py-14 border-bottom border-neutral-30 d-flex align-items-center justify-content-between gap-12">
            <span class="text-16 fw-semibold text-neutral-700">Notifications</span>
            <span class="text-12 fw-semibold bg-main-50 text-main-600 rounded-pill px-10 py-4">${notificationCount} unread</span>
        </div>
        <div class="py-8">
            <c:choose>
                <c:when test="${empty notificationItems}">
                    <div class="px-20 py-20 text-center">
                        <span class="w-40 h-40 rounded-circle bg-neutral-20 text-neutral-500 d-inline-flex align-items-center justify-content-center text-20 mb-10">
                            <i class="ph ph-bell-slash"></i>
                        </span>
                        <p class="text-13 text-neutral-500 mb-0">No unread notifications.</p>
                    </div>
                </c:when>
                <c:otherwise>
                    <c:forEach var="notification" items="${notificationItems}">
                        <a href="${pageContext.request.contextPath}/messages?messageId=${notification.id}" class="dropdown-item px-20 py-12 d-flex gap-12 align-items-start hover-bg-neutral-20">
                            <span class="${notification.priorityBadgeClass} w-36 h-36 rounded-circle d-inline-flex align-items-center justify-content-center text-18 flex-shrink-0">
                                <i class="${notification.typeIconClass}"></i>
                            </span>
                            <span class="min-w-0">
                                <span class="d-block text-14 fw-medium text-neutral-700 text-line-1"><c:out value="${notification.title}"/></span>
                                <span class="d-block text-12 text-neutral-500 text-line-1"><c:out value="${notification.channelTitle}"/></span>
                                <span class="d-block text-11 text-neutral-400" data-gape-datetime-display><c:out value="${notification.timestampLabel}"/></span>
                            </span>
                        </a>
                    </c:forEach>
                </c:otherwise>
            </c:choose>
        </div>
        <div class="px-20 py-12 border-top border-neutral-30">
            <a href="${pageContext.request.contextPath}/messages" class="text-13 fw-semibold text-main-600 hover-text-main-700 d-flex align-items-center justify-content-center gap-6">
                <i class="ph ph-chat-dots"></i>
                Open inbox
            </a>
        </div>
    </div>
</div>
<a href="${pageContext.request.contextPath}/messages" class="position-relative w-36 h-36 border-neutral-50 border rounded-pill justify-content-center align-items-center d-flex text-20 text-neutral-500 hover-bg-main-600 hover-text-white transition-03" title="Messages">
    <i class="ph ph-chat-dots"></i>
    <c:if test="${notificationCount > 0}">
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-main-600 text-white text-10 px-6 py-2">
            ${notificationCount}
        </span>
    </c:if>
</a>

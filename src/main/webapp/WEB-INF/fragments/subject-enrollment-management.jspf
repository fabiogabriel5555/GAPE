<div class="bg-white rounded-10 px-24 py-24 mb-24" id="subject-enrollments">
    <div class="d-flex align-items-center justify-content-between gap-16 flex-wrap mb-20">
        <div>
            <h3 class="text-18 fw-medium text-neutral-700 mb-4">Subject Enrollments</h3>
            <span class="text-14 text-neutral-500">Approve requests and keep active enrollments separate from audit history.</span>
        </div>
        <div class="d-flex align-items-center gap-10 flex-wrap">
            <span class="bg-warning-30 text-warning-600 px-14 py-8 rounded-pill text-13 fw-semibold">
                ${fn:length(pendingSubjectEnrollments)} pending
            </span>
            <span class="bg-success-50 text-success-600 px-14 py-8 rounded-pill text-13 fw-semibold">
                ${fn:length(activeSubjectEnrollments)} active
            </span>
        </div>
    </div>

    <div class="border border-warning-600 rounded-12 overflow-hidden mb-16">
        <div class="bg-warning-30 px-20 py-14 border-bottom border-neutral-30">
            <h4 class="text-16 fw-semibold text-neutral-800 mb-0">Pending approval</h4>
        </div>
        <div class="overflow-x-auto">
            <table class="table mb-0">
                <thead>
                <tr>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Student</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Course</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Period</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="enrollment" items="${pendingSubjectEnrollments}">
                    <%@ include file="/WEB-INF/fragments/subject-enrollment-row.jspf" %>
                </c:forEach>
                <c:if test="${empty pendingSubjectEnrollments}">
                    <tr>
                        <td colspan="5" class="py-28 px-20 text-center text-14 text-neutral-500">No pending subject enrollment requests.</td>
                    </tr>
                </c:if>
                </tbody>
            </table>
        </div>
    </div>

    <div class="border border-neutral-30 rounded-12 overflow-hidden mb-16">
        <div class="bg-main-25 px-20 py-14 border-bottom border-neutral-30">
            <h4 class="text-16 fw-semibold text-neutral-800 mb-0">Active enrollments</h4>
        </div>
        <div class="overflow-x-auto">
            <table class="table mb-0">
                <thead>
                <tr>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Student</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Course</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Period</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                    <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                <c:forEach var="enrollment" items="${activeSubjectEnrollments}">
                    <%@ include file="/WEB-INF/fragments/subject-enrollment-row.jspf" %>
                </c:forEach>
                <c:if test="${empty activeSubjectEnrollments}">
                    <tr>
                        <td colspan="5" class="py-28 px-20 text-center text-14 text-neutral-500">No active students enrolled in this subject.</td>
                    </tr>
                </c:if>
                </tbody>
            </table>
        </div>
    </div>

    <button type="button" class="border-main-600 border px-16 py-9 rounded-10 text-14 fw-semibold text-main-600 hover-bg-main-50 transition-03 mb-14" data-bs-toggle="collapse" data-bs-target="#subjectEnrollmentHistory" aria-expanded="false" aria-controls="subjectEnrollmentHistory">
        Show audit enrollments
    </button>
    <div class="collapse" id="subjectEnrollmentHistory">
        <div class="border border-neutral-30 rounded-12 overflow-hidden">
            <div class="bg-neutral-20 px-20 py-14 border-bottom border-neutral-30">
                <h4 class="text-16 fw-semibold text-neutral-700 mb-0">Audit history</h4>
            </div>
            <div class="overflow-x-auto">
                <table class="table mb-0">
                    <thead>
                    <tr>
                        <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Student</th>
                        <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Course</th>
                        <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Period</th>
                        <th class="py-16 px-20 text-14 fw-medium text-neutral-600">State</th>
                        <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <c:forEach var="enrollment" items="${auditSubjectEnrollments}">
                        <%@ include file="/WEB-INF/fragments/subject-enrollment-row.jspf" %>
                    </c:forEach>
                    <c:if test="${empty auditSubjectEnrollments}">
                        <tr>
                            <td colspan="5" class="py-28 px-20 text-center text-14 text-neutral-500">No audit enrollment records found.</td>
                        </tr>
                    </c:if>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-column gap-24">
    <c:forEach var="courseGroup" items="${attendanceCourseGroups}">
        <section class="gape-student-class-course-group">
            <div class="gape-student-class-course-group__header d-flex align-items-center justify-content-between gap-16 flex-wrap">
                <div class="d-flex align-items-center gap-12 min-w-0">
                    <span class="gape-student-icon gape-student-soft-blue text-22"><i class="ph ph-books"></i></span>
                    <div class="min-w-0">
                        <h4 class="text-18 fw-semibold text-neutral-800 mb-4 text-line-1"><c:out value="${courseGroup.name}"/></h4>
                        <span class="text-13 text-neutral-500">${courseGroup.recordCount} attendance records</span>
                    </div>
                </div>
            </div>
            <c:forEach var="subjectGroup" items="${courseGroup.subjectGroups}">
                <section class="gape-student-class-subject-group">
                    <div class="d-flex align-items-center gap-12 mb-14">
                        <span class="gape-student-icon gape-student-soft-violet text-22"><i class="ph ph-book-open-text"></i></span>
                        <div class="min-w-0">
                            <h5 class="text-16 fw-semibold text-neutral-800 mb-4 text-line-1"><c:out value="${subjectGroup.name}"/></h5>
                            <span class="text-13 text-neutral-500">${subjectGroup.recordCount} attendance records</span>
                        </div>
                    </div>
                    <c:forEach var="occurrenceGroup" items="${subjectGroup.occurrenceGroups}">
                        <div class="gape-student-class-occurrence-group border border-neutral-30 rounded-10 px-16 py-14 mb-16">
                            <div class="d-flex align-items-center justify-content-between gap-12 flex-wrap mb-12">
                                <div class="d-flex align-items-center gap-10 min-w-0">
                                    <span class="gape-student-icon gape-student-soft-blue text-18"><i class="ph ph-calendar-blank"></i></span>
                                    <div class="min-w-0">
                                        <span class="text-14 fw-semibold text-neutral-800 d-block text-line-1"><c:out value="${occurrenceGroup.label}"/></span>
                                        <span class="text-12 text-neutral-500"><c:out value="${occurrenceGroup.dateRangeLabel}"/> &middot; ${occurrenceGroup.recordCount} attendance records</span>
                                    </div>
                                </div>
                            </div>
                            <c:forEach var="classGroup" items="${occurrenceGroup.classGroups}">
                                <div class="gape-student-assessment-class-group border border-neutral-30 rounded-10 px-14 py-12 mb-12">
                                    <div class="d-flex align-items-center gap-10 mb-10">
                                        <span class="gape-student-icon gape-student-soft-blue text-18"><i class="ph ph-users-three"></i></span>
                                        <div class="min-w-0">
                                            <span class="text-13 fw-semibold text-neutral-800 d-block text-line-1"><c:out value="${classGroup.code}"/></span>
                                            <span class="text-12 text-neutral-500">${classGroup.recordCount} attendance records</span>
                                        </div>
                                    </div>
                                    <div class="row gy-4">
                                        <c:forEach var="record" items="${classGroup.records}">
                                            <c:set var="attendanceModalId" value="studentAttendanceModernDetail${record.id}_${classGroup.id}"/>
                                            <c:set var="justificationModalId" value="studentAttendanceJustification${record.id}_${classGroup.id}"/>
                                            <div class="col-xxl-3 col-xl-4 col-md-6">
                                                <article class="gape-student-card gape-student-class-group-card px-14 py-14 h-100 position-relative" data-justification-pending="${record.justificationPending}">
                                                    <div class="gape-student-class-group-card__top mb-10">
                                                        <span class="gape-student-class-group-card__icon gape-student-class-group-card__icon--compact bg-success-50 text-success-600"><i class="ph ph-user-check"></i></span>
                                                        <div class="min-w-0">
                                                            <h6 class="text-14 fw-semibold text-neutral-800 mb-4 text-line-1"><c:out value="${record.lessonTitle}"/></h6>
                                                            <span class="text-12 text-neutral-500">Attendance</span>
                                                        </div>
                                                    </div>
                                                    <div class="gape-student-class-group-card__badges mb-12">
                                                        <span class="${record.statusBadgeClass} px-12 py-7 border-neutral-30 border rounded-pill text-12"><c:out value="${record.statusLabel}"/></span>
                                                        <span class="${record.stateBadgeClass} px-12 py-7 border-neutral-30 border rounded-pill text-12"><c:out value="${record.stateLabel}"/></span>
                                                    </div>
                                                    <div class="gape-student-class-group-card__meta mb-12">
                                                        <span class="gape-student-enrollment-period" data-gape-datetime-display>Date: <c:out value="${record.activityScheduleLabel}"/></span>
                                                        <span><c:out value="${record.permanenceLabel}"/> &middot; <c:out value="${record.sourceLabel}"/></span>
                                                    </div>
                                                    <div class="gape-student-card-actions">
                                                        <button type="button" class="gape-student-card-icon-button" aria-label="View attendance" title="View attendance" data-bs-toggle="modal" data-bs-target="#${attendanceModalId}"><i class="ph ph-eye"></i></button>
                                                        <c:choose>
                                                            <c:when test="${record.justificationPending}">
                                                                <span class="gape-student-card-icon-button gape-student-card-icon-button--muted" aria-label="Attendance justification pending" title="Attendance justification pending"><i class="ph ph-clock"></i></span>
                                                            </c:when>
                                                            <c:when test="${record.canSubmitJustification}">
                                                                <button type="button" class="gape-student-card-icon-button gape-student-card-icon-button--meeting" aria-label="Request attendance justification" title="Request attendance justification" data-bs-toggle="modal" data-bs-target="#${justificationModalId}"><i class="ph ph-note-pencil"></i></button>
                                                            </c:when>
                                                        </c:choose>
                                                    </div>
                                                </article>
                                            </div>
                                            <div class="modal fade gape-student-attendance-modal" id="${attendanceModalId}" tabindex="-1" aria-labelledby="${attendanceModalId}Title" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                                    <div class="modal-content rounded-10 border-0">
                                                        <div class="modal-header">
                                                            <div>
                                                                <h5 class="modal-title text-18 fw-semibold" id="${attendanceModalId}Title"><c:out value="${record.lessonTitle}"/></h5>
                                                                <span class="text-13 text-neutral-500"><c:out value="${classGroup.code}"/> &middot; <c:out value="${subjectGroup.name}"/></span>
                                                            </div>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="gape-student-class-group-card__meta gape-student-class-group-card__meta--wide mb-16">
                                                                <span>Status: <c:out value="${record.statusLabel}"/></span>
                                                                <span>State: <c:out value="${record.stateLabel}"/></span>
                                                                <span>Source: <c:out value="${record.sourceLabel}"/></span>
                                                                <span data-gape-datetime-display>In: <c:out value="${record.checkIn}"/></span>
                                                                <span data-gape-datetime-display>Out: <c:out value="${record.checkOut}"/></span>
                                                                <span>Duration: <c:out value="${record.permanenceLabel}"/></span>
                                                            </div>
                                                            <p class="text-14 text-neutral-600 mb-16">Notes: <c:out value="${record.notes}"/></p>
                                                            <c:if test="${record.hasJustification}">
                                                                <div class="gape-student-class-group-card__meta gape-student-class-group-card__meta--wide">
                                                                    <span>Justification state: <c:out value="${record.justification.stateLabel}"/></span>
                                                                    <span>Submitted: <c:out value="${record.justification.submittedAt}"/></span>
                                                                    <span>Processed: <c:out value="${record.justification.processedAt}"/></span>
                                                                    <span>Attachment: <c:out value="${record.justification.attachmentLabel}"/></span>
                                                                    <span class="d-block">Reason: <c:out value="${record.justification.reason}"/></span>
                                                                    <span class="d-block">Decision notes: <c:out value="${record.justification.decisionNotes}"/></span>
                                                                </div>
                                                            </c:if>
                                                        </div>
                                                        <div class="modal-footer"><button type="button" class="bg-main-600 px-20 py-10 rounded-8 fw-semibold text-white" data-bs-dismiss="modal">Close</button></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <c:if test="${record.canSubmitJustification}">
                                                <div class="modal fade gape-student-attendance-modal" id="${justificationModalId}" tabindex="-1" aria-labelledby="${justificationModalId}Title" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                                        <div class="modal-content rounded-10 border-0">
                                                            <div class="modal-header">
                                                                <div>
                                                                    <h5 class="modal-title text-18 fw-semibold" id="${justificationModalId}Title">Attendance justification</h5>
                                                                    <span class="text-13 text-neutral-500"><c:out value="${record.lessonTitle}"/> &middot; <c:out value="${classGroup.code}"/></span>
                                                                </div>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <form action="${pageContext.request.contextPath}/student/attendance/justifications" method="post" enctype="multipart/form-data">
                                                                <input type="hidden" name="csrfToken" value="${sessionScope['gape.auth.csrfToken']}">
                                                                <input type="hidden" name="attendanceRecordId" value="${record.id}">
                                                                <input type="hidden" name="returnTo" value="/student/lessons#attendance">
                                                                <div class="modal-body">
                                                                    <div class="gape-student-class-group-card__meta gape-student-class-group-card__meta--wide mb-16"><span>Status: <c:out value="${record.statusLabel}"/></span><span data-gape-datetime-display>Date: <c:out value="${record.activityScheduleLabel}"/></span><span>Duration: <c:out value="${record.permanenceLabel}"/></span></div>
                                                                    <p class="text-14 text-neutral-600 mb-16">Explain why this attendance record should be justified. The request will be sent for review.</p>
                                                                    <label class="text-13 text-neutral-600 mb-6 d-block" for="attendanceJustificationReason${record.id}_${classGroup.id}">Justification reason</label>
                                                                    <textarea id="attendanceJustificationReason${record.id}_${classGroup.id}" name="reason" maxlength="300" rows="5" required class="form-control px-12 py-10 text-13 bg-neutral-20 border-neutral-30 border rounded-8" placeholder="Describe the reason for your absence or late arrival"></textarea>
                                                                    <label class="text-13 text-neutral-600 mb-6 mt-16 d-block" for="attendanceJustificationAttachment${record.id}_${classGroup.id}">Supporting attachment (optional)</label>
                                                                    <input id="attendanceJustificationAttachment${record.id}_${classGroup.id}" type="file" name="attachmentFile" class="form-control px-12 py-10 text-13 bg-neutral-20 border-neutral-30 border rounded-8" accept=".pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.txt">
                                                                    <span class="text-12 text-neutral-500 d-block mt-6">Accepted: PDF, PNG, JPG, JPEG, WEBP, DOC, DOCX or TXT. Maximum size: 10 MB.</span>
                                                                </div>
                                                                <div class="modal-footer"><button type="button" class="bg-neutral-20 border border-neutral-30 px-20 py-10 rounded-8 fw-semibold text-neutral-700" data-bs-dismiss="modal">Cancel</button><button type="submit" class="bg-main-600 px-20 py-10 rounded-8 fw-semibold text-white"><i class="ph ph-paper-plane-tilt me-8"></i>Request justification</button></div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </c:if>
                                        </c:forEach>
                                    </div>
                                </div>
                            </c:forEach>
                        </div>
                    </c:forEach>
                </section>
            </c:forEach>
        </section>
    </c:forEach>
</div>

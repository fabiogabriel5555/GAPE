<div id="reviews" class="bg-white rounded-10 px-24 py-24 mt-24">
    <div class="d-flex align-items-center justify-content-between gap-16 flex-wrap mb-20">
        <div>
            <h2 class="text-18 fw-medium text-neutral-700 mb-4">Reviews</h2>
            <span class="text-14 text-neutral-500">Feedback summary for courses and learning activities.</span>
        </div>
        <span class="bg-warning-50 text-warning-600 px-14 py-8 rounded-pill text-13 fw-semibold">
            <i class="ph ph-star me-6"></i>Feedback
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="table mb-0">
            <thead>
            <tr>
                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Course</th>
                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Rating</th>
                <th class="py-16 px-20 text-14 fw-medium text-neutral-600">Feedback</th>
                <th class="py-16 px-20 text-14 fw-medium text-neutral-600 text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            <tr class="hover-bg-neutral-20 border-bottom transition-03">
                <td class="py-20 px-20 text-14 text-neutral-700">Automation System</td>
                <td class="py-20 px-20 text-warning-600 text-20">
                    <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                </td>
                <td class="py-20 px-20 text-14 text-neutral-500">(3 Reviews)</td>
                <td class="py-20 px-20 text-end">
                    <button type="button" class="text-22 text-neutral-500 bg-transparent border-0 p-0" title="Edit review summary" aria-label="Edit review summary"><i class="ph-bold ph-pencil-simple-line"></i></button>
                </td>
            </tr>
            <tr class="hover-bg-neutral-20 border-bottom transition-03">
                <td class="py-20 px-20 text-14 text-neutral-700">Laboratory Expansion</td>
                <td class="py-20 px-20 text-warning-600 text-20">
                    <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                </td>
                <td class="py-20 px-20 text-14 text-neutral-500">(3 Reviews)</td>
                <td class="py-20 px-20 text-end">
                    <button type="button" class="text-22 text-neutral-500 bg-transparent border-0 p-0" title="Edit review summary" aria-label="Edit review summary"><i class="ph-bold ph-pencil-simple-line"></i></button>
                </td>
            </tr>
            <tr class="hover-bg-neutral-20 border-bottom transition-03">
                <td class="py-20 px-20 text-14 text-neutral-700">Quality Control</td>
                <td class="py-20 px-20 text-warning-600 text-20">
                    <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star-half"></i>
                </td>
                <td class="py-20 px-20 text-14 text-neutral-500">(3 Reviews)</td>
                <td class="py-20 px-20 text-end">
                    <button type="button" class="text-22 text-neutral-500 bg-transparent border-0 p-0" title="Edit review summary" aria-label="Edit review summary"><i class="ph-bold ph-pencil-simple-line"></i></button>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
